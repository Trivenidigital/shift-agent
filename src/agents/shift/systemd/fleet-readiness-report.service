[Unit]
Description=Daily per-agent fleet readiness report (one-shot, report-only)
After=network-online.target
Wants=network-online.target
OnFailure=fleet-readiness-report-failure.service

[Service]
Type=oneshot
User=shift-agent
Group=shift-agent
EnvironmentFile=/opt/shift-agent/.env
Environment=HOME=/opt/shift-agent
Environment=TZ=UTC

# ExecStartPre instead of ConditionPathIsExecutable: condition-failure produces
# systemd result "condition" which does NOT trigger OnFailure=. test-x failure
# produces result "exit-code" which DOES — so the failure handler fires on
# missing-binary cases.
ExecStartPre=/usr/bin/test -x /usr/local/bin/fleet-readiness-report
ExecStart=/usr/local/bin/fleet-readiness-report
# stdout (the JSON report) goes to the journal: journalctl -u fleet-readiness-report.
# Reads /var/log/shift-agent-archive (0750 shift-agent) read-only under
# ProtectSystem=strict; writes only under /opt/shift-agent.

# Security hardening (mirrors send-routing-accuracy-summary.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/shift-agent
ProtectHome=read-only
PrivateTmp=true
RuntimeDirectory=shift-agent

[Install]
WantedBy=multi-user.target
