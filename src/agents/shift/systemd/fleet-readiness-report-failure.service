[Unit]
Description=Failure handler — alert owner if the daily fleet readiness report failed

[Service]
Type=oneshot
User=shift-agent
Group=shift-agent
EnvironmentFile=/opt/shift-agent/.env
Environment=HOME=/opt/shift-agent
TimeoutStartSec=30s
ExecStart=/usr/local/bin/shift-agent-notify-owner \
    --title "Fleet readiness report FAILED" \
    --priority 1 \
    "fleet-readiness-report.service exited non-zero. Check journalctl -u fleet-readiness-report"

# Security hardening — must match main service unit.
# No OnFailure= here: if notify-owner is itself broken, journald is the floor;
# avoid recursive cascade.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/shift-agent
ProtectHome=read-only
PrivateTmp=true
RuntimeDirectory=shift-agent
