#!/usr/bin/env python3
"""List and disposition Flyer Studio manual-review queue items."""
from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path
import sys

SRC_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, "/opt/shift-agent")
sys.path.insert(0, str(SRC_ROOT / "platform"))
sys.path.insert(0, str(SRC_ROOT))

from schemas import FlyerProjectStore  # noqa: E402
from safe_io import FileLock, atomic_write_text  # noqa: E402
try:
    from flyer_manual_queue import (  # type: ignore  # noqa: E402
        close_manual_project,
        complete_manual_project,
        enforce_close_freshness_guard,
        list_manual_queue,
        notify_customer_of_closure,
        retry_reference_extraction,
        triage_summary,
    )
except ImportError:
    from agents.flyer.manual_queue import (  # noqa: E402
        close_manual_project,
        complete_manual_project,
        enforce_close_freshness_guard,
        list_manual_queue,
        notify_customer_of_closure,
        retry_reference_extraction,
        triage_summary,
    )


STATE_PATH = Path("/opt/shift-agent/state/flyer/projects.json")
CUSTOMERS_PATH = Path("/opt/shift-agent/state/flyer/customers.json")
DECISIONS_LOG_PATH = Path("/opt/shift-agent/logs/decisions.log")
GENERATE_CONCEPTS_BIN = "/usr/local/bin/generate-flyer-concepts"


def _load(path: Path) -> FlyerProjectStore:
    if not path.exists():
        return FlyerProjectStore()
    return FlyerProjectStore.model_validate(json.loads(path.read_text(encoding="utf-8")))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--state-path", default=str(STATE_PATH))
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--triage", action="store_true", help="grouped + reason-tallied operator view")
    parser.add_argument("--complete", metavar="PROJECT_ID")
    parser.add_argument("--close", metavar="PROJECT_ID", help="operator-close without sending assets")
    parser.add_argument("--retry-extraction", metavar="PROJECT_ID",
                        help="reset failed reference extractions to not_run and re-arm generation "
                             "(sends nothing; prints the generate command to run next)")
    parser.add_argument("--decisions-log-path", default=str(DECISIONS_LOG_PATH))
    parser.add_argument("--asset")
    parser.add_argument("--reason", default="")
    parser.add_argument("--no-notify", action="store_true",
                        help="close WITHOUT the proactive customer notice (operator-ruled "
                             "silent close; the reactive any-update path still answers with "
                             "the closed-status line). An audit row is still written, "
                             "marked silent.")
    parser.add_argument("--force", action="store_true",
                        help="bypass the --close freshness guard (still requires --reason); "
                             "with --retry-extraction, allow a project not in manual_edit_required")
    args = parser.parse_args()

    state_path = Path(args.state_path)
    if args.triage:
        print(json.dumps(triage_summary(_load(state_path)), default=str))
        return 0
    if args.list:
        print(json.dumps({"queue": list_manual_queue(_load(state_path))}, default=str))
        return 0
    if args.complete:
        if not args.asset:
            raise SystemExit("--complete requires --asset")
        if not args.reason.strip():
            raise SystemExit("--complete requires --reason")
        with FileLock(Path(str(state_path) + ".lock")):
            store = complete_manual_project(_load(state_path), args.complete, Path(args.asset), reason=args.reason)
            atomic_write_text(state_path, store.model_dump_json(indent=2))
        print(json.dumps({"project_id": args.complete, "status": "awaiting_final_approval"}))
        return 0
    if args.close:
        if not args.reason.strip():
            raise SystemExit("--close requires --reason")
        with FileLock(Path(str(state_path) + ".lock")):
            store = _load(state_path)
            try:
                enforce_close_freshness_guard(
                    store, args.close,
                    reason=args.reason,
                    force=args.force,
                    now=datetime.now(timezone.utc),
                )
            except ValueError as exc:
                raise SystemExit(str(exc))
            store = close_manual_project(store, args.close, reason=args.reason)
            atomic_write_text(state_path, store.model_dump_json(indent=2))
        # Closure state is now committed. Proactive customer notification is
        # best-effort: never raises into the script, always audits. The
        # reactive "any update?" path (PR #129) is the safety net for missed
        # sends.
        if args.no_notify:
            # Silent close (C2 census E-verdict 2026-07-06): audit trail kept,
            # customer notice deliberately skipped by operator ruling.
            try:
                from safe_io import ndjson_append  # type: ignore
                ndjson_append(DECISIONS_LOG_PATH, json.dumps({
                    "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
                    "type": "flyer_closure_customer_notified",
                    "project_id": args.close,
                    "skipped": True,
                    "error": "silent_close_operator_ruling",
                }))
            except Exception as exc:  # noqa: BLE001 - closure already committed
                print(f"silent-close audit append failed (non-fatal): {exc}", file=sys.stderr)
        else:
            notify_customer_of_closure(
                store, args.close,
                customers_path=CUSTOMERS_PATH,
                decisions_log_path=DECISIONS_LOG_PATH,
            )
        print(json.dumps({"project_id": args.close, "status": "closed_no_send",
                          "notified": (not args.no_notify)}))
        return 0
    if args.retry_extraction:
        with FileLock(Path(str(state_path) + ".lock")):
            try:
                store, result = retry_reference_extraction(
                    _load(state_path), args.retry_extraction, force=args.force,
                )
            except ValueError as exc:
                print(json.dumps({"project_id": args.retry_extraction, "error": str(exc)}), file=sys.stderr)
                return 2
            atomic_write_text(state_path, store.model_dump_json(indent=2))
        try:
            from safe_io import ndjson_append  # type: ignore
            ndjson_append(Path(args.decisions_log_path), json.dumps({
                "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
                "type": "flyer_status_change",
                "project_id": result["project_id"],
                "from_status": result["from_status"],
                "to_status": result["new_status"],
                "actor": "operator",
                "reason": (
                    f"retry_extraction: reset {result['rows_reset']} reference extraction(s) to not_run; "
                    f"cleared manual_review {result['previous_manual_reason_code']}"
                    + ("; forced" if args.force else "")
                    + (f"; {args.reason.strip()}" if args.reason.strip() else "")
                )[:500],
            }))
        except Exception as exc:  # noqa: BLE001 - state reset already committed
            print(f"retry-extraction audit append failed (non-fatal): {exc}", file=sys.stderr)
        print(json.dumps({
            "project_id": result["project_id"],
            "rows_reset": result["rows_reset"],
            "new_status": result["new_status"],
            "next_command": f"{GENERATE_CONCEPTS_BIN} --project-id {result['project_id']}",
        }))
        return 0
    raise SystemExit("pass --list, --triage, --complete, --close, or --retry-extraction")


if __name__ == "__main__":
    raise SystemExit(main())
