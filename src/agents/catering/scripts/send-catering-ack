#!/usr/bin/env python3
"""send-catering-ack — F5b 2026-05-01 customer-acknowledgment send.

Called by the parse_catering_inquiry SKILL (Step 3) AFTER create-catering-lead
has succeeded and the lead is on the owner's plate. The SKILL passes the
caller-facing message body; this script prepends the WhatsApp bridge's
required `template_bypass` prefix and POSTs to the bridge.

Why server-side prepend (mirrors PR #43 / apply-catering-owner-decision F1):
the bridge filter (defense-in-depth against LLM internal monologue) drops
outbound messages matching announcement patterns ("Thanks for", "I'll",
"I understand", etc.) unless they begin with the `template_bypass` prefix
(see bridge.js:133). The SKILL used to embed the prefix in its LLM-drafted
reply, but the LLM forgot the prefix on the May 1 02:36 UTC customer
inquiry from LID 269612545511591 → 143-char ack dropped silently → second
production silent-drop incident (first was 01:04 UTC, fixed by PR #43 on
the OTHER outbound path). Server-side prepend means the prefix is never
the LLM's responsibility — same fix shape as PR #43.

Usage:
  send-catering-ack \\
    --customer-jid "<jid>" \\
    --message-text "<body — no prefix>" \\
    [--lead-id "<L0014>"]

`--customer-jid` accepts either form the bridge uses:
  - "<digits>@s.whatsapp.net" (phone-resolved sender)
  - "<digits>@lid"            (LID-only sender, common for first contact)

Outputs JSON to stdout: {"outbound_message_id": "...", "ok": true}.

Exit codes:
  0  — success (message accepted by bridge with messageId)
  2  — invalid input (missing/malformed flags)
  6  — bridge unreachable / empty response
  14 — lead is ON HOLD (M4/G4); the ack was withheld, do NOT retry
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, "/opt/shift-agent")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent.parent / "platform"))

from safe_io import load_model, ndjson_append  # noqa: E402
from safe_io import bridge_post as _bridge_post_4tuple  # noqa: E402  # P17b: status is consumed
from schemas import (  # noqa: E402
    CateringCustomerAckSent, CateringCustomerAckFailed,
    CateringCustomerSendUnconfirmed,
    CateringLeadHoldBlockedSend, CateringLeadStore,
)
from exit_codes import (  # noqa: E402
    EXIT_OK, EXIT_INVALID_INPUT, EXIT_DEPENDENCY_DOWN, EXIT_LEAD_ON_HOLD,
)

# Env overrides mirror the sibling catering scripts (apply-catering-owner-decision,
# catering-quote-status) so tests and subprocess callers can isolate both paths.
LOG_PATH = Path(os.environ.get("SHIFT_AGENT_LOG_PATH", "/opt/shift-agent/logs/decisions.log"))
LEADS_PATH = Path(os.environ.get("SHIFT_AGENT_LEADS_PATH", "/opt/shift-agent/state/catering-leads.json"))

# F5b: server-side bridge `template_bypass` prefix. Mirrors apply-script F1
# (PR #43). See bridge.js:133 for the exact regex:
#   /^⚕ \*[A-Za-z][A-Za-z ]*\*\n[─\-]+\n/
# Agent name MUST be `[A-Za-z ]+` (letters and spaces only).
BRIDGE_PREFIX = "⚕ *Catering Agent*\n────────────\n"

# Hard cap on the LLM-drafted body. WhatsApp Cloud API caps text.body at
# ~4096 chars; subtract prefix (24 chars) and leave headroom.
MAX_ACK_BODY_CHARS = 3500

# Valid JID suffixes — anything else is rejected as malformed input.
_VALID_JID_SUFFIXES = ("@s.whatsapp.net", "@lid")


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def _emit_ack_failed(jid: str, reason: str, detail: str, *,
                     logical_turn_id: str, send_attempt_id: str) -> None:
    try:
        entry = CateringCustomerAckFailed(
            ts=_now_iso(),
            type="catering_customer_ack_failed",
            customer_jid=jid,
            reason=reason,
            detail=detail[:2000],
            logical_turn_id=logical_turn_id,
            send_attempt_id=send_attempt_id,
            outcome=reason,
        )
        ndjson_append(LOG_PATH, entry.model_dump_json())
    except Exception as e:
        sys.stderr.write(f"audit emit failed (non-fatal): {e}\n")


_CERTAINTY_BY_STATUS = {"send_uncertain": "uncertain"}


def _delivery_certainty(send_status: str) -> str:
    """'uncertain' only for safe_io's `send_uncertain` (bridge accepted, ack body
    unparseable → most likely delivered). Everything else means the customer
    received nothing."""
    return _CERTAINTY_BY_STATUS.get(send_status, "failed")


def _emit_send_unconfirmed(jid: str, lead_id: str, send_status: str, detail: str, *,
                           logical_turn_id: str, send_attempt_id: str) -> None:
    """The shared P17 row, emitted ALONGSIDE `catering_customer_ack_failed`.

    `CateringCustomerAckFailed.reason` is deliberately NOT given a new value:
    that Literal is already recognised by the pinned rollback target, and
    widening it would make the old reader REJECT a row it knows by tag. The new
    tag routes to `_UnknownLogEntry` there instead, which is the whole reason
    this variant exists.

    Requires a lead_id (the variant's field is min_length=1). A lead-less ack
    still gets its `catering_customer_ack_failed` row, unchanged."""
    if not lead_id:
        return
    try:
        entry = CateringCustomerSendUnconfirmed(
            ts=_now_iso(),
            type="catering_customer_send_unconfirmed",
            lead_id=lead_id,
            script="send-catering-ack",
            send_kind="customer_ack",
            send_status=send_status,
            delivery_certainty=_delivery_certainty(send_status),
            detail=detail[:2000],
            owner_paged=False,
            logical_turn_id=logical_turn_id,
            send_attempt_id=send_attempt_id,
            transport_destination=jid,
            outcome=send_status,
        )
        ndjson_append(LOG_PATH, entry.model_dump_json())
    except Exception as e:  # noqa: BLE001 — audit is best-effort
        sys.stderr.write(f"audit emit (send_unconfirmed) failed (non-fatal): {e}\n")


def _emit_ack_sent(jid: str, mid: str, lead_id: str, *,
                   logical_turn_id: str, send_attempt_id: str) -> None:
    try:
        entry = CateringCustomerAckSent(
            ts=_now_iso(),
            type="catering_customer_ack_sent",
            customer_jid=jid,
            outbound_message_id=mid,
            lead_id=lead_id,
            logical_turn_id=logical_turn_id,
            send_attempt_id=send_attempt_id,
            outcome="sent",
        )
        ndjson_append(LOG_PATH, entry.model_dump_json())
    except Exception as e:
        sys.stderr.write(f"audit emit failed (non-fatal): {e}\n")


def _lead_hold(lead_id: str) -> "tuple[bool, str]":
    """Return ``(on_hold, hold_reason)`` for ``lead_id`` (M4/G4).

    FAILS OPEN — an unknown lead id, an unreadable store, or any error reads as
    NOT held. A hold withholds a courtesy acknowledgment; losing one to a
    transient read fault leaves the customer in silence right after they wrote
    in, which is the worse outcome. The owner-approved QUOTE send in
    apply-catering-owner-decision reads the hold off the lead it already holds
    under LEADS_LOCK, so that money-adjacent path has no such window."""
    if not lead_id:
        return False, ""
    try:
        store, status = load_model(LEADS_PATH, CateringLeadStore, default=CateringLeadStore())
        if status not in ("ok", "missing", "empty"):
            return False, ""
        lead = next((l for l in store.leads if l.lead_id == lead_id), None)
        if lead is None:
            return False, ""
        return bool(lead.on_hold), (lead.hold_reason or "")
    except Exception as e:  # noqa: BLE001 — never block the ack on a store fault
        sys.stderr.write(f"hold check failed (fail-open, non-fatal): {e}\n")
        return False, ""


def _emit_hold_blocked(lead_id: str, hold_reason: str) -> None:
    try:
        entry = CateringLeadHoldBlockedSend(
            ts=_now_iso(),
            type="catering_lead_hold_blocked_send",
            lead_id=lead_id,
            blocked_send_kind="customer_ack",
            hold_reason=hold_reason[:200],
        )
        ndjson_append(LOG_PATH, entry.model_dump_json())
    except Exception as e:
        sys.stderr.write(f"audit emit failed (non-fatal): {e}\n")


def main() -> int:
    p = argparse.ArgumentParser(description="Send catering customer ack with bridge prefix prepended.")
    p.add_argument("--customer-jid", required=True, help="JID, e.g. 17329837841@s.whatsapp.net or 269612545511591@lid")
    p.add_argument("--message-text", required=True, help="Ack body without the prefix; ≤3500 chars")
    p.add_argument("--lead-id", default="", help="Optional lead linkage")
    # PR-4: logical_turn_id = the inbound native message id that caused this send
    # (one per inbound; shared by every send of the turn). This path has no
    # inbound-id arg of its own, so it defaults to "" when the caller omits it —
    # cf-router passes it on the followup path.
    p.add_argument("--logical-turn-id", default="", help="Inbound native message id (charter §4.2)")
    args = p.parse_args()

    jid = args.customer_jid.strip()
    body = args.message_text.strip()
    logical_turn_id = args.logical_turn_id.strip()
    # One send_attempt_id per invocation (per logical send attempt); an internal
    # retry would reuse it. cf-router re-invoking = a new process = a new id.
    send_attempt_id = uuid.uuid4().hex

    # Resolve the matched suffix and its local part. Fail closed unless the JID
    # ends with a valid suffix AND carries a non-empty local part — e.g.
    # "@s.whatsapp.net" / "@lid" with no digits before the suffix is malformed
    # (undeliverable) and must NOT be sent.
    jid_local = ""
    jid_suffix_ok = False
    for _suffix in _VALID_JID_SUFFIXES:
        if jid.endswith(_suffix):
            jid_suffix_ok = True
            jid_local = jid[: -len(_suffix)]
            break

    _ids = {"logical_turn_id": logical_turn_id, "send_attempt_id": send_attempt_id}

    if not jid or not jid_suffix_ok or not jid_local:
        _emit_ack_failed(jid or "<empty>", "bad_input",
                         f"jid must be <local>@suffix with a non-empty local part; "
                         f"suffix one of {_VALID_JID_SUFFIXES}", **_ids)
        sys.stderr.write(f"invalid --customer-jid: {jid!r}\n")
        return EXIT_INVALID_INPUT

    if not body:
        _emit_ack_failed(jid, "bad_input", "empty message-text", **_ids)
        sys.stderr.write("--message-text is empty after strip\n")
        return EXIT_INVALID_INPUT

    if len(body) > MAX_ACK_BODY_CHARS:
        _emit_ack_failed(jid, "bad_input",
                         f"message-text {len(body)} chars exceeds {MAX_ACK_BODY_CHARS}", **_ids)
        sys.stderr.write(f"--message-text {len(body)} chars > {MAX_ACK_BODY_CHARS}\n")
        return EXIT_INVALID_INPUT

    # M4/G4 per-lead hold — checked at the SEND CALL (the F7 extraction region is
    # owned by another workstream this wave). Only lead-scoped: an ack invoked
    # without --lead-id has no lead to hold and is never blocked here.
    on_hold, hold_reason = _lead_hold(args.lead_id.strip())
    if on_hold:
        _emit_hold_blocked(args.lead_id.strip(), hold_reason)
        sys.stderr.write(
            f"lead {args.lead_id.strip()} is ON HOLD; withholding customer ack "
            f"(reason: {hold_reason or 'unspecified'}). "
            f"Clear with: set-catering-lead-hold --lead-id {args.lead_id.strip()} --off\n"
        )
        return EXIT_LEAD_ON_HOLD

    full_message = f"{BRIDGE_PREFIX}{body}"
    # Calls the 4-tuple chokepoint DIRECTLY, exactly as #708's merged
    # create-catering-lead does. An intermediate wrapper would have given this
    # script a bespoke seam, and the e2e harness patches scripts by attribute
    # name — a private seam here means the harness silently fails to intercept.
    ok, mid, err, send_status = _bridge_post_4tuple(jid, full_message)
    mid_or_err = mid if ok else (err or send_status)

    if not ok:
        # `reason` stays "bridge_unreachable" — see _emit_send_unconfirmed for why
        # that Literal must not gain a value. The certainty lives in the new row.
        # No owner page and no lead marker here, deliberately: this is the GENERIC
        # ack sender with many callers, its failure already reaches the caller as
        # rc 6, and paging on every ack would drown the pages that mean something
        # (a quote, a booking, a payment link).
        _emit_ack_failed(jid, "bridge_unreachable", mid_or_err, **_ids)
        _emit_send_unconfirmed(jid, args.lead_id.strip(), send_status,
                               mid_or_err, **_ids)
        sys.stderr.write(f"bridge_post failed: {mid_or_err} (status={send_status})\n")
        return EXIT_DEPENDENCY_DOWN

    if not mid_or_err:
        _emit_ack_failed(jid, "empty_response", "bridge returned ok with no messageId", **_ids)
        sys.stderr.write("bridge returned ok with no messageId\n")
        return EXIT_DEPENDENCY_DOWN

    _emit_ack_sent(jid, mid_or_err, args.lead_id, **_ids)
    json.dump({"ok": True, "outbound_message_id": mid_or_err}, sys.stdout)
    sys.stdout.write("\n")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
