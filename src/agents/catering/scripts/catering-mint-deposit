#!/usr/bin/env python3
"""catering-mint-deposit — Agent #2 deposit-link minter (slice-2 commit 2).

Invoked as a subprocess by apply-catering-owner-decision AFTER its FileLock
(LEADS_LOCK) releases, post-SENT_TO_CUSTOMER persistence. Mints a slice-1
commerce_payment_link intent on a synthetic CommerceCart, sends the link to
the customer, and writes the catering_deposit_link_sent audit row with
cross-reference fields per reconciliation invariant #4.

Usage:
  catering-mint-deposit --lead-id L0007

Exit codes:
  0  — OK (success OR in-script no-op for threshold-not-met / already-minted)
  2  — invalid input (missing --lead-id, threshold violation that callers
       should be aware of, deposit amount below minimum, etc.)
  4  — lead not found
  5  — schema violation (config / state file load failed)
  6  — bridge unreachable (customer never saw the link)

Design: tasks/hermes-commerce-slice2-catering-deposit-caller-design.md
PRD: tasks/hermes-commerce-prd-v2.md (slice-2 caller invariants §7 + §10)
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

sys.path.insert(0, "/opt/shift-agent")
# Repo-relative fallback for in-repo test runs (deployed VPS already has
# /opt/shift-agent on sys.path above). Walk up from /src/agents/catering/scripts/
# to repo root then add src/platform + src/agents/catering.
_THIS = Path(__file__).resolve()
_REPO_ROOT = _THIS.parent.parent.parent.parent.parent  # scripts/<file> -> catering -> agents -> src -> repo
sys.path.insert(0, str(_REPO_ROOT / "src" / "platform"))
sys.path.insert(0, str(_REPO_ROOT / "src" / "agents" / "catering"))

from safe_io import (  # noqa: E402
    FileLock, atomic_write_json, customer_now,
    load_model, load_yaml_model,
)
from safe_io import bridge_post as _bridge_post_4tuple  # noqa: E402
from schemas import (  # noqa: E402
    Config, CateringLeadStore,
)
from exit_codes import (  # noqa: E402
    EXIT_OK, EXIT_INVALID_INPUT, EXIT_NOT_FOUND,
    EXIT_SCHEMA_VIOLATION, EXIT_DEPENDENCY_DOWN,
)
from pydantic import ValidationError  # noqa: E402

from commerce import cart as commerce_cart  # noqa: E402
from commerce import order_state as commerce_order  # noqa: E402
from commerce import payment_link as commerce_payment_link  # noqa: E402
from commerce.exceptions import CommerceCheckoutUrlUnrenderable  # noqa: E402

# Import the catering deposit helpers from the same agent package
from deposit import (  # noqa: E402
    _should_mint_deposit,
    _compute_deposit_amount_cents,
    _render_customer_reply,
    _render_unconfigured_reply,
    BRIDGE_PREFIX,
)


CONFIG_PATH = Path(os.environ.get("SHIFT_AGENT_CONFIG_PATH", "/opt/shift-agent/config.yaml"))
LEADS_PATH = Path(os.environ.get("SHIFT_AGENT_LEADS_PATH", "/opt/shift-agent/state/catering-leads.json"))
LEADS_LOCK = Path(os.environ.get("SHIFT_AGENT_LEADS_LOCK", "/opt/shift-agent/state/catering-leads.json.lock"))
LOG_PATH = Path(os.environ.get("SHIFT_AGENT_LOG_PATH", "/opt/shift-agent/logs/decisions.log"))
COMMERCE_CARTS_PATH = Path(os.environ.get("COMMERCE_CARTS_PATH", "/opt/shift-agent/state/commerce/carts.json"))
COMMERCE_ORDERS_PATH = Path(os.environ.get("COMMERCE_ORDERS_PATH", "/opt/shift-agent/state/commerce/orders.json"))
COMMERCE_INTENTS_PATH = Path(os.environ.get("COMMERCE_INTENTS_PATH", "/opt/shift-agent/state/commerce/payment_intents.json"))
COMMERCE_REFERENCES_PATH = Path(os.environ.get("COMMERCE_REFERENCES_PATH", "/opt/shift-agent/state/commerce/payment_references.json"))


def _emit_deposit_link_sent(
    *,
    lead_id: str,
    commerce_order_id: str,
    commerce_payment_intent_id: str,
    amount_cents: int,
    url_status: str,
    outbound_message_id: str,
    now: datetime,
) -> None:
    """Emit catering_deposit_link_sent audit row via the commerce.audit chokepoint."""
    from commerce.audit import emit
    emit(
        LOG_PATH,
        {
            "type": "catering_deposit_link_sent",
            "ts": now.isoformat(),
            "lead_id": lead_id,
            "commerce_order_id": commerce_order_id,
            "commerce_payment_intent_id": commerce_payment_intent_id,
            "amount_cents": amount_cents,
            "url_status": url_status,
            "outbound_message_id": outbound_message_id,
        },
    )


def _emit_deposit_link_failed(
    *,
    lead_id: str,
    reason: str,
    detail: str = "",
    commerce_order_id: str = "",
    commerce_payment_intent_id: str = "",
    now: Optional[datetime] = None,
) -> None:
    """Best-effort: emit catering_deposit_link_failed; swallow errors."""
    from commerce.audit import emit
    try:
        emit(
            LOG_PATH,
            {
                "type": "catering_deposit_link_failed",
                "ts": (now or datetime.now(timezone.utc)).isoformat(),
                "lead_id": lead_id,
                "reason": reason,
                "detail": detail[:500],
                "commerce_order_id": commerce_order_id,
                "commerce_payment_intent_id": commerce_payment_intent_id,
            },
        )
    except Exception as e:  # noqa: BLE001 — best-effort by contract
        sys.stderr.write(f"WARN: failed to emit catering_deposit_link_failed: {e}\n")


def _emit_deposit_link_send_unconfirmed(
    *,
    lead_id: str,
    commerce_order_id: str,
    commerce_payment_intent_id: str,
    amount_cents: int,
    detail: str,
    cfg,
) -> None:
    """Best-effort: emit catering_deposit_link_send_unconfirmed; swallow errors.

    The uncertain arm's money-evidence row. It replaces the
    `commerce_payment_link_failed` + `catering_deposit_link_failed` pair rather
    than joining them: with no void on this arm, the first row's
    attempted -> failed -> voided contract no longer holds, and the second would
    claim a `bridge_send_failed` that did not happen. Both told an operator the
    link was dead while it was live and payable.
    """
    from commerce.audit import emit
    try:
        emit(
            LOG_PATH,
            {
                "type": "catering_deposit_link_send_unconfirmed",
                "ts": customer_now(cfg.customer.timezone).isoformat(),
                "lead_id": lead_id,
                "delivery_certainty": "uncertain",
                "commerce_order_id": commerce_order_id,
                "commerce_payment_intent_id": commerce_payment_intent_id,
                "amount_cents": amount_cents,
                "detail": detail[:500],
            },
        )
    except Exception as e:  # noqa: BLE001 — best-effort by contract
        sys.stderr.write(
            f"WARN: failed to emit catering_deposit_link_send_unconfirmed: {e}\n")


def _emit_deposit_reinvoke_refused(
    *,
    lead_id: str,
    prior_status_at,
    commerce_order_id: str,
    commerce_payment_intent_id: str,
    amount_cents: int,
    owner_paged: bool,
    detail: str,
    cfg,
) -> None:
    """Best-effort: emit catering_deposit_reinvoke_refused; swallow errors.

    A NEW audit tag rather than another `CateringDepositLinkFailed.reason`.
    That variant's `reason` Literal is byte-identical in the pinned rollback
    target, so widening it would make the OLD reader reject a row it recognises
    today; an unknown TAG routes cleanly to `_UnknownLogEntry` instead.
    """
    from commerce.audit import emit
    try:
        emit(
            LOG_PATH,
            {
                "type": "catering_deposit_reinvoke_refused",
                "ts": customer_now(cfg.customer.timezone).isoformat(),
                "lead_id": lead_id,
                "prior_delivery_status": "uncertain",
                "prior_delivery_status_at": prior_status_at,
                "commerce_order_id": commerce_order_id,
                "commerce_payment_intent_id": commerce_payment_intent_id,
                "amount_cents": amount_cents,
                "owner_paged": owner_paged,
                "detail": detail[:500],
            },
        )
    except Exception as e:  # noqa: BLE001 — best-effort by contract
        sys.stderr.write(f"WARN: failed to emit catering_deposit_reinvoke_refused: {e}\n")


def _notify_owner_best_effort(priority: int, title: str, body: str) -> bool:
    """Pushover P1 on money-adjacent silent failure (Reviewer B HIGH-2).

    Returns whether the page was delivered so the audit row can record it.
    Existing callers ignore the return and are unaffected."""
    try:
        proc = subprocess.run(
            ["/usr/local/bin/shift-agent-notify-owner",
             "--priority", str(priority), "--title", title, body],
            check=False, timeout=10,
        )
        return proc.returncode == 0
    except Exception as e:  # noqa: BLE001 — notification is best-effort
        sys.stderr.write(
            f"WARN: shift-agent-notify-owner failed (non-fatal): "
            f"{type(e).__name__}: {e}\n"
        )
        return False


def _post_deposit_link(jid: str, message: str) -> tuple[bool, str, str]:
    """(ok, message_id_or_error, status) over the canonical 4-tuple chokepoint.

    P17: `status` is carried out rather than collapsed. On THIS script the
    distinction is money-shaped — `send_uncertain` means the bridge accepted a
    message containing a live payment link, so the customer most likely has one
    in hand, while `connect_failed` means they have nothing."""
    ok, mid, err, status = _bridge_post_4tuple(jid, message)
    return (True, mid, status) if ok else (False, err or status, status)


_CERTAINTY_BY_STATUS = {"send_uncertain": "uncertain"}


def _delivery_certainty(send_status: str) -> str:
    """'uncertain' only for safe_io's `send_uncertain` (bridge accepted, ack body
    unparseable → most likely delivered). Every other non-sent status — transport
    faults AND the policy drops — means the customer received nothing."""
    return _CERTAINTY_BY_STATUS.get(send_status, "failed")


def _mark_deposit_link_delivery(store, matched_idx: int, marker: str,
                                cfg, lead_id: str) -> None:
    """Stamp `deposit_link_delivery_status` on the lead already held in `store`.

    Runs INSIDE the caller's LEADS_LOCK on the store it already loaded, so no
    second critical section and no re-read. Best-effort: a marker write that
    fails must never mask the send failure it describes, and must never disturb
    the intent void / order cancel that follow it."""
    try:
        now = customer_now(cfg.customer.timezone)
        store.leads[matched_idx] = store.leads[matched_idx].model_copy(update={
            "deposit_link_delivery_status": marker,
            "deposit_link_delivery_status_at": now,
        })
        atomic_write_json(LEADS_PATH, store)
    except Exception as e:  # noqa: BLE001 — never mask the send failure
        sys.stderr.write(f"WARN: deposit_link_delivery_status marker write failed "
                         f"for {lead_id} ({type(e).__name__}: {e}); the audit row "
                         f"still stands\n")


def _bind_unconfirmed_deposit_evidence(store, matched_idx: int, *, cfg, lead_id: str,
                                       commerce_order_id: str,
                                       commerce_payment_intent_id: str,
                                       amount_cents: int, url_status: str) -> None:
    """Persist WHAT was minted on a send we could not confirm (R3, literal).

    The uncertain arm's counterpart to the success-path binding. The link is
    LIVE and the customer most likely holds it, so the lead has to carry the
    provider intent, the order, the amount and the mint time. Two reasons this
    is not optional: `commerce-payment-confirm` finds the lead for an incoming
    payment by `deposit_payment_intent_id` alone, so an unbound lead orphans a
    payment the customer can still make; and the re-invoke guard needs a durable
    record to refuse against.

    `deposit_status` follows the same rule as the delivered path because it
    describes the MONEY fact — a live link is awaiting payment whether or not we
    can prove the message arrived. The delivery fact lives in its own field, and
    the two must never be collapsed into one transition.

    One atomic write for both facts, inside the caller's LEADS_LOCK, so "a link
    exists" and "we could not confirm delivery" can never disagree on disk.
    Best-effort in the same sense as the marker it replaces: a write failure
    must not mask the send failure that provoked it.
    """
    try:
        now = customer_now(cfg.customer.timezone)
        store.leads[matched_idx] = store.leads[matched_idx].model_copy(update={
            "deposit_required": True,
            "deposit_amount_cents": amount_cents,
            "deposit_commerce_order_id": commerce_order_id,
            "deposit_payment_intent_id": commerce_payment_intent_id,
            "deposit_status": "awaiting_payment" if url_status == "configured" else "unconfigured",
            "deposit_minted_at": now,
            "deposit_link_delivery_status": "uncertain",
            "deposit_link_delivery_status_at": now,
            "updated_at": now,
        })
        atomic_write_json(LEADS_PATH, store)
    except Exception as e:  # noqa: BLE001 — never mask the send failure
        sys.stderr.write(f"WARN: unconfirmed-deposit evidence bind failed for "
                         f"{lead_id} ({type(e).__name__}: {e}); intent "
                         f"{commerce_payment_intent_id} is live and unrecorded on "
                         f"the lead — reconcile from the audit log\n")


def _emit_customer_send_unconfirmed(*, lead_id: str, certainty: str,
                                    send_status: str, detail: str,
                                    transport_destination: str,
                                    owner_paged: bool, cfg) -> None:
    """The typed row that makes an unconfirmed deposit-link send searchable.

    Shares `catering_customer_send_unconfirmed` with the other P17 scripts so a
    single query answers "which sends could we not confirm?" across catering."""
    from commerce.audit import emit
    try:
        emit(
            LOG_PATH,
            {
                "type": "catering_customer_send_unconfirmed",
                "ts": customer_now(cfg.customer.timezone).isoformat(),
                "lead_id": lead_id,
                "script": "catering-mint-deposit",
                "send_kind": "deposit_link",
                "send_status": send_status,
                "delivery_certainty": certainty,
                "detail": detail[:2000],
                "owner_paged": owner_paged,
                "transport_destination": transport_destination,
                "outcome": send_status,
            },
        )
    except Exception as e:  # noqa: BLE001 — audit is best-effort
        sys.stderr.write(f"WARN: failed to emit catering_customer_send_unconfirmed: "
                         f"{e}\n")


def _find_live_intent_for_lead(intent_state_path: Path, lead_id: str):
    """S1-1 double-charge guard support. Return a non-terminal payment intent
    minted for this lead under the deterministic originating_message_id, or None.

    The mint (catering-mint-deposit) and the lead-binding persist share one
    FileLock, so `originating_message_id == catering_deposit_<lead_id>` on a
    non-terminal intent while the lead is UNBOUND is the only committed trace of
    a crash between the customer-facing send and the binding persist. Best-effort:
    on any read error, return None (the caller then proceeds as today — we never
    convert a read glitch into a hard block)."""
    try:
        store = commerce_payment_link.load_intent_store(intent_state_path)
    except Exception as e:  # noqa: BLE001 — advisory guard, never fail-hard on read
        sys.stderr.write(f"WARN: _find_live_intent_for_lead read failed: {e}\n")
        return None
    origin = f"catering_deposit_{lead_id}"
    return next(
        (i for i in store.intents
         if i.originating_message_id == origin
         and i.status not in {"voided", "refunded", "chargeback"}),
        None,
    )


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--lead-id", required=True, help="catering lead ID (e.g. L0007)")
    args = ap.parse_args()

    # Load config
    try:
        cfg = load_yaml_model(CONFIG_PATH, Config)
    except (FileNotFoundError, RuntimeError, ValidationError) as e:
        sys.stderr.write(f"config load failed: {type(e).__name__}: {e}\n")
        return EXIT_SCHEMA_VIOLATION

    with FileLock(LEADS_LOCK):
        store, status = load_model(LEADS_PATH, CateringLeadStore, default=CateringLeadStore())
        if status not in ("ok", "missing"):
            sys.stderr.write(f"leads file load status={status!r}; refusing\n")
            return EXIT_SCHEMA_VIOLATION

        matched_idx = next(
            (i for i, l in enumerate(store.leads) if l.lead_id == args.lead_id),
            None,
        )
        if matched_idx is None:
            sys.stderr.write(f"lead_id {args.lead_id!r} not found\n")
            return EXIT_NOT_FOUND

        lead = store.leads[matched_idx]

        # P1 2026-08-15 — an unconfirmed deposit send is terminal to AUTOMATION.
        # `uncertain` means the bridge ACCEPTED a message carrying a live payment
        # link, so the customer most likely holds one. That is a message-delivery
        # fact we cannot resolve from here, and no automated path may try to:
        # minting again would put a SECOND, different link in front of someone who
        # probably already has one. Only a supervised operator action resolves it.
        #
        # Ordered BEFORE the idempotency check below on purpose. The uncertain arm
        # binds `deposit_payment_intent_id`, so that check would otherwise answer
        # first with a clean `already_minted` no-op at EXIT_OK — turning an
        # unreconciled money state into silence. It also precedes the
        # `_find_live_intent_for_lead` guard, which would refuse too (the intent
        # stays live) but with the wrong story: that guard reports a mint that
        # crashed before binding, not a link that most likely reached the customer.
        #
        # The BINDING is required as well as the marker, and that is not belt-and-
        # braces. The PREVIOUS release voided the intent and left the lead unbound
        # on this arm, so every lead it stranded carries the marker with no intent,
        # no order and no amount: on a marker-only test those leads are refused
        # forever while the page and the audit row announce a LIVE link and name
        # `intent ""`, `order ""`, `$0.00` — three false claims about money. They
        # have nothing live in the customer's hands, so a re-mint is their correct
        # recovery. Narrowing reopens nothing: this arm always binds now, and an
        # unbound lead whose intent IS still live is caught a few lines below by
        # `_find_live_intent_for_lead`, which is the guard that describes that
        # state accurately.
        if lead.deposit_link_delivery_status == "uncertain" and lead.deposit_payment_intent_id:
            paged = _notify_owner_best_effort(
                priority=1,
                title=f"Catering deposit re-invoke refused (lead {lead.lead_id})",
                body=(f"Lead {lead.lead_id} already has a LIVE deposit link "
                      f"(intent {lead.deposit_payment_intent_id}, order "
                      f"{lead.deposit_commerce_order_id}, "
                      f"${lead.deposit_amount_cents/100:.2f}) whose delivery was "
                      f"never confirmed — the customer most likely holds it and it "
                      f"can still take a payment. Refusing to mint a second link. "
                      f"Read the customer's chat, then resolve it by hand: "
                      f"catering-lead-reconcile --lead-id {lead.lead_id} "
                      f"--deposit-delivery confirmed-delivered --reason '...' if "
                      f"the link arrived (it stays live and payable), or "
                      f"--deposit-delivery not-delivered --reason '...' if it did "
                      f"not (voids {lead.deposit_payment_intent_id}, unbinds the "
                      f"lead and frees it for a fresh mint)."),
            )
            _emit_deposit_reinvoke_refused(
                lead_id=lead.lead_id,
                prior_status_at=lead.deposit_link_delivery_status_at,
                commerce_order_id=lead.deposit_commerce_order_id,
                commerce_payment_intent_id=lead.deposit_payment_intent_id,
                amount_cents=lead.deposit_amount_cents,
                owner_paged=bool(paged),
                detail=("prior deposit-link send was accepted by the bridge but "
                        "unconfirmed; refusing a 2nd mint pending operator "
                        "reconciliation"),
                cfg=cfg,
            )
            print(json.dumps({
                "lead_id": lead.lead_id,
                "refused": "delivery_uncertain",
                "intent_id": lead.deposit_payment_intent_id,
                "order_id": lead.deposit_commerce_order_id,
                "owner_paged": bool(paged),
            }))
            return EXIT_INVALID_INPUT

        # Reviewer A HIGH-2: re-check idempotency AFTER acquiring lock so a
        # parallel manual invocation can't interleave between the post-send
        # hook's invocation and ours.
        if lead.deposit_payment_intent_id:
            print(json.dumps({"lead_id": lead.lead_id, "noop": "already_minted"}))
            return EXIT_OK

        # S1-1 double-charge guard. We only reach here with the lead UNBOUND
        # (deposit_payment_intent_id falsy). If a non-terminal intent already
        # exists for this lead's deterministic originating_message_id, a prior
        # mint crashed AFTER minting/sending the link but BEFORE persisting the
        # binding. Minting again would build a fresh cart -> fresh order -> fresh
        # intent -> a SECOND, different payment link (double-charge once a live
        # provider is configured). Fail closed: refuse, audit, P1-alert, exit
        # non-zero. apply-catering-owner-decision logs the non-zero rc and never
        # rolls back the quote-send. (Full auto-resend recovery is deferred to
        # the slice-3 provider PR — see tasks/audit-remediation-2026-07-plan.md.)
        recovered = _find_live_intent_for_lead(COMMERCE_INTENTS_PATH, lead.lead_id)
        if recovered is not None:
            _emit_deposit_link_failed(
                lead_id=lead.lead_id, reason="reinvoke_live_intent_exists",
                detail=(f"live intent {recovered.intent_id} status={recovered.status}; "
                        f"lead unbound; refusing 2nd mint (double-charge guard)"),
                commerce_order_id=recovered.order_id,
                commerce_payment_intent_id=recovered.intent_id,
            )
            _notify_owner_best_effort(
                priority=1,
                title=f"Catering deposit re-invoke blocked (lead {lead.lead_id})",
                body=(f"Live intent {recovered.intent_id} (order {recovered.order_id}, "
                      f"status {recovered.status}) exists for lead {lead.lead_id} but the "
                      f"lead is unbound — a prior mint likely crashed before persisting the "
                      f"binding. Refusing to send a 2nd deposit link (double-charge guard). "
                      f"Reconcile: bind the lead to {recovered.intent_id} or void it."),
            )
            print(json.dumps({"lead_id": lead.lead_id,
                              "refused": "reinvoke_live_intent_exists",
                              "intent_id": recovered.intent_id,
                              "order_id": recovered.order_id}))
            return EXIT_INVALID_INPUT

        if not _should_mint_deposit(cfg, lead):
            # Not an error — just doesn't apply (threshold not met, etc.)
            print(json.dumps({"lead_id": lead.lead_id, "noop": "threshold_not_met"}))
            return EXIT_OK

        deposit_amount_cents = _compute_deposit_amount_cents(
            lead.quote_total_usd, cfg.catering.deposit_pct,
        )
        if deposit_amount_cents <= 0:
            _emit_deposit_link_failed(lead_id=lead.lead_id, reason="zero_amount",
                                       detail=f"quote_total_usd={lead.quote_total_usd}")
            return EXIT_INVALID_INPUT
        if deposit_amount_cents < cfg.commerce.minimum_deposit_cents:
            _emit_deposit_link_failed(
                lead_id=lead.lead_id, reason="below_minimum",
                detail=f"{deposit_amount_cents}<min={cfg.commerce.minimum_deposit_cents}",
            )
            return EXIT_INVALID_INPUT

        # Build synthetic cart with isolated chat_id (Reviewer B HIGH-1 + A MEDIUM-1)
        synthetic_chat_id = f"catering_deposit_{lead.lead_id}@s.whatsapp.net"
        # PR reviewer B-MEDIUM-1: wrap in try/except so oversize deposit_amount_cents
        # (which would trip CommerceCartItem.unit_price_cents le=10_000_000_000)
        # produces a clean cart_build_failed audit row instead of an uncaught
        # ValidationError that exits the script with traceback.
        try:
            cart_result = commerce_cart.add_item(
                state_path=COMMERCE_CARTS_PATH,
                decisions_log_path=LOG_PATH,
                sender_phone=str(lead.customer_phone),
                sender_lid=None,
                chat_id=synthetic_chat_id,
                sku=f"CATERING-DEPOSIT-{lead.lead_id}",
                display_name=f"Catering deposit for {lead.customer_name or 'event'}"[:200],
                quantity=1,
                unit="each",
                unit_price_cents=deposit_amount_cents,
                currency="USD",
            )
        except ValidationError as e:
            _emit_deposit_link_failed(
                lead_id=lead.lead_id, reason="cart_build_failed",
                detail=f"ValidationError: {str(e)[:400]}",
            )
            return EXIT_SCHEMA_VIOLATION
        if not cart_result.ok:
            _emit_deposit_link_failed(
                lead_id=lead.lead_id, reason="cart_build_failed", detail=cart_result.detail,
            )
            return EXIT_SCHEMA_VIOLATION

        order_result = commerce_order.create(
            state_path=COMMERCE_ORDERS_PATH,
            decisions_log_path=LOG_PATH,
            cart=cart_result.cart,
            cart_state_path=COMMERCE_CARTS_PATH,
        )
        if not order_result.ok:
            _emit_deposit_link_failed(
                lead_id=lead.lead_id, reason="order_create_failed",
                detail=order_result.detail,
            )
            return EXIT_SCHEMA_VIOLATION

        intent_result = commerce_payment_link.mint(
            intent_state_path=COMMERCE_INTENTS_PATH,
            decisions_log_path=LOG_PATH,
            order_id=order_result.order.order_id,
            originating_message_id=f"catering_deposit_{lead.lead_id}",
            amount_cents=deposit_amount_cents,
            currency="USD",
            chat_id=synthetic_chat_id,
            checkout_url_template=cfg.commerce.payment_checkout_url_template,
        )
        if not intent_result.ok:
            # PR reviewer B-MEDIUM-2: cancel the order so it doesn't sit as an
            # orphan in the commerce ledger. The cart was built, the order was
            # created, but no intent exists — without cancellation the order
            # would accumulate as silent drift until the §12a watchdog catches
            # it. Best-effort: if cancel itself fails we still audit the original
            # intent_mint_failed.
            try:
                commerce_order.cancel(
                    state_path=COMMERCE_ORDERS_PATH,
                    decisions_log_path=LOG_PATH,
                    order_id=order_result.order.order_id,
                    reason="intent_mint_failed_orphan_cleanup",
                    actor="cron",
                )
            except Exception as cancel_err:  # noqa: BLE001 — best-effort cleanup
                sys.stderr.write(
                    f"WARN: order cancel-on-intent-fail failed (non-fatal): "
                    f"{type(cancel_err).__name__}: {cancel_err}\n"
                )
            _emit_deposit_link_failed(
                lead_id=lead.lead_id, reason="intent_mint_failed",
                detail=intent_result.detail,
                commerce_order_id=order_result.order.order_id,
            )
            return EXIT_SCHEMA_VIOLATION

        # Attempted/sent/failed triple (Reviewer A MEDIUM-3 from slice-1 review)
        commerce_payment_link.mark_attempted(
            intent_state_path=COMMERCE_INTENTS_PATH,
            decisions_log_path=LOG_PATH,
            intent_id=intent_result.intent.intent_id,
        )

        url = intent_result.intent.checkout_url
        try:
            commerce_payment_link.assert_payment_url_renderable(url)
            reply_body = _render_customer_reply(
                lead, deposit_amount_cents, cfg.catering.deposit_pct, url,
            )
            url_status = "configured"
        except CommerceCheckoutUrlUnrenderable:
            reply_body = _render_unconfigured_reply(lead)
            url_status = "unconfigured"

        target_jid = f"{str(lead.customer_phone).lstrip('+')}@s.whatsapp.net"
        ok, mid_or_err, send_status = _post_deposit_link(
            target_jid, BRIDGE_PREFIX + reply_body)
        send_certainty = _delivery_certainty(send_status)
        if not ok:
            # Two facts, and they must never share one transition: whether a
            # payment link EXISTS is a provider fact; whether the message
            # carrying it ARRIVED is a transport fact. A definite drop resolves
            # both — the customer got nothing, so the link should not outlive the
            # send, and a re-invoke is the correct recovery. `send_uncertain`
            # resolves only the transport fact, and resolves it to "unknown", so
            # the destructive half (void + cancel) must not fire on it: that
            # would erase a real provider fact because a message fact was unknown,
            # and leave the customer holding a link that silently cannot pay.
            definite_failure = send_certainty == "failed"
            if definite_failure:
                _mark_deposit_link_delivery(store, matched_idx, send_certainty,
                                            cfg, lead.lead_id)
            else:
                _bind_unconfirmed_deposit_evidence(
                    store, matched_idx, cfg=cfg, lead_id=lead.lead_id,
                    commerce_order_id=order_result.order.order_id,
                    commerce_payment_intent_id=intent_result.intent.intent_id,
                    amount_cents=deposit_amount_cents, url_status=url_status,
                )
            if definite_failure:
                # Reviewer A BLOCKER-2: emit failed BEFORE void so the triple
                # holds. Definite arm only — this row's documented contract is
                # to explain the void that follows it, and on the uncertain arm
                # there is no void for it to explain.
                commerce_payment_link.emit_payment_link_failed(
                    decisions_log_path=LOG_PATH,
                    intent_id=intent_result.intent.intent_id,
                    order_id=order_result.order.order_id,
                    reason=f"bridge_send_failed: {mid_or_err[:150]}",
                )
                commerce_payment_link.void(
                    intent_state_path=COMMERCE_INTENTS_PATH,
                    decisions_log_path=LOG_PATH,
                    intent_id=intent_result.intent.intent_id,
                    reason="customer_send_failed",
                    actor="caller",  # Reviewer A HIGH-3 + B HIGH-3
                )
                # Slice-2.5 ledger-cleanliness fix (operator-flagged from
                # 2026-05-29 deploy smoke). Parallel to the intent_mint_failed
                # cleanup ~30 lines above: cancel the orphan order so it doesn't
                # sit in `pending_payment` accumulating drift. Operator re-
                # invocation will mint a fresh intent against a NEW order_id;
                # without this, the prior order persists as ledger noise that
                # only the §12a freshness watchdog (slice 3) would notice.
                #
                # Only on the definite arm. An uncertain send's order backs a
                # link the customer probably holds, so it is not an orphan.
                try:
                    commerce_order.cancel(
                        state_path=COMMERCE_ORDERS_PATH,
                        decisions_log_path=LOG_PATH,
                        order_id=order_result.order.order_id,
                        reason="bridge_send_failed_orphan_cleanup",
                        actor="cron",  # order_state.cancel actor is Literal[customer|operator|cron]
                    )
                except Exception as cancel_err:  # noqa: BLE001 — best-effort cleanup
                    sys.stderr.write(
                        f"WARN: order cancel-on-bridge-fail failed (non-fatal): "
                        f"{type(cancel_err).__name__}: {cancel_err}\n"
                    )
            # One evidence row per arm, each named for what actually happened.
            # `bridge_send_failed` is a claim about the customer receiving
            # nothing, so it belongs only where that is true.
            if definite_failure:
                _emit_deposit_link_failed(
                    lead_id=lead.lead_id, reason="bridge_send_failed",
                    detail=mid_or_err[:500],
                    commerce_order_id=order_result.order.order_id,
                    commerce_payment_intent_id=intent_result.intent.intent_id,
                )
            else:
                _emit_deposit_link_send_unconfirmed(
                    lead_id=lead.lead_id,
                    commerce_order_id=order_result.order.order_id,
                    commerce_payment_intent_id=intent_result.intent.intent_id,
                    amount_cents=deposit_amount_cents,
                    detail=str(mid_or_err),
                    cfg=cfg,
                )
            paged = _notify_owner_best_effort(
                priority=1,
                title=f"Catering deposit bridge fail (lead {lead.lead_id})",
                body=(
                    f"Deposit mint succeeded for lead {lead.lead_id} "
                    f"(${deposit_amount_cents/100:.2f}) but WhatsApp bridge POST "
                    f"failed: {mid_or_err[:200]}. Intent voided. "
                    f"Re-invoke: catering-mint-deposit --lead-id {lead.lead_id}"
                ) if definite_failure else (
                    f"Deposit link for lead {lead.lead_id} "
                    f"(${deposit_amount_cents/100:.2f}) was ACCEPTED by the bridge "
                    f"but never confirmed, so the customer most likely HAS it. "
                    f"The link is LIVE and can still take a payment — intent "
                    f"{intent_result.intent.intent_id}, order "
                    f"{order_result.order.order_id}, both now recorded on the "
                    f"lead. Re-invoking catering-mint-deposit is REFUSED for this "
                    f"lead and will stay refused until someone resolves it by "
                    f"hand: read the customer's chat to see whether the link "
                    f"arrived, then run catering-lead-reconcile --lead-id "
                    f"{lead.lead_id} --deposit-delivery confirmed-delivered "
                    f"--reason '...' if it did (the link stays live to be paid), "
                    f"or --deposit-delivery not-delivered --reason '...' if it "
                    f"did not (voids {intent_result.intent.intent_id} and frees "
                    f"the lead for a fresh mint). Detail: {mid_or_err[:200]}"
                ),
            )
            _emit_customer_send_unconfirmed(
                lead_id=lead.lead_id, certainty=send_certainty,
                send_status=send_status, detail=str(mid_or_err),
                transport_destination=target_jid, owner_paged=bool(paged),
                cfg=cfg,
            )
            return EXIT_DEPENDENCY_DOWN

        commerce_payment_link.mark_sent(
            intent_state_path=COMMERCE_INTENTS_PATH,
            decisions_log_path=LOG_PATH,
            intent_id=intent_result.intent.intent_id,
        )

        now = customer_now(cfg.customer.timezone)
        new_lead = lead.model_copy(update={
            "deposit_required": True,
            "deposit_amount_cents": deposit_amount_cents,
            "deposit_commerce_order_id": order_result.order.order_id,
            "deposit_payment_intent_id": intent_result.intent.intent_id,
            "deposit_status": "awaiting_payment" if url_status == "configured" else "unconfigured",
            "deposit_minted_at": now,
            # Stamped in the SAME write as the deposit binding it justifies, so
            # "the link is live" and "the customer received it" can never
            # disagree on this path.
            "deposit_link_delivery_status": "sent",
            "deposit_link_delivery_status_at": now,
            "updated_at": now,
        })
        store.leads[matched_idx] = new_lead
        atomic_write_json(LEADS_PATH, store)

        _emit_deposit_link_sent(
            lead_id=lead.lead_id,
            commerce_order_id=order_result.order.order_id,
            commerce_payment_intent_id=intent_result.intent.intent_id,
            amount_cents=deposit_amount_cents,
            url_status=url_status,
            outbound_message_id=mid_or_err,
            now=now,
        )

    print(json.dumps({
        "lead_id": lead.lead_id,
        "deposit_amount_cents": deposit_amount_cents,
        "commerce_order_id": order_result.order.order_id,
        "commerce_payment_intent_id": intent_result.intent.intent_id,
        "url_status": url_status,
        "outbound_message_id": mid_or_err,
    }))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
