#!/usr/bin/env python3
"""apply-menu-update — owner decision handler for a pending menu update.

Called by Kimi (via apply_catering_menu_decision SKILL) when the owner
replies to the menu preview with the confirmation_code + verb (YES / NO /
EDIT). Looks up the pending update, applies the decision deterministically,
archives the prior menu (if any), and writes the audit entry.

ONE approval, TWO effects. On YES the menu is persisted as before, and then the
pricebook derived from it is activated through the EXISTING
import-catering-pricebook path (same validation, version bump, archive and audit
row). There is no second approval and no second store: the owner card built by
parse-menu-photo already states which prices change and which version lands, so
the `#XXXXX yes` they type is informed consent for both.

FAILURE ISOLATION: the menu is persisted FIRST and is never rolled back. If the
pricebook activation does not happen, the menu stays approved, the pricebook is
left byte-unchanged, and the partial outcome is audited
(catering_menu_pricebook_sync_failed) AND pushed to the owner via
`notify_owner_with_fallback` in `_report_pricebook_sync_failure` (there is no
`notify-owner` spelling anywhere in this file — grep the SYMBOL, not the noun).
Prices the owner has not seen must never go live; prices they approved must
never be lost.

WHAT THE OWNER IS TOLD. "Not activated" is not one state, so it must not be one
message. The alert is built from TWO measured facts, never from a canned failure
story: the `reason` (why activation did not happen) and `PriceSource` (what
actually prices a quote on THIS deployment right now — see that class). A
deployment with no pricebook at all is the common case, and telling its owner
that "the pricebook stays at its previous version" is the exact opposite of the
truth: there is no pricebook, and the corrected menu IS what quotes price from.

Usage:
  apply-menu-update --code "#A3F2X" --decision yes
  apply-menu-update --code "#A3F2X" --decision no --reason "wrong photo"

Exit codes:
  0 — applied (the menu landed; a pricebook-activation failure is reported on
      stderr + audited + pushed, and does NOT fail the approval)
  2 — invalid input
  4 — code not found among pending updates
  5 — schema violation
  9 — illegal transition (already applied / expired)
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import NamedTuple, Optional

sys.path.insert(0, "/opt/shift-agent")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent.parent / "platform"))

from safe_io import (  # noqa: E402
    FileLock, atomic_write_json, ndjson_append, customer_now,
    safe_load_json, load_model, flock,
    load_yaml_model, notify_owner_with_fallback,
)
from schemas import (  # noqa: E402
    Config, Menu, MenuPendingUpdate,
    CateringMenuPricebookSyncFailed, CateringMenuPricebookSynced,
    MenuUpdateApplied, MenuUpdateRejected,
)
from exit_codes import (  # noqa: E402
    EXIT_OK, EXIT_INVALID_INPUT, EXIT_NOT_FOUND,
    EXIT_SCHEMA_VIOLATION, EXIT_ILLEGAL_TRANSITION,
    EXIT_PRIVILEGE_DENIED,
)
from audit_helpers import log_config_load_failed_best_effort  # noqa: E402
from catering_paths import (  # noqa: E402
    CATERING_MENU_ARCHIVE_DIR, CATERING_MENU_LOCK, CATERING_MENU_PATH,
    CATERING_PRICEBOOK_PATH,
)
import catering_pricing as _pricing  # noqa: E402
from pydantic import TypeAdapter, ValidationError  # noqa: E402

# PR-D2 commit 1: SHIFT_AGENT_CONFIG_PATH env var override (test-only).
CONFIG_PATH = Path(os.environ.get("SHIFT_AGENT_CONFIG_PATH", "/opt/shift-agent/config.yaml"))
MENU_PATH = CATERING_MENU_PATH
MENU_LOCK = CATERING_MENU_LOCK
PENDING_PATH = Path("/opt/shift-agent/state/catering-menu-pending.json")
PENDING_LOCK = Path("/opt/shift-agent/state/catering-menu-pending.json.lock")
ARCHIVE_DIR = CATERING_MENU_ARCHIVE_DIR
LOG_PATH = Path("/opt/shift-agent/logs/decisions.log")
# Read-only here: the pricebook is written ONLY by import-catering-pricebook.
# This path is used to render what the sync will do, never to write.
PRICEBOOK_PATH = Path(
    os.environ.get("SHIFT_AGENT_PRICEBOOK_PATH") or CATERING_PRICEBOOK_PATH)
# Sibling-script invocation, same shape as select-catering-proposal -> finalize.
IMPORT_PRICEBOOK_BIN = Path("/usr/local/bin/import-catering-pricebook")
PYTHON_BIN = Path("/usr/local/lib/hermes-agent/venv/bin/python")


def _log(adapter: TypeAdapter, entry) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with flock(LOG_PATH):
        ndjson_append(LOG_PATH, adapter.dump_json(entry).decode("utf-8"))


class PriceSource(NamedTuple):
    """What actually prices a quote on this deployment, MEASURED at activation
    time rather than assumed. The owner alert states this instead of narrating a
    generic failure.

    kind:
      "menu_only" — no pricebook file (load_pricebook returns None,
          catering_pricing.py:1030-1036). finalize-catering-menu._load_pricebook
          then returns None and the legacy path prices every line straight off
          the menu index (`current_price = menu_index[item.name]`,
          finalize-catering-menu:241). So the corrected menu IS the price source:
          nothing "stays at its previous version", because nothing exists.
      "pricebook" — a valid pricebook is live at `version`. compute_quote
          resolves `item_price_overrides` FIRST and only falls back to the menu's
          `price_usd` (catering_pricing.py:363-369), so items the pricebook
          prices keep the OLD price and the rest follow the corrected menu.
      "blocked" — the file is present but will not load.
          finalize-catering-menu._load_pricebook exits 2 rather than quote at
          pre-pricebook prices (finalize-catering-menu:207-215), so no NEW quote
          can be finalized at all until it is repaired.

    In every kind, an ALREADY-finalized quote is untouched: the send path renders
    from the provenance frozen at finalize and never re-derives a price
    (apply-catering-owner-decision:302, and it loads no pricebook on the send
    path at all — only the --discount-id recompute does, at line 325).
    """
    kind: str
    version: Optional[int] = None


def _activate_pricebook(
    menu: Menu, pending: MenuPendingUpdate, now: datetime,
) -> tuple[bool, str, Optional[object], Optional[int], PriceSource]:
    """Activate the pricebook derived from the menu just persisted.

    Returns (ok, detail, sync, activated_version, price_source). The last element
    is the pricing basis observed while doing the work — the caller cannot
    re-derive it later without a second read that could race the importer, and
    without it the owner alert has to guess what a quote will price from.

    NEVER raises and NEVER writes the pricebook itself: it builds the document
    with the pure adapter and hands it to the EXISTING import-catering-pricebook,
    which owns the validation, the version bump, the archive and the audit row.
    The importer refuses a replay of this same `update_id`, so a re-run cannot
    double-bump.

    A failure here is contained on purpose — the caller keeps the approved menu.
    """
    try:
        active = _pricing.load_pricebook(PRICEBOOK_PATH)
    except _pricing.PricingError as e:
        return (False, f"active_pricebook_unreadable: {e}", None, None,
                PriceSource("blocked"))
    # Measured ONCE, here, while the pricebook is in hand.
    source = (PriceSource("menu_only") if active is None
              else PriceSource("pricebook", active.version))

    # The card the owner approved described a diff against a SPECIFIC pricebook.
    # If someone imported a new one in between, that diff is stale and the owner
    # never saw what would actually change — so the menu stands and the prices do
    # not move. They re-send the photo to get an honest card.
    #
    # An ABSENT stamp means the proposal predates the pricebook-activation scope
    # entirely (a pending update created by the previous release): its card
    # never showed a pricebook section or an "approving also activates" line,
    # so the owner never consented to a price change. Deployment-preflight
    # requirement: such proposals stay MENU-ONLY — fail closed, never activate.
    stamped = pending.pricebook_fingerprint
    if stamped is None:
        return (
            False,
            "proposal_predates_pricebook_scope: this menu proposal was created "
            "before pricebook activation existed, so its approval card never "
            "showed a price diff. The menu is applied; prices are NOT. Re-send "
            "the menu photo to get a card that can activate prices.",
            None, None, source,
        )
    current = _pricing.pricebook_fingerprint(active)
    if stamped != current:
        return (
            False,
            f"pricebook_changed_since_proposal: the card was built against "
            f"{stamped}, the live pricebook is {current}",
            None, None, source,
        )

    try:
        sync = _pricing.sync_pricebook_from_menu_items(
            menu.items, active,
            effective_date=now.date(), updated_at=now,
            source_menu_update_id=pending.update_id,
        )
    except (ValidationError, ValueError) as e:
        return (False, f"pricebook_document_invalid: {e}", None, None, source)

    handle = tempfile.NamedTemporaryFile(
        mode="w", suffix=".json", prefix="menu-pricebook-", delete=False, encoding="utf-8",
    )
    try:
        handle.write(sync.pricebook.model_dump_json())
        handle.close()
        proc = subprocess.run(
            [str(PYTHON_BIN), str(IMPORT_PRICEBOOK_BIN),
             "--file", handle.name, "--sender-role", "owner",
             "--updated-by", "menu_approval"],
            capture_output=True, text=True, timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as e:
        return (False, f"import_unrunnable: {type(e).__name__}: {e}", None, None,
                source)
    finally:
        Path(handle.name).unlink(missing_ok=True)

    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()[:300]
        return (False, f"import_exit_{proc.returncode}: {detail}", None, None,
                source)

    # The version the importer actually assigned, not the one predicted — a
    # replay reports "already_active" at the version already live.
    activated_version: Optional[int] = None
    for line in reversed([ln for ln in (proc.stdout or "").splitlines() if ln.strip()]):
        try:
            activated_version = json.loads(line).get("version")
            break
        except (json.JSONDecodeError, AttributeError):
            continue
    return (True, (proc.stdout or "").strip()[:300], sync, activated_version,
            source)


def _report_pricebook_synced(
    pending: MenuPendingUpdate, menu_version: int, sync, version: Optional[int],
    now: datetime,
) -> None:
    """Record WHAT the activation changed. Without this the diff is computed
    twice (card + activation) and thrown away both times, leaving the audit
    unable to answer "what did approving that photo change?"."""
    counts = {"added": 0, "changed": 0, "removed": 0}
    removed_names: list[str] = []
    for change in sync.changes:
        counts[change.change] += 1
        if change.change == "removed":
            removed_names.append(change.name)
    try:
        _log(TypeAdapter(CateringMenuPricebookSynced), CateringMenuPricebookSynced(
            type="catering_menu_pricebook_synced", ts=now,
            update_id=pending.update_id, menu_version=menu_version,
            pricebook_version=version,
            added_count=counts["added"], changed_count=counts["changed"],
            removed_count=counts["removed"], excluded_count=len(sync.excluded),
            # Bounded: a removed override is an item losing its committed price,
            # which is the one part of the diff worth naming. Prices stay out.
            removed_names=sorted(removed_names)[:50],
        ))
    except Exception as e:  # noqa: BLE001 — audit is best-effort; both writes landed
        sys.stderr.write(f"sync audit emit failed (non-fatal): {e}\n")


# Why activation did not happen, in the owner's terms. Keyed by the `reason`
# token that also lands in the catering_menu_pricebook_sync_failed audit row, so
# the alert and the audit name the same state. `import_exit_<n>` is matched by
# prefix. The remainder of `detail` is appended for every reason EXCEPT the ones
# listed in _STATIC_DETAIL_REASONS, whose remainder is fixed prose the headline
# already says.
_FAILURE_HEADLINE = {
    # Source-NEUTRAL on purpose. An earlier draft said "No pricebook was
    # created", which is only true when none exists — reintroducing the very
    # coupling this split exists to break. The headline says WHY; the effect
    # sentence, and only it, says what prices a quote.
    "proposal_predates_pricebook_scope":
        "Prices were not activated: this proposal predates pricebook "
        "activation, so its approval card never showed a price diff.",
    "pricebook_changed_since_proposal":
        "Prices were not activated: the pricebook changed after your card was "
        "built, so the diff you approved is stale.",
    "active_pricebook_unreadable":
        "The pricebook file is present but will not load.",
    "pricebook_document_invalid":
        "Prices were not activated: the pricebook derived from this menu failed "
        "validation.",
    "import_unrunnable":
        "Prices were not activated: the pricebook importer could not be run.",
}
_FAILURE_ACTION = {
    "proposal_predates_pricebook_scope":
        "Re-send the menu photo to get a card that can activate prices.",
    "pricebook_changed_since_proposal":
        "Re-send the menu photo to get a card built against the live pricebook.",
    "active_pricebook_unreadable":
        "Repair or re-import it with import-catering-pricebook.",
}
_STATIC_DETAIL_REASONS = frozenset({"proposal_predates_pricebook_scope"})
_DEFAULT_ACTION = "Re-send the menu photo to retry the activation."


def _price_effect(source: PriceSource, menu_version: int) -> tuple[str, str]:
    """(alert title, one-sentence effect) for a menu that landed WITHOUT its
    pricebook activation. One sentence, one source of truth: the Pushover body
    and the `pricebook_effect` field the SKILL reads back to the owner in chat
    both come from here, so the two surfaces cannot drift into telling the owner
    two different stories about their prices.

    Every claim below is mechanically grounded in PriceSource's docstring.
    """
    if source.kind == "blocked":
        return (
            "Catering menu applied - pricebook unreadable, quoting BLOCKED",
            "No new quote can be finalized until it loads: finalize refuses "
            "rather than quote at pre-pricebook prices.",
        )
    if source.kind == "menu_only":
        return (
            "Catering menu applied - menu-only pricing (no pricebook)",
            f"There is no pricebook on this deployment, so quotes price from "
            f"the menu: new quotes use the corrected menu v{menu_version}.",
        )
    return (
        "Catering menu applied - pricebook NOT updated",
        f"The pricebook stays at v{source.version}: items it prices keep their "
        f"existing prices, and items it does not price follow the corrected "
        f"menu v{menu_version}.",
    )


def _owner_alert_for_failed_activation(
    menu_version: int, reason: str, detail: str, source: PriceSource,
) -> tuple[str, str]:
    """(title, plain-text body) describing the MEASURED state.

    Two axes, both measured, never narrated: `reason` says why activation did not
    happen, `source` says what prices a quote as a RESULT. Collapsing either into
    one generic string is the defect this exists to prevent — the incident alert
    told an owner with no pricebook at all that "the pricebook stays at its
    previous version" and that "quotes still use the old prices", when the
    corrected menu was in fact exactly what quotes would price from.

    Plain text on purpose (§12b): the reason tokens carry underscores and a
    Markdown parse would eat them and hand the owner a mangled alert. The notify
    chokepoint shells out to shift-agent-notify-owner, which posts to Pushover
    with no html/monospace parameter and caps the body at 1024 chars.
    """
    title, effect = _price_effect(source, menu_version)
    headline = _FAILURE_HEADLINE.get(reason, "Prices were not activated.")
    action = _FAILURE_ACTION.get(reason, _DEFAULT_ACTION)
    parts = [
        f"Menu v{menu_version} is live.",
        headline,
        effect,
        "Quotes already finalized are unchanged.",
        action,
        f"Reason: {reason}",
    ]
    if reason not in _STATIC_DETAIL_REASONS:
        _, _, rest = detail.partition(":")
        rest = " ".join(rest.split())[:240]
        if rest:
            parts[-1] = f"Reason: {reason} - {rest}"
    return title, " ".join(parts)


def _report_pricebook_sync_failure(
    update_id: str, menu_version: int, detail: str, source: PriceSource,
    now: datetime,
) -> None:
    """Audit + page the owner with what MEASURABLY happened. An owner told the
    wrong story about their prices acts on the wrong story."""
    sys.stderr.write(f"WARN: pricebook activation failed (menu is applied): {detail}\n")
    reason, _, _rest = detail.partition(":")
    try:
        _log(TypeAdapter(CateringMenuPricebookSyncFailed), CateringMenuPricebookSyncFailed(
            type="catering_menu_pricebook_sync_failed", ts=now,
            update_id=update_id, menu_version=menu_version,
            reason=reason.strip()[:100] or "unknown",
            # -1 when the subprocess never produced a status of its own.
            returncode=int(reason.rsplit("_", 1)[-1])
            if reason.startswith("import_exit_") else -1,
        ))
    except Exception as e:  # noqa: BLE001 — audit is best-effort; the menu landed
        sys.stderr.write(f"sync-failure audit emit failed (non-fatal): {e}\n")

    try:
        # parse_mode-free plain text via the notify chokepoint: underscore-bearing
        # reasons render as garbage under Markdown (§12b).
        title, body = _owner_alert_for_failed_activation(
            menu_version, reason.strip(), detail, source)
        notify_owner_with_fallback(
            title, body, priority=1, source="apply-menu-update",
        )
    except Exception as e:  # noqa: BLE001 — alerting is best-effort
        sys.stderr.write(f"owner notify failed (non-fatal): {type(e).__name__}: {e}\n")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--code", required=True, help="confirmation code, e.g. #A3F2X")
    ap.add_argument("--decision", required=True, choices=["yes", "no", "expired"])
    ap.add_argument("--reason", default="")
    ap.add_argument(
        "--sender-role", required=True,
        choices=["owner", "employee", "customer", "unknown"],
        help="resolved sender role from identify-sender; must be 'owner' to mutate state. "
             "Defense-in-depth against a screenshot-forwarded #XXXXX code that the "
             "dispatcher's role-gate failed to catch upstream (D-013).",
    )
    args = ap.parse_args()

    # Privilege check: owner-only operation. Reject before any state read/lock
    # so an attacker-controlled --code can't be probed against the pending file.
    if args.sender_role != "owner":
        sys.stderr.write(
            f"privilege denied: menu update is owner-only, got sender_role={args.sender_role!r}\n"
        )
        return EXIT_PRIVILEGE_DENIED

    code = args.code.strip()
    if not code.startswith("#") or len(code) != 6:
        sys.stderr.write(f"invalid code format: {code!r}\n")
        return EXIT_INVALID_INPUT

    try:
        cfg = load_yaml_model(CONFIG_PATH, Config)
    except (FileNotFoundError, RuntimeError, ValidationError) as e:
        log_config_load_failed_best_effort(CONFIG_PATH, e)
        sys.stderr.write(f"config load failed: {type(e).__name__}: {e}\n")
        return EXIT_SCHEMA_VIOLATION

    # Load pending update
    with FileLock(PENDING_LOCK):
        # load_model(default=None) RAISES on an absent or corrupt store rather
        # than returning a status, so the guard below could never fire on the
        # commonest case of all: the owner replying twice. An approval is
        # consumed by clearing this file, which makes "already applied" and "no
        # pending update" the same state — and it must answer with the documented
        # exit 4 the SKILL branches on, not an escaping traceback.
        try:
            pending, status = load_model(PENDING_PATH, MenuPendingUpdate, default=None)
        except FileNotFoundError:
            sys.stderr.write("no pending menu update found (missing)\n")
            return EXIT_NOT_FOUND
        except RuntimeError as e:
            sys.stderr.write(f"pending menu update is unreadable: {e}\n")
            return EXIT_SCHEMA_VIOLATION
        if pending is None or status != "ok":
            sys.stderr.write(f"no pending menu update found ({status})\n")
            return EXIT_NOT_FOUND
        if pending.confirmation_code != code:
            sys.stderr.write(
                f"code {code} does not match pending update "
                f"(pending code is {pending.confirmation_code})\n"
            )
            return EXIT_NOT_FOUND

        now = customer_now(cfg.customer.timezone)

        if args.decision in ("no", "expired"):
            reason = "owner_no" if args.decision == "no" else "ttl_expired"
            _log(TypeAdapter(MenuUpdateRejected), MenuUpdateRejected(
                type="menu_update_rejected", ts=now,
                update_id=pending.update_id, reason=reason,
            ))
            # Clear pending file
            try:
                PENDING_PATH.unlink()
            except FileNotFoundError:
                pass
            print(json.dumps({"update_id": pending.update_id, "status": "rejected",
                              "reason": reason}))
            return EXIT_OK

        # YES path — apply
        if not pending.extracted_items:
            sys.stderr.write("pending update has 0 items — refusing to apply empty menu\n")
            return EXIT_ILLEGAL_TRANSITION

        # Load existing menu (or none — first-run safe).
        # safe_io.load_model raises FileNotFoundError on missing if the model
        # has required fields with no default (Menu.updated_at qualifies).
        # Check existence first.
        with FileLock(MENU_LOCK):
            existing = None
            prev_version = 0
            if MENU_PATH.exists():
                try:
                    existing, _ = load_model(MENU_PATH, Menu, default=None)
                except (FileNotFoundError, Exception) as e:
                    sys.stderr.write(f"WARN: existing menu unreadable, treating as first-run: {e}\n")
                    existing = None
                if existing is not None:
                    prev_version = existing.version
                    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
                    archive_path = ARCHIVE_DIR / f"menu-v{prev_version}-{int(now.timestamp())}.json"
                    try:
                        shutil.copy2(MENU_PATH, archive_path)
                    except OSError as e:
                        sys.stderr.write(f"WARN: archive failed: {e}\n")

            # Build new menu
            new_menu = Menu(
                version=prev_version + 1,
                updated_at=now,
                updated_by="photo-ocr",
                source_image_id=pending.source_image_id,
                items=pending.extracted_items,
                notes=existing.notes if existing else "",  # preserve owner-set catering notes across photo updates
            )
            atomic_write_json(MENU_PATH, new_menu)

            _log(TypeAdapter(MenuUpdateApplied), MenuUpdateApplied(
                type="menu_update_applied", ts=now,
                update_id=pending.update_id,
                new_version=new_menu.version,
                item_count=len(new_menu.items),
                prev_version=prev_version,
            ))

        # Menu persistence has SUCCEEDED and is final from here on. Activate the
        # pricebook derived from it — outside MENU_LOCK (it takes the pricebook's
        # own lock) and inside PENDING_LOCK, so the pending file is still claimed
        # and a concurrent approval of the same code cannot interleave.
        (pricebook_ok, pricebook_detail, sync, pricebook_version,
         price_source) = _activate_pricebook(new_menu, pending, now)
        if pricebook_ok and sync is not None:
            _report_pricebook_synced(
                pending, new_menu.version, sync, pricebook_version, now)
        elif not pricebook_ok:
            _report_pricebook_sync_failure(
                pending.update_id, new_menu.version, pricebook_detail,
                price_source, now)

        # Clear pending
        try:
            PENDING_PATH.unlink()
        except FileNotFoundError:
            pass

    # The SKILL's owner-facing reply is the SAME claim as the Pushover, so it
    # reads the same measured sentence rather than composing a second one.
    # `pricebook_activated: false` alone cannot tell it whether prices froze,
    # whether there are no prices at all, or whether quoting is blocked.
    if pricebook_ok:
        live_source, live_version = "pricebook", pricebook_version
        # `activated_version` is parsed out of the importer's stdout and stays
        # None when that produced no JSON line. Naming a version we did not read
        # would be the same defect one layer down, so say what is known instead.
        effect = (
            f"Pricebook updated to v{pricebook_version}: new quotes use these "
            f"prices." if pricebook_version is not None else
            "Pricebook updated: new quotes use these prices. (The importer "
            "reported no version number; check catering_pricebook_updated.)"
        )
    else:
        live_source, live_version = price_source.kind, price_source.version
        _title, effect = _price_effect(price_source, new_menu.version)

    print(json.dumps({
        "update_id": pending.update_id,
        "status": "applied",
        "pricebook_activated": pricebook_ok,
        "pricebook_detail": pricebook_detail,
        "price_source": live_source,
        "live_pricebook_version": live_version,
        "pricebook_effect": effect,
        "new_version": new_menu.version,
        "item_count": len(new_menu.items),
        "prev_version": prev_version,
    }))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
