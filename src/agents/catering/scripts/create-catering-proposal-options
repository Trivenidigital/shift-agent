BRIDGE_PREFIX = "\u2695 *Catering Agent*\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n"
NO_PRICE_RE = re.compile(r"""
    \$\s*\d+
  | \b\d+(?:\.\d{1,2})?\s*(?:usd|dollars?|bucks)\b
  | \b\d+(?:\.\d{1,2})?\s*(?:/|per\s+)(?:person|plate|guest|head|pax)\b
  | \b(?:price|priced|pricing|cost|costs|rate|rates|fee|fees|charge|charges)\b
  | \b(?:deposit|payment|pay|paid|venmo|zelle|cash\s*app|cashapp|credit\s*card|invoice)\b
  | \b(?:book|booking|booked|confirmed|confirmation)\b
""", re.IGNORECASE | re.VERBOSE)

OPTION_TITLES = {
    "balanced_mixed": "Option {n}: Balanced Veg and Non-Veg Menu",
    "premium_mixed": "Option {n}: Premium Celebration Menu",
    "classic_family": "Option {n}: Classic Family Favorites",
    "custom_mix": "Your Custom Menu",  # PR-D mix-and-match recomposition
}
CATEGORY_ORDER = [
    "package",
    "appetizer",
    "soup",
    "salad",
    "main",
    "side",
    "dessert",
    "beverage",
    "special",
]
# Turn-arbitration 2026-07-26 — the meal-defining sections a credible event menu
# spans (rice/biryani/breads live under main/side in the MenuCategory schema). Used
# by both the balanced composition and the fail-closed section-balance guard.
CORE_SECTION_CATEGORIES = ("appetizer", "main", "side", "dessert")


class SectionBalanceError(ValueError):
    """Raised when a mixed veg/non-veg event would receive a degenerate proposal —
    single-diet or too few sections despite the menu offering the variety. Subclasses
    ValueError so main()'s section-balance handler catches it before the generic
    ValueError branch and fails closed (owner notified, no incoherent send)."""


def _now() -> datetime:
    return datetime.now(tz=timezone.utc)


def _proposal_validity_days() -> int:
    """M3 validity window, from config. Best-effort: an unreadable config falls back
    to the documented default rather than blocking a send that already happened."""
    try:
        from safe_io import load_yaml_model  # lazy — only the send path needs config
        from schemas import Config

        return int(load_yaml_model(CONFIG_PATH, Config).catering.proposal_validity_days)
    except Exception as e:  # noqa: BLE001 — validity must never block delivery
        sys.stderr.write(
            f"WARN: proposal_validity_days config load failed; using "
            f"{DEFAULT_PROPOSAL_VALIDITY_DAYS}d default: {type(e).__name__}: {e}\n"
        )
        return DEFAULT_PROPOSAL_VALIDITY_DAYS


def _allowed_option_count(request_text: str) -> int:
    return 3 if re.search(r"\b(three|3)\b", request_text, re.I) else 2


def _assert_no_forbidden_customer_text(text: str) -> None:
    match = NO_PRICE_RE.search(text)
    if match:
        raise ValueError(f"forbidden customer text matched: {match.group(0)!r}")


def _read_options(options_json: str) -> list[CateringProposalOption]:
    if options_json == "-":
        options_json = sys.stdin.read()
    try:
        raw = json.loads(options_json)
    except json.JSONDecodeError as e:
        raise ValueError(f"options-json not valid JSON: {e}") from e
    if not isinstance(raw, list):
        raise ValueError("options-json must be a list")
    try:
        return [CateringProposalOption.model_validate(item) for item in raw]
    except ValidationError as e:
        raise ValueError(f"options validation failed: {e}") from e


_NON_VEG_NAME_RE = re.compile(
    r"\b(?:chicken|mutton|goat|lamb|fish|shrimp|prawn|egg|beef|turkey|keema|apollo)\b",
    re.IGNORECASE,
)


def _is_non_veg(item: MenuItem) -> bool:
    tags = {str(tag).lower() for tag in item.dietary_tags}
    return "non-veg" in tags or "nonveg" in tags or bool(_NON_VEG_NAME_RE.search(item.name))


def _items_in_categories(items: list[MenuItem], categories: tuple[str, ...]) -> list[MenuItem]:
    category_set = set(categories)
    return [item for item in items if item.category in category_set]


def _append_unique(target: list[str], items: list[MenuItem], *, limit: int) -> None:
    for item in items:
        if len(target) >= limit:
            return
        if item.name not in target:
            target.append(item.name)


def _ensure_diet_balance(
    selected: list[str], menu_items: dict[str, MenuItem],
    veg_items: list[MenuItem], non_veg_items: list[MenuItem],
) -> None:
    """Guarantee BOTH a veg and a non-veg item appear when the CANDIDATE POOL offers
    both — a mixed veg/non-veg event must never receive a single-diet option. A
    veg_only lead's pool carries no non-veg items, so the non-veg append is a no-op
    there; the diet decision lives in the pool, not in this helper."""
    if non_veg_items and not any(_is_non_veg(menu_items[name]) for name in selected):
        _append_unique(selected, non_veg_items, limit=len(selected) + 1)
    if veg_items and not any(not _is_non_veg(menu_items[name]) for name in selected):
        _append_unique(selected, veg_items, limit=len(selected) + 1)


def _ensure_section_coverage(
    selected: list[str], menu_items: dict[str, MenuItem], available: list[MenuItem],
) -> None:
    """Guarantee each CORE meal section the menu actually offers is represented —
    the fix for the idli/dosa-dominated (appetizer-only) failure mode."""
    covered = {menu_items[name].category for name in selected}
    for category in CORE_SECTION_CATEGORIES:
        if category in covered:
            continue
        if any(item.category == category for item in available):
            _append_unique(selected, _items_in_categories(available, (category,)),
                           limit=len(selected) + 1)
            covered.add(category)


def _auto_option_items(
    menu_items: dict[str, MenuItem], *, style_key: str, diet_profile: str = "unknown",
) -> list[str]:
    available = list(menu_items.values())
    if not available:
        raise ValueError("menu has no available items")

    # Diet-aware candidate pool. A veg_only lead (all-vegetarian / Jain / temple
    # event) never sees a non-veg item: excluding them HERE means every downstream
    # step — style seed, diet balance, section coverage, backfill — is veg by
    # construction. non_veg_only and unknown keep the full pool: a non-veg event
    # still eats veg sides, and an unstated diet must not be guessed either way.
    if diet_profile == "veg_only":
        available = [item for item in available if not _is_non_veg(item)]
        if not available:
            raise ValueError("menu has no vegetarian items for a vegetarian-only event")

    veg_items = [item for item in available if not _is_non_veg(item)]
    non_veg_items = [item for item in available if _is_non_veg(item)]
    selected: list[str] = []

    if style_key == "balanced_mixed":
        _append_unique(
            selected,
            _items_in_categories(veg_items, ("appetizer", "main", "side", "package")),
            limit=3,
        )
        _append_unique(
            selected,
            _items_in_categories(non_veg_items, ("appetizer", "main", "package")),
            limit=5,
        )
        _append_unique(selected, _items_in_categories(veg_items, ("dessert", "beverage")), limit=6)
    elif style_key == "premium_mixed":
        _append_unique(
            selected,
            _items_in_categories(non_veg_items, ("special", "main", "appetizer", "package")),
            limit=4,
        )
        _append_unique(
            selected,
            _items_in_categories(veg_items, ("special", "main", "appetizer", "package")),
            limit=6,
        )
        _append_unique(selected, _items_in_categories(available, ("dessert",)), limit=7)
    else:
        _append_unique(selected, _items_in_categories(available, ("package", "main", "side", "dessert")), limit=6)

    # Turn-arbitration 2026-07-26 — coherence guarantees layered ON TOP of the style
    # seed so a mixed veg/non-veg event never receives a single-diet or single-section
    # menu when the menu offers the variety. Both are menu-relative (add nothing the
    # menu lacks) and additive (only extend `selected`), so small menus stay valid.
    _ensure_diet_balance(selected, menu_items, veg_items, non_veg_items)
    _ensure_section_coverage(selected, menu_items, available)

    _append_unique(selected, available, limit=8)
    return selected


def _auto_generate_options(
    menu_items: dict[str, MenuItem],
    request_text: str,
    *,
    diet_profile: str = "unknown",
) -> list[CateringProposalOption]:
    templates = [
        ("balanced_mixed", "balanced"),
        ("premium_mixed", "premium"),
        ("classic_family", "classic"),
    ]
    allowed = _allowed_option_count(request_text)
    options = []
    for idx, (style_key, tier) in enumerate(templates[:allowed], start=1):
        options.append(
            CateringProposalOption(
                option_id=str(idx),
                style_key=style_key,
                tier=tier,
                item_names=_auto_option_items(
                    menu_items, style_key=style_key, diet_profile=diet_profile),
            )
        )
    return options


_VEG_DIET_TAGS = {"veg", "vegetarian", "vegan", "jain", "pure veg", "pure-veg",
                  "veg only", "veg-only"}
_NON_VEG_DIET_TAGS = {"non-veg", "nonveg", "non-vegetarian", "halal"}

# The two free-text detectors are deliberately SYMMETRIC in strength. An earlier
# version paired an unbounded `\bveg` against a non-veg side that knew only the
# literal "non-veg", and the asymmetry silently dropped meat the customer had
# asked for: "half veg half chicken" and "We want Veg Biryani and Chicken Biryani"
# both read as veg_only, so the chicken was excluded from generation and a
# recompose of the customer's own Goat Curry was REFUSED.
#
# Vegetarian signal. Every token is bounded, so "vegetable(s)" and "veggie" — which
# describe a dish, not a dietary requirement — no longer register as one. `\bveg\b`
# still covers "pure veg", "veg only" and "veg-only" (the hyphen is a boundary).
_VEG_TEXT_RE = re.compile(
    r"\bveg\b|\bvegetarian\b|\bvegan\b|\bjain\b|\bno\s+meat\b|\bmeat[-\s]?free\b"
)
# Non-vegetarian signal: "non-veg" plus FLESH words. Deliberately no dish names —
# biryani, tikka, kebab and curry all have vegetarian versions, so matching them
# would recreate the same false-positive problem on the other side.
_FLESH_WORDS = (
    r"chicken|mutton|goat|lamb|beef|pork|turkey|duck"
    r"|fish|prawns?|shrimps?|crabs?|lobsters?"
    r"|keema|eggs?|meat"
)
_FLESH_RE = re.compile(rf"\b(?:{_FLESH_WORDS})\b")
_NON_VEG_TEXT_RE = re.compile(rf"non[\s-]?veg|\b(?:{_FLESH_WORDS})\b")
# Phrases that STATE a vegetarian requirement using a meat word. Stripped before the
# meat scan — the mirror of stripping "non-veg" before the veg scan. Without this,
# "no meat" would fire the meat detector and turn an explicitly vegetarian event
# into a mixed one.
#
# v3: this used to be three literals (no meat / meat-free / meatless) while the meat
# detector matched EVERY flesh word unconditionally. So a negated flesh word read as
# a meat signal: "all vegetarian, no chicken" came out `mixed`, and under `mixed` the
# section guard REFUSES all-veg options — i.e. it REQUIRED meat at an explicitly
# vegetarian event. That is the original P0 in its sharpest form.
#
# The negator now generalises over the SAME `_FLESH_WORDS` alternation the detector
# uses, so the two cannot drift apart. `no fish or meat` and `no dairy or eggs` are
# both handled: the list may start with a non-flesh word, and only the flesh words
# inside the negated run are removed.
#
# The list is joined by `or` ONLY, deliberately not by commas. "no rush, chicken is
# fine" would otherwise read the comma as list continuation and strip a chicken the
# customer actually wants.
_NEGATED_FLESH_RE = re.compile(
    r"\b(?:absolutely\s+no|no|without|free\s+of)\s+"      # longest negator first
    r"(?:any\s+)?"
    r"(?:\w+(?:\s+or\s+(?:no\s+)?(?:any\s+)?\w+)*)"
)
_VEG_NEGATION_RE = re.compile(r"\bmeat[-\s]?free\b|\bmeatless\b")


def _negated_flesh_spans(blob: str) -> list[str]:
    """The negated runs that actually name a flesh word, e.g. "no fish or meat".

    A run that names none ("no rush", "no dairy") is not a dietary statement and is
    left completely alone."""
    return [m.group(0) for m in _NEGATED_FLESH_RE.finditer(blob)
            if _FLESH_RE.search(m.group(0))]


def _lead_diet_profile(lead) -> str:
    """Classify the lead's guest diet as "mixed" / "veg_only" / "non_veg_only" /
    "unknown". Reads extracted.dietary_restrictions first, then falls back to scanning
    raw_inquiry + notes. Deterministic; the "veg" inside "non-veg" is stripped before
    the veg scan so a non-veg-only lead is not mis-read as vegetarian.

    "mixed" whenever BOTH signals come from the tags, or BOTH from the text — a menu
    serving both diets is the safe outcome when the lead mentions both. A veg signal
    from one source and a non-veg signal from the other stays "unknown": too weak to
    act on, and "unknown" is the branch that changes nothing.

    Limitation: vegan and Jain both fold into "veg_only" because MenuItem carries no
    vegan/Jain flag — the pool can only be filtered down to vegetarian, so a vegan or
    Jain lead still needs owner review before send."""
    tags = {str(tag).lower() for tag in (lead.extracted.dietary_restrictions or [])}
    tag_veg = bool(tags & _VEG_DIET_TAGS)
    tag_non_veg = bool(tags & _NON_VEG_DIET_TAGS)
    if tag_veg and tag_non_veg:
        return "mixed"
    blob = f"{lead.raw_inquiry} {getattr(lead.extracted, 'notes', '') or ''}".lower()
    # Each side scans a blob with the OTHER side's overlapping phrases removed, so
    # neither detector can be tricked by the other's vocabulary: "non-veg" is not a
    # veg mention, and "no meat" is not a meat mention.
    veg_scan = re.sub(r"non[\s-]?veg\w*", " ", blob)
    # A negated flesh phrase is BOTH: a vegetarian requirement (so "no eggs please"
    # is veg_only with no vegetarian word present anywhere) and a non-signal for the
    # meat scan. Only the flesh words INSIDE the negated run are removed, so
    # "no chicken but lamb is fine" keeps its lamb and stays mixed — the negation
    # must strip exactly what it negates and nothing further.
    negated = _negated_flesh_spans(blob)
    non_veg_scan = blob
    for span in negated:
        non_veg_scan = non_veg_scan.replace(span, _FLESH_RE.sub(" ", span), 1)
    non_veg_scan = _VEG_NEGATION_RE.sub(" ", non_veg_scan)
    text_veg = bool(_VEG_TEXT_RE.search(veg_scan)) or bool(negated)
    text_non_veg = bool(_NON_VEG_TEXT_RE.search(non_veg_scan))
    if text_veg and text_non_veg:
        return "mixed"
    has_veg = tag_veg or text_veg
    has_non_veg = tag_non_veg or text_non_veg
    if has_veg and not has_non_veg:
        return "veg_only"
    if has_non_veg and not has_veg:
        return "non_veg_only"
    return "unknown"


def _assert_no_non_veg_items(
    item_names: list[str], menu_items: dict[str, MenuItem], *, label: str,
) -> None:
    """The vegetarian-only invariant, in one place: a veg_only lead never receives a
    non-veg item from this script. Shared by the proposal guard and the recompose
    chokepoint so both send paths enforce the SAME rule."""
    non_veg = [name for name in item_names
               if name in menu_items and _is_non_veg(menu_items[name])]
    if non_veg:
        raise SectionBalanceError(
            f"{label} contains non-veg items {non_veg} for a vegetarian-only event")


def _assert_section_coverage(
    options: list[CateringProposalOption], menu_items: dict[str, MenuItem],
    *, diet_profile: str,
) -> None:
    """Every option must be a coherent MENU, not a plate of sweets.

    Without this a veg_only lead could be sent a dessert-only "menu": the pool
    filter guarantees nothing non-veg reaches them, which says nothing about
    whether what DOES reach them is a meal.

    Two menu-relative bounds, deliberately relative to DIFFERENT pools:

    * section count — against the pool this lead can actually be served (veg items
      only, for veg_only). A small all-vegetarian menu must not be rejected for
      lacking variety it never offered.
    * has-a-main — against the FULL menu. If the menu offers mains but every one of
      them is non-veg, we cannot build a vegetarian main course, and that is exactly
      when the owner needs to hear about it. Sending a side-and-dessert spread to a
      temple event instead is the worse failure, so this fails closed.
    """
    servable = ({name: item for name, item in menu_items.items()
                 if not _is_non_veg(item)}
                if diet_profile == "veg_only" else menu_items)
    servable_categories = {item.category for item in servable.values()}
    full_menu_categories = {item.category for item in menu_items.values()}
    required_sections = min(3, len(servable_categories))
    for option in options:
        items = [menu_items[name] for name in option.item_names if name in menu_items]
        opt_categories = {item.category for item in items}
        if len(opt_categories) < required_sections:
            raise SectionBalanceError(
                f"option {option.option_id} spans {sorted(opt_categories)}; a "
                f"{diet_profile} event needs >= {required_sections} sections")
        if "main" in full_menu_categories and "main" not in opt_categories:
            raise SectionBalanceError(
                f"option {option.option_id} has no main course"
                + ("" if diet_profile != "veg_only" or "main" in servable_categories
                   else " (the menu's only mains are non-veg, so no vegetarian main "
                        "course can be offered for this event)"))


def _assert_section_balance(
    options: list[CateringProposalOption], menu_items: dict[str, MenuItem],
    *, diet_profile: str,
) -> None:
    """Fail-closed menu-quality guard (turn-arbitration 2026-07-26). Raises
    SectionBalanceError (→ fail_generation, no send) rather than deliver a proposal
    that contradicts the lead.

    - veg_only: NO option may contain a non-veg item, AND the option must still be a
      coherent menu — the same section/main coverage a mixed event gets. Applies to
      owner-supplied --options-json too, which the pool filter cannot reach.
    - mixed: an option must not be degenerate — single-diet, or spanning too few
      sections, or missing a main course — WHEN the menu itself offers the variety.
      The check is menu-relative so a genuinely small menu is not rejected.
    - non_veg_only / unknown: no-op; both diets remain legitimate."""
    if diet_profile == "veg_only":
        for option in options:
            _assert_no_non_veg_items(option.item_names, menu_items,
                                     label=f"option {option.option_id}")
        _assert_section_coverage(options, menu_items, diet_profile="veg_only")
        return
    if diet_profile != "mixed":
        return
    menu_has_veg = any(not _is_non_veg(item) for item in menu_items.values())
    menu_has_non_veg = any(_is_non_veg(item) for item in menu_items.values())
    for option in options:
        items = [menu_items[name] for name in option.item_names if name in menu_items]
        opt_has_veg = any(not _is_non_veg(item) for item in items)
        opt_has_non_veg = any(_is_non_veg(item) for item in items)
        if menu_has_veg and menu_has_non_veg and not (opt_has_veg and opt_has_non_veg):
            raise SectionBalanceError(
                f"option {option.option_id} is single-diet "
                f"(veg={opt_has_veg} non_veg={opt_has_non_veg}) for a mixed event")
    # Shared with the veg_only branch, so the two diets cannot drift apart on what
    # counts as a complete menu. For mixed, `servable` is the whole menu, which is
    # what the original inline check used.
    _assert_section_coverage(options, menu_items, diet_profile="mixed")


def _load_lead(lead_id: str):
    with FileLock(LEADS_LOCK):
        store, status = load_model(LEADS_PATH, CateringLeadStore, default=CateringLeadStore())
        assert_load_status_clean(LEADS_PATH, status, context="proposal-options lead load")
        return next((lead for lead in store.leads if lead.lead_id == lead_id), None)


def _load_menu_items() -> dict[str, MenuItem]:
    menu, status = load_model(MENU_PATH, Menu)
    assert_load_status_clean(MENU_PATH, status, context="proposal-options menu load")
    return {item.name: item for item in menu.items if item.available}


def _render_option(option: CateringProposalOption, menu_items: dict[str, MenuItem], n: int) -> str:
    by_category: dict[str, list[str]] = {}
    for name in option.item_names:
        item = menu_items.get(name)
        if item is None:
            raise KeyError(name)
        by_category.setdefault(item.category, []).append(item.name)

    title_template = OPTION_TITLES.get(option.style_key, "Option {n}: Catering Menu Option")
    lines = [f"*{title_template.format(n=n)}*"]
    for category in CATEGORY_ORDER:
        names = by_category.get(category)
        if not names:
            continue
        label = category.replace("_", " ").title()
        lines.append(f"{label}:")
        lines.extend(f"- {name}" for name in names)
    return "\n".join(lines)


def _render_body(options: list[CateringProposalOption], menu_items: dict[str, MenuItem]) -> str:
    rendered = [_render_option(option, menu_items, i) for i, option in enumerate(options, start=1)]
    body = BRIDGE_PREFIX + "\n\n".join(rendered)
    _assert_no_forbidden_customer_text(body)
    return body


# PR-4 (charter §4.3/§4.2): outbound audit identity for the current invocation.
# Set once in main()/_run_recompose from CLI args; read by the audit emitters so
# every *_sent / *_failed row for this turn carries one logical_turn_id + a
# per-send send_attempt_id (an internal retry reuses it; a re-invocation mints a
# new one). A mutable dict avoids the `global` statement and is per-invocation
# safe (tests load this script as a fresh module).
_RUN_IDENTITY = {"logical_turn_id": "", "send_attempt_id": "", "transport_destination": ""}


def _set_run_identity(*, logical_turn_id: str, send_attempt_id: str, transport_destination: str) -> None:
    _RUN_IDENTITY["logical_turn_id"] = logical_turn_id
    _RUN_IDENTITY["send_attempt_id"] = send_attempt_id
    _RUN_IDENTITY["transport_destination"] = transport_destination


def _append_audit(entry) -> None:
    adapter = TypeAdapter(type(entry))
    with FileLock(LOG_LOCK):
        ndjson_append(LOG_PATH, adapter.dump_json(entry).decode("utf-8"))


def _audit_failure(lead_id: str, reason: str, detail: str = "", proposal_set_id: str = "") -> None:
    _append_audit(
        CateringProposalGenerationFailed(
            type="catering_proposal_generation_failed",
            ts=_now(),
            lead_id=lead_id,
            proposal_set_id=proposal_set_id,
            reason=reason,
            detail=detail[:2000],
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
            transport_destination=_RUN_IDENTITY["transport_destination"],
            outcome=reason,
        )
    )


def _uncertain_page(lead_id: str, proposal_set_id: str, detail: str) -> tuple[str, str]:
    """(title, message) for a send the bridge ACCEPTED but never acknowledged.

    The failure copy was wrong twice over here — generation succeeded and the
    bridge was reached — and, worse, it named no action, leaving an owner alarmed
    with nothing to do. This says what happened and what actually works. The
    resolution it names is real: reissuing mints a new set, which retires this one
    through the SEND_UNCERTAIN -> SUPERSEDED edge.

    ASCII only, and no new punctuation the notifier might render as markup: the
    body already carries `lead_id=` / `proposal_set_id=` underscores, and a page
    the owner cannot read is the same as no page.
    """
    return (
        "Catering options sent - delivery unconfirmed",
        f"lead_id={lead_id} proposal_set_id={proposal_set_id or '(none)'}: the menu "
        f"options were composed and the bridge ACCEPTED them, so the customer most "
        f"likely HAS them. This is not a failure and nothing was re-sent - what is "
        f"missing is only the delivery receipt. If the customer does not reply, "
        f"reissuing the options is the supported fix, and doing so also retires "
        f"this set. Bridge evidence: {detail[:500]}"
    )


def _notify_owner_generation_failed(
    lead_id: str,
    reason: str,
    detail: str = "",
    proposal_set_id: str = "",
    *,
    send_status: str = "",
) -> bool:
    """Returns whether the page actually landed. shift-agent-notify-owner exits
    non-zero when every channel failed, so the returncode is the only evidence the
    owner was reached — discarding it is what let the audit row claim a page that
    never happened."""
    if send_status == "send_uncertain":
        title, message = _uncertain_page(lead_id, proposal_set_id, detail)
    else:
        title = "Catering proposal generation failed"
        message = (
            f"lead_id={lead_id} proposal_set_id={proposal_set_id or '(none)'} "
            f"proposal generation failed: {reason}. {detail[:500]}"
        )
    try:
        proc = subprocess.run(
            [
                str(NOTIFY_OWNER_BIN),
                "--priority",
                "2",
                "--title",
                title,
                message,
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception as e:  # noqa: BLE001 - alerting is best-effort
        sys.stderr.write(f"WARN: shift-agent-notify-owner failed (non-fatal): {type(e).__name__}: {e}\n")
        return False
    if proc.returncode != 0:
        sys.stderr.write(f"WARN: shift-agent-notify-owner exit {proc.returncode} "
                         f"(non-fatal) lead={lead_id} reason={reason}\n")
    return proc.returncode == 0


def _fail_generation(
    lead_id: str,
    reason: str,
    detail: str = "",
    proposal_set_id: str = "",
    *,
    send: tuple[str, str] | None = None,
) -> bool:
    """The single failure record: audit row, ONE page, and — when the failure was a
    send (`send=(jid, send_status)`) — the customer_send_unconfirmed row carrying
    the page's real outcome.

    The unconfirmed row lives here rather than in `_post` because `_post` returns
    BEFORE the page is attempted: a row written there could only ever guess at
    `owner_paged`, and it guessed True. Writing it after the page is what makes the
    field evidence instead of decoration. Returns whether the owner was reached.

    AN UNCERTAIN SEND EMITS NO FAILURE ROW. `CateringProposalGenerationFailed`
    asserts two things that are both false when the bridge returned 2xx: that
    generation failed (the menu composed fine) and, via its `reason`/`outcome`
    fields, that the bridge was unreachable (it answered). Widening that Literal is
    NOT the alternative — dc7a81a2 knows this tag, so a new value makes the old
    reader REJECT a row it accepts today instead of degrading it to
    `_UnknownLogEntry`; new tags are free, new values in a known tag are not. No
    new tag is needed either, because the truthful row already exists on this path:
    `_record_send_unconfirmed` writes `catering_customer_send_unconfirmed` with the
    real `send_status` and `delivery_certainty`. So the false row is dropped, the
    true one is kept, and the page still fires exactly once.

    Suppression lives HERE rather than at the three call sites so every send arm
    this script has behaves the same way."""
    jid, send_status = send if send is not None else ("", "")
    if send_status != "send_uncertain":
        _audit_failure(lead_id, reason, detail, proposal_set_id)
    paged = _notify_owner_generation_failed(lead_id, reason, detail, proposal_set_id,
                                            send_status=send_status)
    if send is not None:
        _record_send_unconfirmed(jid, lead_id=lead_id, send_status=send_status,
                                 detail=detail, paged=paged)
    return paged


def _delivery_certainty(send_status: str) -> str:
    """'uncertain' only for safe_io's `send_uncertain` (bridge accepted, ack body
    unparseable → most likely delivered). Every other non-sent status — transport
    faults AND the policy drops ('refused', 'throttled', 'suppressed', 'disabled')
    — means nothing was received."""
    return "uncertain" if send_status == "send_uncertain" else "failed"


def _record_send_unconfirmed(jid: str, *, lead_id: str, send_status: str,
                             detail: str, paged: bool) -> None:
    """The truthful record of a send that did not confirm.

    What was missing was never the alert — it was the STATUS. The pre-existing
    failure row hardcodes reason="bridge_unreachable" (a schema Literal, so it
    cannot carry the real value without a schemas.py change), which reports a
    `send_uncertain` — the bridge ACCEPTED the menu and it most likely arrived —
    as a definite non-delivery. This row carries what actually happened, including
    whether the page that was supposed to surface it reached anyone."""
    try:
        _append_audit(CateringCustomerSendUnconfirmed(
            type="catering_customer_send_unconfirmed", ts=_now(),
            lead_id=lead_id, script="create-catering-proposal-options",
            send_kind="proposal_options", send_status=send_status,
            delivery_certainty=_delivery_certainty(send_status),
            detail=str(detail)[:2000], owner_paged=paged,
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
            transport_destination=jid, outcome=send_status,
        ))
    except Exception as e:  # noqa: BLE001 — audit is best-effort
        sys.stderr.write(f"audit emit (customer_send_unconfirmed) failed "
                         f"(non-fatal): {type(e).__name__}: {e}\n")


def _post(jid: str, text: str, *, lead_id: str) -> tuple[bool, str, str]:
    """(ok, message_id_or_error, status) over the canonical 4-tuple chokepoint.

    Per-script paging decision — this script does NOT add a page, and that is
    deliberate rather than an omission. Every one of its three send sites already
    calls `_fail_generation`, which pages the owner through
    `_notify_owner_generation_failed`. A second page for the same event would be
    noise, and the surest way to teach an owner to ignore the channel is to alert
    twice for one failure.

    For the same reason the unconfirmed row is emitted by `_fail_generation` and
    not here: this function returns before the page is attempted, so it cannot
    know what to put in `owner_paged`. Each failed send site passes
    `send=(jid, status)` to `_fail_generation`, which pages first and then records
    the real result.
    """
    ok4, mid, err, status = _bridge_post_4tuple(jid, text)
    if ok4:
        return True, mid, status
    return False, err or status, status


def _create_draft(
    *,
    lead_id: str,
    source_message_id: str,
    request_text: str,
    options: list[CateringProposalOption],
) -> str:
    with FileLock(PROPOSALS_LOCK):
        store, status = load_model(
            PROPOSALS_PATH,
            CateringProposalStore,
            default=CateringProposalStore(),
        )
        assert_load_status_clean(PROPOSALS_PATH, status, context="proposal-options draft load")
        proposal_set_id = f"CPS-{lead_id}-{store.next_sequence:06d}"
        store.next_sequence += 1
        store.sets.append(
            CateringProposalSet(
                proposal_set_id=proposal_set_id,
                lead_id=lead_id,
                status="DRAFT",
                created_at=_now(),
                source_message_id=source_message_id,
                request_text=request_text[:1000],
                options=options,
            )
        )
        atomic_write_json(PROPOSALS_PATH, store)
        return proposal_set_id


# M3 — proposal-set state machine enforcement. Every status write in this script
# goes through _transition_ok first; an illegal move is REFUSED (the row is left
# completely untouched) and recorded, never silently written. Refusals are
# collected inside the PROPOSALS_LOCK and emitted by _emit_transition_refusals
# AFTER it is released, so the deployed single-lock discipline of this script is
# unchanged (no new PROPOSALS_LOCK -> LOG_LOCK nesting).
def _transition_ok(row, to_status: str, write_site: str, sink: list[dict]) -> bool:
    if is_proposal_set_transition_allowed(row.status, to_status):
        return True
    sink.append({
        "lead_id": row.lead_id, "proposal_set_id": row.proposal_set_id,
        "from_status": row.status, "to_status": to_status, "write_site": write_site,
    })
    return False


def _emit_transition_refusals(refusals: list[dict]) -> None:
    for r in refusals:
        sys.stderr.write(
            f"proposal_transition_refused set={r['proposal_set_id']} "
            f"{r['from_status']}->{r['to_status']} site={r['write_site']}\n"
        )
        try:
            _append_audit(CateringProposalTransitionRefused(
                type="catering_proposal_transition_refused", ts=_now(), **r))
        except Exception as e:  # noqa: BLE001 — audit is best-effort
            sys.stderr.write(
                f"WARN: transition-refusal audit emit failed (non-fatal): "
                f"{type(e).__name__}: {e}\n")


def _unconfirmed_set_status(send_status: str) -> str:
    """The proposal-set status for a send that did not confirm. Mirrors
    `_delivery_certainty` one layer down: `send_uncertain` is the ONLY status that
    is not a definite non-delivery, so it is the only one that must not be written
    as SEND_FAILED."""
    return "SEND_UNCERTAIN" if send_status == "send_uncertain" else "SEND_FAILED"


def _mark_send_outcome(proposal_set_id: str, reason: str, send_status: str) -> list[dict]:
    """Record what the send actually did.

    This used to write SEND_FAILED unconditionally, discarding the status the
    chokepoint returned — so a `send_uncertain` (bridge accepted the menu; it most
    likely ARRIVED) was recorded as definite non-delivery, contradicting the
    catering_customer_send_unconfirmed row written beside it by the same run.

    `reason` is untouched by the split: on the uncertain path it already carries the
    bridge's own ack body (`ack_parse_failed: ...` / `empty_message_id: ...`), which
    is the evidence an operator resolves the row with. `outbound_message_id` is
    cleared on BOTH paths and that is not a loss — the bridge returned no id in
    either uncertain sub-case, so there has never been one to keep."""
    to_status = _unconfirmed_set_status(send_status)
    refusals: list[dict] = []
    with FileLock(PROPOSALS_LOCK):
        store, status = load_model(PROPOSALS_PATH, CateringProposalStore, default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, status, context="proposal-options fail load")
        target = next(row for row in store.sets if row.proposal_set_id == proposal_set_id)
        if not _transition_ok(target, to_status, "mark_send_outcome", refusals):
            return refusals
        target.status = to_status
        target.failure_reason = reason[:200]
        target.outbound_message_id = ""
        atomic_write_json(PROPOSALS_PATH, store)
    return refusals


def _proposal_sequence(proposal_set_id: str) -> int:
    match = re.search(r"-(\d{6})$", proposal_set_id)
    return int(match.group(1)) if match else -1


def _mark_sent_and_supersede(
    lead_id: str, proposal_set_id: str, outbound_message_id: str,
) -> list[dict]:
    sent_at = _now()
    validity_days = _proposal_validity_days()
    refusals: list[dict] = []
    with FileLock(PROPOSALS_LOCK):
        store, status = load_model(PROPOSALS_PATH, CateringProposalStore, default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, status, context="proposal-options sent load")
        target = next(row for row in store.sets if row.proposal_set_id == proposal_set_id)
        target_sequence = _proposal_sequence(target.proposal_set_id)
        has_later_sent = any(
            row.lead_id == lead_id
            and row.status == "SENT"
            and _proposal_sequence(row.proposal_set_id) > target_sequence
            for row in store.sets
        )
        for row in store.sets:
            if (
                row.lead_id == lead_id
                # P1: SEND_UNCERTAIN is retired here too. Its menu most likely
                # REACHED the customer, so a newer set genuinely supersedes it in
                # their hands — and without this the SEND_UNCERTAIN -> SUPERSEDED
                # edge would be one nothing ever takes, i.e. a resolution the
                # state machine advertises and no writer performs.
                # NOT symmetric with SEND_FAILED, deliberately: a definitely-failed
                # set was never in the customer's hands, so there is nothing for a
                # later set to supersede, and it stays terminal.
                and row.status in ("SENT", "SEND_UNCERTAIN")
                and row.proposal_set_id != proposal_set_id
                and _proposal_sequence(row.proposal_set_id) < target_sequence
            ):
                if _transition_ok(row, "SUPERSEDED", "supersede_older_sent", refusals):
                    row.status = "SUPERSEDED"
        to_status = "SUPERSEDED" if has_later_sent else "SENT"
        if not _transition_ok(target, to_status, "mark_sent", refusals):
            # Refuse the whole write rather than record half of it: a row carrying
            # sent_at + outbound_message_id but a status that never advanced is
            # exactly the state-vs-outbound divergence this guard exists to surface.
            # The customer DID receive the set (the bridge POST already returned) —
            # the refusal row is what makes the mismatch visible to an operator.
            return refusals
        target.status = to_status
        target.sent_at = sent_at
        # M3: a SENT set carries the same validity window the customer was told.
        # A SUPERSEDED one does not — it is already dead, and stamping an expiry on
        # it would invite the sweep to "expire" something no longer selectable.
        if to_status == "SENT":
            target.expires_at = _expires_at(sent_at, validity_days)
        target.outbound_message_id = outbound_message_id
        target.failure_reason = ""
        atomic_write_json(PROPOSALS_PATH, store)
    return refusals


# ── M3: owner-side "initial_draft" quote-ledger provenance ───────────────────
# `initial_draft` has been a declared CateringQuoteLedgerRecord.source since PR-B
# and was never written by anything, so the very first priced artefact for a lead
# was whatever the customer finalized — with no record of what the options were
# worth when they were offered. This commits that baseline.
#
# STRICTLY OWNER-SIDE. The customer-facing proposal stays price-free: the
# creative_catering_proposals contract forbids prices before owner approval, and
# _assert_no_forbidden_customer_text enforces it on the body. Nothing here touches
# the body — the numbers only ever reach the ledger.
#
# Runs only when the customer HAS a pricebook and the lead HAS a headcount; without
# either, a number would be a guess, and the never-guess rule beats provenance.
def _ledger_already_has_draft(lead_id: str, proposal_set_id: str) -> bool:
    """Idempotency: one initial_draft per proposal SET.

    Dedup is on the proposal_set_id parked in `source_message_id` — the ledger's own
    duplicate refusal is on (lead_id, version), which cannot see a re-run because a
    re-run would simply take the next version number. `source_message_id` is the
    right home: for this source the causing artefact IS the proposal set."""
    try:
        import catering_quote_ledger as _ql
        return any(
            r.get("source") == "initial_draft"
            and r.get("source_message_id") == proposal_set_id
            for r in _ql.history(lead_id, data_path=LEDGER_PATH)
        )
    except Exception:  # noqa: BLE001 — a read failure must not block the append
        return False


def _indicative_quotes(lead, options: list[CateringProposalOption]) -> tuple[list, object]:
    """(per-option (option, QuoteComputation) pairs, menu) — or ([], None).

    Every option is priced through the SAME M2 kernel the owner card and finalize
    use, so the owner-side baseline and the eventual quote come from one arithmetic.
    """
    try:
        import catering_pricing as _pricing
        from schemas import Menu as _Menu

        guest_count = getattr(getattr(lead, "extracted", None), "headcount", None)
        if not isinstance(guest_count, int) or guest_count < 1:
            return [], None
        pricebook = _pricing.load_pricebook(PRICEBOOK_PATH)
        if pricebook is None:
            return [], None
        menu, status = load_model(MENU_PATH, _Menu)
        assert_load_status_clean(MENU_PATH, status, context="initial-draft menu load")
        priced = []
        for option in options:
            qc = _pricing.compute_quote(
                guest_count, None, [(name, 1) for name in option.item_names],
                None, pricebook, menu,
            )
            priced.append((option, qc))
        return priced, menu
    except Exception as e:  # noqa: BLE001 — provenance is never worth a failed send
        sys.stderr.write(
            f"WARN: indicative pricing skipped (non-fatal): {type(e).__name__}: {e}\n")
        return [], None


def _append_initial_draft_ledger_best_effort(lead, proposal_set_id: str,
                                             options: list[CateringProposalOption]) -> None:
    """Commit ONE owner-side ledger version for the set. Called AFTER the proposal
    store write and its lock have been released, so the ledger's lock is held alone
    (leaf-lock contract).

    Best-effort BY STRUCTURE, not by the good manners of its helpers: the whole body
    is inside one handler, so a raise anywhere — the dedup read, the pricing, the
    append — is swallowed. The customer already has the options by the time this
    runs, and a provenance failure must never surface as a send failure."""
    try:
        if _ledger_already_has_draft(lead.lead_id, proposal_set_id):
            return
        priced, menu = _indicative_quotes(lead, options)
        if not priced:
            return

        import catering_pricing as _pricing
        import catering_quote_ledger as _ql

        # Option 1 is the recorded baseline (it is the first, lowest-tier option
        # `_auto_generate_options` emits). Every option's indicative total is kept
        # in quote_text so the per-option arithmetic is not thrown away — that text
        # is owner-side provenance and is NEVER sent to anyone.
        baseline_option, baseline_qc = priced[0]
        lines = [
            f"Indicative owner-side draft for {proposal_set_id} "
            f"({len(priced)} option(s), {baseline_qc.guest_count} guests). NOT SENT.",
        ]
        for option, qc in priced:
            lines.append(
                f"Option {option.option_id} ({option.tier}): "
                f"{_pricing.format_cents(qc.total_cents)} — "
                f"{_pricing.price_status_line(qc.price_status)}"
            )
        selected_items = [
            {"name": ln.name, "qty": ln.qty,
             "price_usd": _pricing.cents_to_whole_dollars(ln.unit_cents or 0)}
            for ln in baseline_qc.lines
        ]
        res = _ql.append_version(
            lead_id=lead.lead_id,
            quote_text="\n".join(lines),
            quote_total_usd=_pricing.cents_to_whole_dollars(baseline_qc.total_cents),
            selected_items=selected_items,
            source="initial_draft",
            source_message_id=proposal_set_id,
            approval_code=lead.owner_approval_code,
            created_at=_now(),
            menu_version=(menu.version if menu is not None else None),
            pricebook_version=baseline_qc.pricebook_version,
            price_status=baseline_qc.price_status,
            data_path=LEDGER_PATH,
        )
        if not res.ok:
            sys.stderr.write(
                f"WARN: initial_draft ledger append failed (non-fatal) for "
                f"{lead.lead_id} set={proposal_set_id}: {res.reason}\n")
    except Exception as e:  # noqa: BLE001 — ledger is a best-effort sidecar
        sys.stderr.write(
            f"WARN: initial_draft ledger append raised (non-fatal) for "
            f"{getattr(lead, 'lead_id', '?')}: {type(e).__name__}: {e}\n")


def _load_latest_sent_set(lead_id: str) -> dict | None:
    """Most-recent SENT proposal set for the lead (raw dict), or None."""
    try:
        with PROPOSALS_PATH.open(encoding="utf-8") as f:
            store = json.load(f)
    except Exception:
        return None
    sent = [s for s in store.get("sets", [])
            if isinstance(s, dict) and s.get("lead_id") == lead_id and s.get("status") == "SENT"]
    if not sent:
        return None
    sent.sort(key=lambda s: _proposal_sequence(str(s.get("proposal_set_id", ""))))
    return sent[-1]


def _render_recomposed(item_names: list[str], menu_items: dict[str, MenuItem],
                       combination: str) -> tuple[str, set[str]]:
    """Render the deterministic combined menu. Reuses the catalog-exact discipline
    (KeyError on unknown item) + the NO_PRICE_RE guard. Returns (body, category set)."""
    # Validate item shape via the same option model used everywhere else.
    CateringProposalOption(option_id="1", style_key="custom_mix", tier="balanced",
                           item_names=item_names)
    by_category: dict[str, list[str]] = {}
    for name in item_names:
        item = menu_items.get(name)
        if item is None:
            raise KeyError(name)
        by_category.setdefault(item.category, []).append(item.name)
    title = OPTION_TITLES["custom_mix"]
    lines = [f"*{title} ({combination})*"] if combination else [f"*{title}*"]
    for category in CATEGORY_ORDER:
        names = by_category.get(category)
        if not names:
            continue
        lines.append(f"{category.replace('_', ' ').title()}:")
        lines.extend(f"- {name}" for name in names)
    body = BRIDGE_PREFIX + "\n".join(lines)
    _assert_no_forbidden_customer_text(body)
    return body, set(by_category.keys())


def _run_recompose(args) -> int:
    """PR-D mix-and-match: deterministically combine sections of already-SENT
    options. The payload is pulled verbatim from the sent options (never composed
    by an LLM), and a diet check plus a sections-match assertion run in this
    chokepoint before send so prose-matches-payload is TESTED per send. Any imperfect
    request clarifies."""
    _set_run_identity(
        logical_turn_id=(args.logical_turn_id or args.source_message_id),
        send_attempt_id=uuid.uuid4().hex,
        transport_destination=args.customer_jid,
    )
    try:
        lead = _load_lead(args.lead_id)
    except Exception as e:
        sys.stderr.write(f"lead load failed: {e}\n")
        return EXIT_NOT_FOUND
    if lead is None:
        _fail_generation(args.lead_id, "lead_not_found", "lead not found")
        sys.stderr.write(f"lead {args.lead_id} not found\n")
        return EXIT_NOT_FOUND
    try:
        menu_items = _load_menu_items()
    except Exception as e:
        _fail_generation(args.lead_id, "menu_missing", str(e))
        sys.stderr.write(f"menu load failed: {e}\n")
        return EXIT_NOT_FOUND

    menu_by_name = {name: item.category for name, item in menu_items.items()}
    plan = recompose_plan(args.request_text, _load_latest_sent_set(args.lead_id), menu_by_name)

    if plan["kind"] == "clarify":
        ok, mid_or_err, _status = _post(
            args.customer_jid, BRIDGE_PREFIX + plan["message"], lead_id=args.lead_id)
        if not ok:
            _fail_generation(args.lead_id, "bridge_unreachable", mid_or_err,
                             send=(args.customer_jid, _status))
            print(json.dumps({"mode": "clarify", "sent": False}))
            return EXIT_DEPENDENCY_DOWN
        _append_audit(CateringRecomposeClarifySent(
            type="catering_recompose_clarify_sent", ts=_now(), lead_id=args.lead_id,
            reason=plan["reason"], outbound_message_id=mid_or_err,
            detail=plan["message"][:2000],
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
            transport_destination=_RUN_IDENTITY["transport_destination"],
            outcome="sent"))
        print(json.dumps({"mode": "clarify", "reason": plan["reason"], "sent": True}))
        return EXIT_OK

    # kind == merge
    # Diet chokepoint, BEFORE the body is built. Recompose pulls items VERBATIM from
    # options that may pre-date the lead's stated diet (a customer who says "make it
    # all vegetarian" after the first send, or a set generated before this guard
    # existed), so the generation-side pool filter cannot cover this path. Fail
    # closed rather than filter: the recompose contract is verbatim-or-clarify, and
    # silently dropping the non-veg half of a section the customer explicitly named
    # would either substitute a dish behind their back or trip the sections-match
    # assertion below under a misleading reason. A refusal the owner sees is better.
    if _lead_diet_profile(lead) == "veg_only":
        try:
            _assert_no_non_veg_items(plan["item_names"], menu_items, label="recomposed menu")
        except SectionBalanceError as e:
            _fail_generation(args.lead_id, "insufficient_section_balance", str(e))
            sys.stderr.write(f"insufficient_section_balance: {e}\n")
            return EXIT_INVALID_INPUT

    try:
        body, rendered_cats = _render_recomposed(plan["item_names"], menu_items, plan["combination"])
    except KeyError as e:
        _fail_generation(args.lead_id, "unknown_menu_item", str(e))
        sys.stderr.write(f"unknown menu item: {e}\n")
        return EXIT_INVALID_INPUT
    except ValueError as e:
        _fail_generation(args.lead_id, "forbidden_customer_text", str(e))
        sys.stderr.write(f"forbidden_customer_text: {e}\n")
        return EXIT_INVALID_INPUT

    # Sections-match chokepoint (condition 2): the rendered combined menu must
    # contain EXACTLY the requested sections — no more, no fewer. Fail closed.
    if rendered_cats != set(plan["sections"]):
        detail = f"requested={sorted(plan['sections'])} rendered={sorted(rendered_cats)}"
        _fail_generation(args.lead_id, "recompose_sections_mismatch", detail)
        sys.stderr.write(f"recompose_sections_mismatch: {detail}\n")
        return EXIT_INVALID_INPUT

    ok, mid_or_err, _status = _post(args.customer_jid, body, lead_id=args.lead_id)
    if not ok:
        _fail_generation(args.lead_id, "bridge_unreachable", mid_or_err,
                         send=(args.customer_jid, _status))
        print(json.dumps({"mode": "recomposed", "sent": False}))
        return EXIT_DEPENDENCY_DOWN
    _append_audit(CateringRecomposedMenuSent(
        type="catering_recomposed_menu_sent", ts=_now(), lead_id=args.lead_id,
        combination=plan["combination"][:200], section_count=len(plan["sections"]),
        item_count=len(plan["item_names"]), outbound_message_id=mid_or_err,
        logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
        send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
        transport_destination=_RUN_IDENTITY["transport_destination"],
        outcome="sent"))
    print(json.dumps({"mode": "recomposed", "combination": plan["combination"],
                      "sent": True, "outbound_message_id": mid_or_err}))
    return EXIT_OK


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lead-id", required=True)
    parser.add_argument("--customer-jid", required=True)
    parser.add_argument("--source-message-id", required=True)
    # PR-4: logical_turn_id = the inbound native message id (charter §4.2). Defaults
    # to --source-message-id when the caller omits it, so nothing breaks.
    parser.add_argument("--logical-turn-id", default="")
    parser.add_argument("--request-text", required=True)
    parser.add_argument("--options-json")
    parser.add_argument("--auto-generate-from-menu", action="store_true")
    parser.add_argument("--recompose-from-sent", action="store_true",
                        help="PR-D mix-and-match: deterministically combine sections of "
                             "already-SENT options named in --request-text (clarify if imperfect)")
    args = parser.parse_args()

    if args.recompose_from_sent:
        return _run_recompose(args)

    # PR-4: one logical_turn_id for the turn + one send_attempt_id for this send.
    _set_run_identity(
        logical_turn_id=(args.logical_turn_id or args.source_message_id),
        send_attempt_id=uuid.uuid4().hex,
        transport_destination=args.customer_jid,
    )

    try:
        lead = _load_lead(args.lead_id)
    except Exception as e:
        sys.stderr.write(f"lead load failed: {e}\n")
        return EXIT_NOT_FOUND
    if lead is None:
        _fail_generation(args.lead_id, "lead_not_found", "lead not found")
        sys.stderr.write(f"lead {args.lead_id} not found\n")
        return EXIT_NOT_FOUND

    try:
        menu_items = _load_menu_items()
    except Exception as e:
        _fail_generation(args.lead_id, "menu_missing", str(e))
        sys.stderr.write(f"menu load failed: {e}\n")
        return EXIT_NOT_FOUND

    try:
        if args.auto_generate_from_menu and args.options_json:
            raise ValueError("--options-json cannot be combined with --auto-generate-from-menu")
        diet_profile = _lead_diet_profile(lead)
        if args.auto_generate_from_menu:
            options = _auto_generate_options(
                menu_items, args.request_text, diet_profile=diet_profile)
        elif args.options_json:
            options = _read_options(args.options_json)
        else:
            raise ValueError("--options-json is required unless --auto-generate-from-menu is set")
        allowed = _allowed_option_count(args.request_text)
        if len(options) != allowed:
            raise ValueError(f"{len(options)} options supplied; expected exactly {allowed}")
        _assert_section_balance(options, menu_items, diet_profile=diet_profile)
        body = _render_body(options, menu_items)
    except SectionBalanceError as e:
        _fail_generation(args.lead_id, "insufficient_section_balance", str(e))
        sys.stderr.write(f"insufficient_section_balance: {e}\n")
        return EXIT_INVALID_INPUT
    except KeyError as e:
        _fail_generation(args.lead_id, "unknown_menu_item", str(e))
        sys.stderr.write(f"unknown menu item: {e}\n")
        return EXIT_INVALID_INPUT
    except ValueError as e:
        reason = "forbidden_customer_text" if "forbidden customer text" in str(e) else "invalid_options"
        _fail_generation(args.lead_id, reason, str(e))
        sys.stderr.write(f"{reason}: {e}\n")
        return EXIT_INVALID_INPUT

    try:
        proposal_set_id = _create_draft(
            lead_id=args.lead_id,
            source_message_id=args.source_message_id,
            request_text=args.request_text,
            options=options,
        )
    except ValueError as e:
        _fail_generation(args.lead_id, "invalid_options", str(e))
        sys.stderr.write(f"invalid_options: {e}\n")
        return EXIT_INVALID_INPUT

    ok, message_id_or_error, _status = _post(args.customer_jid, body, lead_id=args.lead_id)
    if not ok:
        _emit_transition_refusals(
            _mark_send_outcome(proposal_set_id, message_id_or_error, _status))
        _fail_generation(args.lead_id, "bridge_unreachable", message_id_or_error,
                         proposal_set_id, send=(args.customer_jid, _status))
        print(json.dumps({"proposal_set_id": proposal_set_id, "sent": False}))
        return EXIT_DEPENDENCY_DOWN

    _emit_transition_refusals(
        _mark_sent_and_supersede(args.lead_id, proposal_set_id, message_id_or_error)
    )
    # M3 owner-side provenance, AFTER the proposals lock released (leaf-lock contract).
    _append_initial_draft_ledger_best_effort(lead, proposal_set_id, options)
    _append_audit(
        CateringProposalsGenerated(
            type="catering_proposals_generated",
            ts=_now(),
            lead_id=args.lead_id,
            proposal_set_id=proposal_set_id,
            option_count=len(options),
            outbound_message_id=message_id_or_error,
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
            transport_destination=_RUN_IDENTITY["transport_destination"],
            outcome="sent",
        )
    )
    print(
        json.dumps(
            {
                "proposal_set_id": proposal_set_id,
                "sent": True,
                "outbound_message_id": message_id_or_error,
            }
        )
    )
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
