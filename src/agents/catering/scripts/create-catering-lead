#!/usr/bin/env python3
"""create-catering-lead — Agent #2 lead writer.

Called by Kimi (via the parse_catering_inquiry SKILL) once the inquiry has
been classified as catering and key fields have been extracted. This script
is deterministic — it writes state and sends the owner approval card.

Usage:
  # Canonical invocation — pass JSON via stdin (handles arbitrary chars including ' " $ ` \n):
  create-catering-lead \\
    --customer-phone "+19045551234" \\
    --customer-name "Priya Reddy" \\
    --raw-inquiry "Need catering for 50 people June 15 wedding reception" \\
    --message-id "3EB0F1A2E9" \\
    --fields-json - <<'JSON'
  {"headcount": 50, "event_date": "2026-06-15", "menu_preferences": ["vegetarian"], "notes": "cousin's wedding"}
  JSON

  # Legacy form (still supported; AVOID if any field may contain ' " $ ` or other shell metachars):
  #   --fields-json '{"headcount": 50, ...}'

Stdin sentinel: `--fields-json -` (or `--fields-json /dev/stdin`) reads the
JSON dict from stdin. This is the bulletproof path against shell-quoting
bugs — apostrophes in customer text ("Cousin's inquiry") collapse the
single-quoted form and trigger bash EOF errors that no LLM consistently
escapes correctly.

Idempotent on (customer_phone, message_id) — replays of the same inbound
event are a no-op (returns the existing lead's id+code).

Outputs JSON to stdout: {"lead_id": "L0007", "approval_code": "#A3F2X"}.

M1 qualification gate (--qualification-gate, opt-in): when the extracted fields
fall below catering_qualification.REQUIRED_FIELDS, the lead is parked in
QUALIFYING with the first batch of missing-field questions instead of firing an
owner approval card for an event whose date, size, venue and style are unknown.
The customer gets the questions as their ONE bounded response for the turn; the
owner card fires later, from amend-catering-lead, once the loop closes. WITHOUT
the flag every path behaves exactly as before (the LLM SKILL path passes fully
extracted fields and is unaffected).

Exit codes:
  0  — created (or already-exists, idempotent replay)
  2  — invalid input
  3  — catering disabled (cfg.catering.enabled=False)
  5  — schema violation
  6  — bridge unreachable (approval card couldn't send; lead still saved)
"""
from __future__ import annotations

import argparse
import json
import os
import secrets
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional
from zoneinfo import ZoneInfoNotFoundError

sys.path.insert(0, "/opt/shift-agent")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent.parent / "platform"))

from safe_io import (  # noqa: E402
    FileLock, ndjson_append, atomic_write_json, customer_now,
    safe_load_json, load_model, flock,
    assert_load_status_clean, LoadStatusError,
    load_yaml_model,
)
from safe_io import bridge_post_2tuple as _bridge_post  # noqa: E402  # PR-ε: chokepoint consolidation
import approval_code_pools  # noqa: E402  # PR-R1: single-source cross-pool code contract
import catering_qualification  # noqa: E402  # M1: the ONE minimum-qualification gate
from schemas import (  # noqa: E402
    Config, CateringLead, CateringLeadStore, CateringLeadExtractedFields,
    CateringLeadCreated, CateringLeadStatusChange, CateringLeadRejected,
    CateringLeadQualificationUpdated,
    CateringOwnerApprovalRequested,
    Menu, MenuItem,
    CateringCustomerAckSent, CateringCustomerAckFailed,
    CateringOwnerApprovalCardSent, CateringOwnerApprovalCardFailed,
)
from exit_codes import (  # noqa: E402
    EXIT_OK, EXIT_INVALID_INPUT, EXIT_DISABLED,
    EXIT_SCHEMA_VIOLATION, EXIT_DEPENDENCY_DOWN,
)
from audit_helpers import log_config_load_failed_best_effort  # noqa: E402
from catering_paths import CATERING_MENU_PATH  # noqa: E402
from catering_pricing import price_status_line as _price_status_line  # noqa: E402
from catering_proposal_sweep import (  # noqa: E402  # M3 validity window
    DEFAULT_PROPOSAL_VALIDITY_DAYS,
    quote_validity_line as _quote_validity_line,
)
from pydantic import TypeAdapter, ValidationError  # noqa: E402

# PR-D2 commit 1: SHIFT_AGENT_CONFIG_PATH env var override (test-only).
CONFIG_PATH = Path(os.environ.get("SHIFT_AGENT_CONFIG_PATH", "/opt/shift-agent/config.yaml"))
LEADS_PATH = Path("/opt/shift-agent/state/catering-leads.json")
LEADS_LOCK = Path("/opt/shift-agent/state/catering-leads.json.lock")
LOG_PATH = Path("/opt/shift-agent/logs/decisions.log")
TEMPLATE_DIR = Path("/opt/shift-agent/templates")
MENU_PATH = CATERING_MENU_PATH
PROPOSAL_MENU_ITEMS_CAP = 12  # cap to keep WhatsApp message readable

# Off-menu render budget. Budget arithmetic:
# WhatsApp Cloud API caps text.body at ~4096 chars (per Meta's Cloud API
# messages reference). Allocations within that cap:
#   raw_inquiry         : 300 chars (template substitution slice)
#   template boilerplate: ~200 chars
#   other summary lines : ~200 chars typical
#   off_menu items join : ≤1500 chars (this constant)
#   safety margin       : ~1900 chars
# Schema caps off_menu_items at 20 items × 200 chars = 4000 chars worst-case
# (see CateringLeadExtractedFields.off_menu_items in src/platform/schemas.py
# for current bounds); without truncation, the message can blow the cap.
WHATSAPP_OFF_MENU_BUDGET = 1500

# Same alphabet as Shift's proposal codes — visually unambiguous uppercase + digits.
_CODE_ALPHA = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"


def _generate_unique_code() -> str:
    """Generate a 5-char approval code absent from EVERY pool's live codes
    (PR-R1: single source via approval_code_pools.all_live_codes — non-terminal
    catering leads AND menu / expense / shift codes; the dispatcher disambiguates
    a cross-pool collision only by state-file priority). The caller holds
    approval_code_pools.code_generation_lock() across generation + the store
    write so check-and-commit is atomic across pools."""
    active_codes = approval_code_pools.all_live_codes()
    for _ in range(50):
        candidate = "#" + "".join(secrets.choice(_CODE_ALPHA) for _ in range(5))
        if candidate not in active_codes:
            return candidate
    raise RuntimeError("unable to generate unique catering approval code after 50 attempts")


def _next_lead_id(store: CateringLeadStore) -> str:
    """Lead IDs are L0001, L0002, ... incrementing across the lifetime of the store."""
    if not store.leads:
        return "L0001"
    last = max(int(l.lead_id.lstrip("L")) for l in store.leads if l.lead_id.startswith("L") and l.lead_id[1:].isdigit())
    return f"L{last + 1:04d}"


def _load_menu_filtered(dietary_restrictions: list[str]) -> tuple[list[MenuItem], int]:
    """Load current menu and filter items by customer's dietary requests.

    Returns (filtered_items, total_items_in_menu). Falls open on missing menu
    (returns ([], 0)) — proposal still gets sent without the menu section.
    """
    if not MENU_PATH.exists():
        return [], 0
    try:
        menu, status = load_model(MENU_PATH, Menu)
    except Exception:
        return [], 0
    if status != "ok":
        return [], 0
    items = [it for it in menu.items if it.available]
    if not dietary_restrictions:
        return items, len(menu.items)
    requested: set[str] = set()
    for r in dietary_restrictions:
        t = r.lower().strip()
        if t in ("vegetarian", "veg"):
            requested.add("veg")
        elif t in ("non-vegetarian", "non-veg", "nonveg"):
            requested.add("non-veg")
        elif t == "vegan":
            requested.add("vegan")
        elif t == "jain":
            requested.add("jain")
        elif t == "halal":
            requested.add("halal")
        elif t == "kosher":
            requested.add("kosher")
        elif t in ("gluten-free", "gf", "gluten free"):
            requested.add("gluten-free")
        elif t in ("nut-free", "nut free"):
            requested.add("nut-free")
        elif t in ("dairy-free", "dairy free"):
            requested.add("dairy-free")
        elif t in ("egg-free", "egg free", "no eggs"):
            requested.add("egg-free")
    filtered = [it for it in items if any(tag in requested for tag in it.dietary_tags)]
    return filtered, len(menu.items)


def _format_menu_section(items: list[MenuItem], total: int, dietary_restrictions: list[str]) -> str:
    """Build the menu section that appears in the customer-facing proposal."""
    if not items:
        if total == 0:
            return ""  # no menu configured at all
        if dietary_restrictions:
            return (f"\n_(We didn't find items matching {', '.join(dietary_restrictions)} "
                    f"in our current menu. Reply with any specifics and we'll customize.)_\n")
        return ""
    by_cat: dict[str, list[MenuItem]] = {}
    for it in items:
        by_cat.setdefault(it.category, []).append(it)
    cat_order = ["package", "appetizer", "main", "side", "dessert", "beverage", "salad", "soup", "special"]
    lines = ["\n*Sample menu*"]
    if dietary_restrictions:
        lines[0] += f" ({', '.join(dietary_restrictions)})"
    lines[0] += ":"
    shown = 0
    n_cats = max(1, len(by_cat))
    per_cat = max(1, PROPOSAL_MENU_ITEMS_CAP // n_cats)
    for cat in cat_order:
        if cat not in by_cat or shown >= PROPOSAL_MENU_ITEMS_CAP:
            continue
        for it in by_cat[cat][:per_cat]:
            if shown >= PROPOSAL_MENU_ITEMS_CAP:
                break
            # BL-CATER-08: no per-item prices in the pre-approval sample menu.
            # These are unapproved retail prices; the owner sets the real quote at
            # finalize. Showing them pre-approval risks the customer anchoring on a
            # number the owner never signed off on.
            lines.append(f"  - {it.name}")
            shown += 1
    leftover = len(items) - shown
    if leftover > 0:
        lines.append(f"  _...and {leftover} more options on request_")
    return "\n".join(lines) + "\n"


def _render_proposal(lead_id: str, customer_name: str, fields: CateringLeadExtractedFields,
                     validity_days: int = DEFAULT_PROPOSAL_VALIDITY_DAYS) -> str:
    """Render the customer-facing proposal. Uses catering_quote_to_customer.txt
    template (which includes the bridge `template_bypass` prefix) populated
    with extracted fields + sample-menu section filtered by dietary."""
    template_path = TEMPLATE_DIR / "catering_quote_to_customer.txt"
    dietary = list(fields.dietary_restrictions or [])
    filtered_items, total = _load_menu_filtered(dietary)
    menu_section = _format_menu_section(filtered_items, total, dietary)
    fmt_fields = {
        "lead_id": lead_id,
        "customer_name": customer_name or "there",
        "headcount": fields.headcount if fields.headcount is not None else "[TBD]",
        "event_date": fields.event_date or "[TBD]",
        "event_time": fields.event_time or "[TBD]",
        "menu_section": menu_section,
        # M2 ruling #5: the price-status label rides on every customer-facing
        # quote surface. This one is PRE-approval (BL-CATER-08 keeps prices off
        # it entirely), so the honest status is always pending owner review.
        "price_status_line": _price_status_line("pending_owner_review"),
        # M3: a customer is never quoted anything without being told how long it
        # stands. Same config field the proposal set's expires_at is stamped from,
        # so the date the customer reads and the date the sweep enforces agree.
        "quote_validity_line": _quote_validity_line(
            datetime.now(tz=timezone.utc), validity_days
        ),
    }
    if template_path.exists():
        try:
            tmpl = template_path.read_text(encoding="utf-8")
            return tmpl.format(**fmt_fields)
        except (KeyError, OSError):
            pass
    # Inline fallback — already includes bridge `template_bypass` prefix
    return (
        f"⚕ *Catering Agent*\n────────────\n"
        f"Hi {fmt_fields['customer_name']}, thanks for your catering inquiry. "
        f"We'll be in touch shortly with details.{menu_section}\n"
        f"{fmt_fields['price_status_line']}\n"
        f"{fmt_fields['quote_validity_line']}\n(Ref: {lead_id})"
    )


def _render_approval_card(
    lead_id: str, approval_code: str, customer_phone: str, customer_name: Optional[str],
    raw: str, fields: CateringLeadExtractedFields,
) -> str:
    """Format the owner-facing approval card. Uses a template file with {field} substitution.

    Falls back to inline text if template missing — defensive for first deploy.
    """
    template_path = TEMPLATE_DIR / "catering_approval_card_to_owner.txt"
    summary_lines = []
    if fields.headcount is not None:
        summary_lines.append(f"  - Headcount: {fields.headcount}")
    if fields.event_date:
        ev = fields.event_date + (f" {fields.event_time}" if fields.event_time else "")
        summary_lines.append(f"  - Event: {ev}")
    if fields.menu_preferences:
        summary_lines.append(f"  - Menu: {', '.join(fields.menu_preferences)}")
    if fields.dietary_restrictions:
        summary_lines.append(f"  - Dietary: {', '.join(fields.dietary_restrictions)}")

    # Off-menu items (v3.1 C23): customer-intent data, clustered with the
    # what-they-want fields above. Defensive None handling — schema default is
    # `Field(default_factory=list)` so None should never arrive from valid
    # Pydantic instantiation, but a manually-edited leads.json or future schema
    # regression could produce it.
    items = fields.off_menu_items
    if items is None:
        sys.stderr.write(
            "WARN: off_menu_items unexpectedly None (schema default is empty list); "
            "treating as empty. Check leads.json for manually-edited entries.\n"
        )
        items = []
    if items:
        # Conservative truncation against WhatsApp limit per WHATSAPP_OFF_MENU_BUDGET.
        # Two regimes:
        #   (a) total joined exceeds budget → truncate item-list with "(and N more)"
        #   (b) FIRST item alone exceeds budget → truncate the item itself
        # Branch (b) is defensive — schema's per-item max_length=200 makes it
        # unreachable in practice; if max_length is ever relaxed, this branch
        # stays correct.
        joined = ", ".join(items)
        if len(joined) > WHATSAPP_OFF_MENU_BUDGET:
            running = 0
            cutoff = 0
            for i, item in enumerate(items):
                running += len(item) + 2  # ", " separator
                if running > WHATSAPP_OFF_MENU_BUDGET:
                    cutoff = i
                    break
            if cutoff == 0:
                # Single item alone exceeds budget — truncate the item itself.
                trunc_item = items[0][:WHATSAPP_OFF_MENU_BUDGET - 10] + "..."
                joined = trunc_item + (
                    f" (and {len(items) - 1} more)" if len(items) > 1 else ""
                )
                sys.stderr.write(
                    f"WARN: single off_menu_item exceeded budget "
                    f"({len(items[0])} chars); truncated.\n"
                )
            else:
                shown = items[:cutoff]
                joined = ", ".join(shown) + f" (and {len(items) - len(shown)} more)"
        summary_lines.append(f"  - Off-menu requests: {joined}")

    if fields.delivery_or_pickup:
        summary_lines.append(f"  - Delivery: {fields.delivery_or_pickup}")
    if fields.budget_hint_usd is not None:
        summary_lines.append(f"  - Budget hint: ${fields.budget_hint_usd}")

    # Top-of-card marker (mobile-preview-fold mitigation): MUST use
    # insert(0, ...) NOT append; the marker MUST appear at summary_lines[0]
    # so it lands above-the-fold in WhatsApp message previews. Only added
    # when off_menu_items is present so regular leads stay clean. ASCII-only
    # ("[!]" + " - " separator) — avoids unicode encoding fragility on
    # locale-dependent stderr/journald paths.
    if items:
        summary_lines.insert(0, "  [!] Off-menu requests detected - see below")

    summary = "\n".join(summary_lines) if summary_lines else "  (no structured fields extracted)"

    fields_dict = {
        "lead_id": lead_id,
        "approval_code": approval_code,
        "customer_phone": customer_phone,
        "customer_name": customer_name or "(unknown)",
        "raw_inquiry": raw[:300],
        "extracted_summary": summary,
    }
    if template_path.exists():
        try:
            tmpl = template_path.read_text(encoding="utf-8")
            return tmpl.format(**fields_dict)
        except (KeyError, OSError) as e:
            # Template render failure (missing key, encoding error, IO error) —
            # surface to journald via stderr instead of silently falling back.
            sys.stderr.write(
                f"WARN: template render fell back to inline (template_path={template_path}): "
                f"{type(e).__name__}: {e}\n"
            )
    # Inline fallback
    return (
        f"⚕ *Catering Agent*\n────────────\n"
        f"*New Catering Inquiry — {lead_id}*\n\n"
        f"From: {customer_name or '(unknown)'} ({customer_phone})\n\n"
        f"{raw[:300]}\n\n"
        f"Extracted:\n{summary}\n\n"
        f"*To approve, reply with:* `{approval_code} approve`\n"
        f"*To reject:* `{approval_code} reject`\n"
        f"*To edit:* `{approval_code} edit <your changes>`"
    )


# Maps CateringLeadRejected.reason → SKILL-readable stderr prefix.
# Any new reason returned by _validate_event_date (and added to the schema
# Literal) MUST also land here. The .get() fallback to "ERR_UNKNOWN_REJECTION"
# is defense-in-depth so SKILL parsers see a structured prefix rather than
# crashing on a None value when the helper/dict drift one step apart.
REASON_TO_ERR_PREFIX = {
    "event_date_past": "ERR_EVENT_DATE_PAST",
    "event_date_invalid_calendar": "ERR_EVENT_DATE_INVALID",
    "timezone_invalid": "ERR_TIMEZONE_INVALID",
}


def _validate_event_date(
    fields: CateringLeadExtractedFields, tz_name: str
) -> tuple[Optional[str], Optional[str]]:
    """Returns (reason, detail) tuple. (None, None) means input is valid.

    `reason` values match the CateringLeadRejected schema Literal — pinned by
    Pydantic so a typo here raises ValidationError at log-write time.

    Why script-level vs schema-level (per design v2): Pydantic v2 *does* support
    model_validate(..., context={...}) and info.context access in validators,
    but plumbing tz context through every model_validate_json call site (the
    read path, replay tools, and the catering v3.1 C22 round-trip test that
    calls model_validate_json with no context) would couple the schema to
    runtime tz config. Keeping tz-aware checks at the script (write-path) layer
    leaves the schema stateless and read-path-safe.

    Why both invalid-calendar AND past-date here (not just past-date): schema
    pattern is format-only (4-2-2 digit groups); accepts 2026-13-45 etc.
    Past-date check needs strptime, which doubles as semantic validity check.
    Rejecting both at this site avoids garbage dates persisting downstream.
    """
    if not fields.event_date:
        return None, None  # No event_date → no check.

    try:
        ev = datetime.strptime(fields.event_date, "%Y-%m-%d").date()
    except ValueError:
        return "event_date_invalid_calendar", (
            f"event_date {fields.event_date!r} matches format but is not a valid calendar date"
        )

    # Narrow except (design-review HIGH-C + PR-review MEDIUM-1): catch
    # tz-resolution failures specifically. ZoneInfoNotFoundError covers the
    # tz-not-found case (it IS a KeyError subclass on 3.11+, but listing it
    # explicitly documents intent). ValueError covers malformed tzdata. We do
    # NOT catch KeyError or AttributeError/TypeError — those indicate
    # config-shape bugs (None tz, int tz, etc.) and should propagate as the
    # programming bugs they are, not be bucketed into ERR_TIMEZONE_INVALID.
    try:
        today = customer_now(tz_name).date()
    except (ZoneInfoNotFoundError, ValueError) as e:
        return "timezone_invalid", (
            f"cfg.customer.timezone {tz_name!r} could not be resolved: {type(e).__name__}: {e}"
        )

    if ev < today:
        return "event_date_past", (
            f"event_date {fields.event_date} is before today {today.isoformat()} ({tz_name})"
        )
    return None, None


def _customer_jid(raw_customer_phone: str) -> str:
    """Bridge JID for a customer, from the RAW upstream --customer-phone value.

    F14-LID 2026-05-11: upstream SKILLs pass either a +E.164 phone OR a bare LID
    ("<digits>@lid") when the v=1 sender block had phone=null. Persistence-side
    Pydantic normalization strips @lid, but this builder runs on the RAW args value
    pre-normalization. Without the @lid detection below, LID input produces a
    malformed "<digits>@lid@s.whatsapp.net" JID and the customer never receives the
    message. Bug reproduced 2026-05-11 on L0004; fix documented in
    tasks/hermes-v0-13-0-plugin-api-recon-2026-05-11.md.
    """
    cp = str(raw_customer_phone).lstrip('+').strip()
    if cp.endswith('@lid'):
        return cp                       # LID-only: bridge accepts "<digits>@lid" directly
    if '@' in cp:
        return cp                       # defensive: already a complete JID, pass through
    return f"{cp}@s.whatsapp.net"       # standard phone path


def _log(adapter: TypeAdapter, entry) -> None:
    """Append a Pydantic-validated entry to decisions.log under flock."""
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with flock(LOG_PATH):
        ndjson_append(LOG_PATH, adapter.dump_json(entry).decode("utf-8"))


def _audit_best_effort(adapter: TypeAdapter, entry, *, context: str) -> None:
    """Best-effort audit write. Never raises.

    Guarantees the caller can always emit its structured stdout/stderr/exit-code
    contract regardless of audit durability (disk full, perms, NFS hiccup).

    Generalizes the design-review HIGH-A pattern uniformly to ALL audit writes
    in this script — previously only the rejection-path _log() was wrapped, so
    a success-path audit failure after atomic_write_json(LEADS_PATH) already
    persisted the lead would propagate as an uncaught traceback, stranding the
    lead with no audit AND no stdout JSON. With this wrapper, the operator gets
    a journald WARN line and the script still emits its contract.
    """
    try:
        _log(adapter, entry)
    except Exception as e:  # noqa: BLE001 — invariant: audit must not block flow
        sys.stderr.write(
            f"WARN: audit log failed (non-fatal, context={context}): "
            f"{type(e).__name__}: {e}\n"
        )


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--customer-phone", required=True)
    ap.add_argument("--customer-name", default=None)
    ap.add_argument("--raw-inquiry", required=True)
    ap.add_argument("--message-id", required=True, help="Meta WhatsApp message id (idempotency key)")
    ap.add_argument("--fields-json", required=True,
                    help=("JSON dict matching CateringLeadExtractedFields. "
                          "Pass - or /dev/stdin to read from stdin "
                          "(use stdin form when JSON may contain shell "
                          "metacharacters such as apostrophes or quotes)."))
    ap.add_argument("--suppress-customer-ack", action="store_true",
                    help=("Turn-arbitration 2026-07-26: send the owner approval card "
                          "but NOT the F14 customer proposal. cf-router sets this when "
                          "it will immediately generate the tiered proposal set for the "
                          "new lead, so the customer receives ONE bounded response (the "
                          "generated options) instead of an F14 sample menu AND a "
                          "tiered set as two independent sends. Default: send the F14 ack."))
    ap.add_argument("--qualification-gate", action="store_true",
                    help=("M1: park the lead in QUALIFYING and ask for the missing "
                          "catering_qualification.REQUIRED_FIELDS instead of firing an "
                          "owner approval card, when the extracted fields fall below "
                          "minimum qualification. cf-router F7 primary-mode sets this; "
                          "the LLM SKILL path (which passes fully extracted fields) does "
                          "not, so its behavior is unchanged. Default: off."))
    args = ap.parse_args()

    # Stdin sentinel — bulletproof path for JSON containing shell metachars
    # (apostrophes, double quotes, $, backticks, newlines). Prefer this over
    # `--fields-json '{"...":"..."}'` because no LLM consistently escapes
    # bare apostrophes in user-generated text and the resulting bash EOF
    # errors trigger runaway retry loops (observed 2026-05-13 incident).
    if args.fields_json in ("-", "/dev/stdin"):
        args.fields_json = sys.stdin.read()

    # Load config
    try:
        cfg = load_yaml_model(CONFIG_PATH, Config)
    except (FileNotFoundError, RuntimeError, ValidationError) as e:
        log_config_load_failed_best_effort(CONFIG_PATH, e)
        sys.stderr.write(f"config load failed: {type(e).__name__}: {e}\n")
        return EXIT_SCHEMA_VIOLATION

    if not cfg.catering.enabled:
        sys.stderr.write("catering disabled (cfg.catering.enabled=false)\n")
        return EXIT_DISABLED

    # Validate extracted fields
    try:
        extracted = CateringLeadExtractedFields.model_validate_json(args.fields_json)
    except ValidationError as e:
        sys.stderr.write(f"fields_json validation failed: {e}\n")
        return EXIT_INVALID_INPUT

    LEADS_PATH.parent.mkdir(parents=True, exist_ok=True)
    # PR-R1: hold the ONE cross-pool code-generation lock OUTSIDE the leads-store
    # lock (global-code-lock BEFORE pool-store-lock) so the exclusion-scan + code
    # write are atomic against every other generator.
    with approval_code_pools.code_generation_lock(state_dir=LEADS_PATH.parent), FileLock(LEADS_LOCK):
        # Load store (or empty default)
        store, status = load_model(LEADS_PATH, CateringLeadStore, default=CateringLeadStore())
        try:
            assert_load_status_clean(LEADS_PATH, status, context="create-lead initial load")
        except LoadStatusError as e:
            # Silent-failure-hunter NEW-1: oserror MUST NOT silently fall
            # through to a fresh empty store — that would mint a duplicate
            # L0001 and lose the existing leads on the next write.
            sys.stderr.write(f"{e}\n")
            return EXIT_SCHEMA_VIOLATION

        # Idempotency: same message_id replays?
        # Runs BEFORE event-date validation (v3.1 C10): a lead created in the past
        # may have had a then-future event_date that is now-past; replay must
        # NOT reject — return the existing lead's id+code identically.
        existing = next(
            (l for l in store.leads if l.original_message_id == args.message_id),
            None,
        )
        if existing:
            # Replay breadcrumb: when the existing lead has off_menu_items,
            # log a journald entry so a high-value booking whose original card
            # may have been lost (auto-archived, owner missed) leaves a trail
            # for post-hoc operator triage. Wording is honest about uncertainty —
            # the lead schema does not yet persist a card_sent flag, so we
            # cannot assert the original card was delivered. A future durable
            # card_sent flag would let us be specific.
            if existing.extracted.off_menu_items:
                sys.stderr.write(
                    f"INFO: idempotent_replay on lead {existing.lead_id} with "
                    f"non-empty off_menu_items={existing.extracted.off_menu_items!r}. "
                    f"Original card-send disposition unknown — verify in cockpit.\n"
                )
            print(json.dumps({
                "lead_id": existing.lead_id,
                "approval_code": existing.owner_approval_code,
                "idempotent_replay": True,
            }))
            return EXIT_OK

        # First-touch event-date validation (v3.1 C10).
        # Three failure modes → three reasons in CateringLeadRejected.
        # Order: log audit FIRST (durable), stderr SECOND (so SIGKILL between
        # them doesn't lose the audit entry — design-review MEDIUM-E).
        reason, detail = _validate_event_date(extracted, cfg.customer.timezone)
        if reason is not None:
            err_prefix = REASON_TO_ERR_PREFIX.get(reason, "ERR_UNKNOWN_REJECTION")
            # Audit ts is ALWAYS UTC (design-review MEDIUM-D — consistent ordering
            # for log-replay tools regardless of which failure mode fired).
            ts_utc = datetime.now(tz=timezone.utc)
            _audit_best_effort(
                TypeAdapter(CateringLeadRejected),
                CateringLeadRejected(
                    type="catering_lead_rejected",
                    ts=ts_utc,
                    customer_phone=args.customer_phone,
                    original_message_id=args.message_id,
                    reason=reason,
                    detail=detail[:500] if detail else "",
                    customer_tz=cfg.customer.timezone,
                    event_date=extracted.event_date,
                ),
                context="rejected",
            )
            sys.stderr.write(f"{err_prefix}: {detail}\n")
            # timezone_invalid is config-level (cfg.customer.timezone), not input-level
            # (customer-supplied event_date). Distinct exit code surfaces the difference.
            return EXIT_SCHEMA_VIOLATION if reason == "timezone_invalid" else EXIT_INVALID_INPUT

        # Mint new lead
        now = customer_now(cfg.customer.timezone)
        lead_id = _next_lead_id(store)
        approval_code = _generate_unique_code()

        # M1 qualification gate. `qualification_state` is the ONE decision point —
        # the same call amend-catering-lead makes when an answer arrives, so the
        # create and update paths can never disagree about what "complete" means.
        # The approval code is still minted (it belongs to the lead for its whole
        # life, and approval_code_pools excludes only TERMINAL statuses, so a
        # QUALIFYING lead's code stays reserved against collision); it is simply
        # not shown to the owner until the lead is worth approving.
        qual = catering_qualification.qualification_state(extracted)
        gated = bool(args.qualification_gate) and not qual["complete"]
        pending_questions = (
            catering_qualification.next_question_batch(
                {"extracted": extracted, "questions_asked": []},
            ) if gated else []
        )

        lead = CateringLead(
            lead_id=lead_id,
            status="QUALIFYING" if gated else "AWAITING_OWNER_APPROVAL",
            customer_phone=args.customer_phone,
            customer_name=args.customer_name,
            raw_inquiry=args.raw_inquiry,
            original_message_id=args.message_id,
            created_at=now,
            updated_at=now,
            extracted=extracted,
            owner_approval_code=approval_code,
            pending_questions=pending_questions,
            questions_asked=list(pending_questions),
            qualification_rounds=1 if gated else 0,
        )
        store.leads.append(lead)

        # Validate before persist
        try:
            CateringLeadStore.model_validate(store.model_dump())
        except ValidationError as e:
            sys.stderr.write(f"store validation failed: {e}\n")
            return EXIT_SCHEMA_VIOLATION

        atomic_write_json(LEADS_PATH, store)

        # Audit: created → awaiting → approval-requested.
        # All writes are best-effort: if audit fails, lead is already persisted
        # (atomic_write_json above) and the SKILL must still get lead_id+code on
        # stdout. Operator gets a journald WARN line per failed write.
        _audit_best_effort(
            TypeAdapter(CateringLeadCreated),
            CateringLeadCreated(
                type="catering_lead_created", ts=now,
                lead_id=lead_id,
                customer_phone=args.customer_phone,
                original_message_id=args.message_id,
            ),
            context="created",
        )
        _audit_best_effort(
            TypeAdapter(CateringLeadStatusChange),
            CateringLeadStatusChange(
                type="catering_lead_status_change", ts=now,
                lead_id=lead_id, from_status="NEW",
                to_status="QUALIFYING" if gated else "AWAITING_OWNER_APPROVAL",
                actor="system",
                reason="qualification_incomplete" if gated else "extractor_completed",
            ),
            context="status_change",
        )
        if gated:
            # M1: no owner-approval request is emitted for a QUALIFYING lead — the
            # owner is not being asked for anything yet. The qualification row is the
            # audit anchor for this round instead.
            _audit_best_effort(
                TypeAdapter(CateringLeadQualificationUpdated),
                CateringLeadQualificationUpdated(
                    type="catering_lead_qualification_updated", ts=now,
                    lead_id=lead_id,
                    fields_filled=[f for f in catering_qualification.REQUIRED_FIELDS
                                   if f not in qual["missing"]],
                    still_missing=qual["missing"],
                    questions_asked=pending_questions,
                    round_number=1, complete=False, outcome="asked",
                ),
                context="qualification_updated",
            )
        else:
            _audit_best_effort(
                TypeAdapter(CateringOwnerApprovalRequested),
                CateringOwnerApprovalRequested(
                    type="catering_owner_approval_requested", ts=now,
                    lead_id=lead_id, approval_code=approval_code,
                ),
                context="approval_requested",
            )

    # M1 gated path: the customer's ONE bounded response for this turn is the
    # question batch — no owner card (nothing to approve yet) and no F14 sample
    # menu (a menu for an event with no date/size/venue anchors the customer on a
    # spread the owner never priced). The owner card fires from amend-catering-lead
    # once the loop closes, or at the round cap with the gaps flagged.
    if gated:
        question_text = catering_qualification.render_question_message(
            lead_id, pending_questions, first_contact=True,
        )
        customer_jid = _customer_jid(args.customer_phone)
        send_attempt_id = uuid.uuid4().hex
        q_ok, q_mid_or_err = _bridge_post(customer_jid, question_text)
        try:
            if q_ok:
                entry = CateringCustomerAckSent(
                    ts=now, type="catering_customer_ack_sent",
                    customer_jid=customer_jid, outbound_message_id=q_mid_or_err,
                    lead_id=lead_id, logical_turn_id=args.message_id,
                    send_attempt_id=send_attempt_id, outcome="sent",
                )
            else:
                sys.stderr.write(f"qualification questions bridge_post failed: {q_mid_or_err}\n")
                entry = CateringCustomerAckFailed(
                    ts=now, type="catering_customer_ack_failed",
                    customer_jid=customer_jid, reason="bridge_unreachable",
                    detail=str(q_mid_or_err)[:2000], logical_turn_id=args.message_id,
                    send_attempt_id=send_attempt_id, outcome="bridge_unreachable",
                )
            with FileLock(LEADS_LOCK):
                ndjson_append(LOG_PATH, entry.model_dump_json())
        except Exception as e:  # noqa: BLE001 — audit is best-effort
            sys.stderr.write(f"audit emit (qualification ack) failed (non-fatal): {e}\n")
        print(json.dumps({
            "lead_id": lead_id, "approval_code": approval_code,
            "status": "QUALIFYING", "card_sent": False,
            "qualification_complete": False,
            "qualification_missing": qual["missing"],
            "pending_questions": pending_questions,
            "questions_sent": q_ok,
        }))
        # Lead is persisted either way; a failed question send is the same class as
        # a failed owner card (state consistent, dependency down) and gets the same
        # exit code so the caller can surface it.
        return EXIT_OK if q_ok else EXIT_DEPENDENCY_DOWN

    # Send approval card to owner — outside the FileLock; bridge slowness shouldn't block.
    if not cfg.owner.self_chat_jid:
        sys.stderr.write("owner.self_chat_jid empty; lead saved but card not sent\n")
        # Still success — lead is in state; owner can review via cockpit
        print(json.dumps({"lead_id": lead_id, "approval_code": approval_code,
                          "card_sent": False, "reason": "self_chat_jid_empty"}))
        return EXIT_OK

    card_text = _render_approval_card(
        lead_id, approval_code, args.customer_phone, args.customer_name,
        args.raw_inquiry, extracted,
    )
    # PR-4 (charter §4.3): this OWNER-facing card send is a distinct outbound from
    # the customer ack of the same inbound — its OWN send_attempt_id, sharing the
    # inbound's logical_turn_id (= --message-id). Previously it had NO audit row.
    logical_turn_id = args.message_id
    owner_card_send_attempt_id = uuid.uuid4().hex
    ok, mid_or_err = _bridge_post(cfg.owner.self_chat_jid, card_text)
    if not ok:
        sys.stderr.write(f"bridge_post failed: {mid_or_err}\n")
        try:
            with FileLock(LEADS_LOCK):
                ndjson_append(LOG_PATH, CateringOwnerApprovalCardFailed(
                    ts=now, type="catering_owner_approval_card_failed",
                    lead_id=lead_id, reason="bridge_unreachable",
                    bridge_error=str(mid_or_err)[:2000],
                    logical_turn_id=logical_turn_id,
                    send_attempt_id=owner_card_send_attempt_id,
                    transport_destination=cfg.owner.self_chat_jid,
                    outcome="bridge_unreachable",
                ).model_dump_json())
        except Exception as e:  # noqa: BLE001 — audit is best-effort
            sys.stderr.write(f"audit emit (owner_card_failed) failed (non-fatal): {e}\n")
        # Lead is saved; owner just doesn't get the card. Return DEPENDENCY_DOWN
        # so caller can fire Pushover separately. State is consistent.
        print(json.dumps({"lead_id": lead_id, "approval_code": approval_code,
                          "card_sent": False, "reason": mid_or_err}))
        return EXIT_DEPENDENCY_DOWN

    # Owner card delivered — record the OWNER-side outbound (distinct from the
    # customer ack below; same logical_turn_id, different send_attempt_id).
    try:
        with FileLock(LEADS_LOCK):
            ndjson_append(LOG_PATH, CateringOwnerApprovalCardSent(
                ts=now, type="catering_owner_approval_card_sent",
                lead_id=lead_id, owner_card_outbound_id=mid_or_err,
                logical_turn_id=logical_turn_id,
                send_attempt_id=owner_card_send_attempt_id,
                transport_destination=cfg.owner.self_chat_jid,
                outcome="sent",
            ).model_dump_json())
    except Exception as e:  # noqa: BLE001 — audit is best-effort
        sys.stderr.write(f"audit emit (owner_card_sent) failed (non-fatal): {e}\n")

    # Turn-arbitration 2026-07-26: when cf-router will IMMEDIATELY generate the tiered
    # proposal set for this new lead, the F14 sample-menu send would be a redundant
    # SECOND customer outbound in the same turn. --suppress-customer-ack skips it so the
    # generated options are the single bounded response; the owner card above still went
    # out, and the lead is fully persisted, so the customer is never left silent.
    if args.suppress_customer_ack:
        print(json.dumps({
            "lead_id": lead_id, "approval_code": approval_code,
            "card_sent": True, "outbound_message_id": mid_or_err,
            "proposal_sent": False, "proposal_suppressed": True,
        }))
        return EXIT_OK

    # F14 2026-05-01: send the customer proposal automatically — full menu-rendered
    # template (filtered by dietary). This is the reply the customer sees IMMEDIATELY,
    # before any owner approval. Owner involvement is reserved for the FINAL priced
    # quote (handle_catering_owner_approval flow), not the initial proposal.
    #
    customer_jid = _customer_jid(args.customer_phone)  # see helper for the F14-LID contract
    proposal_text = _render_proposal(lead_id, args.customer_name, extracted,
                                     cfg.catering.proposal_validity_days)
    # PR-4 (charter §4.3/§4.2): the customer ack shares the turn's logical_turn_id
    # (set above with the owner card) but gets its OWN send_attempt_id — distinct
    # customer- vs owner-side outbound identity for the same inbound.
    send_attempt_id = uuid.uuid4().hex
    proposal_ok, proposal_mid_or_err = _bridge_post(customer_jid, proposal_text)
    if proposal_ok:
        try:
            ack_entry = CateringCustomerAckSent(
                ts=now,
                type="catering_customer_ack_sent",
                customer_jid=customer_jid,
                outbound_message_id=proposal_mid_or_err,
                lead_id=lead_id,
                logical_turn_id=logical_turn_id,
                send_attempt_id=send_attempt_id,
                outcome="sent",
            )
            with FileLock(LEADS_LOCK):
                ndjson_append(LOG_PATH, ack_entry.model_dump_json())
        except Exception as e:
            sys.stderr.write(f"audit emit (ack_sent) failed (non-fatal): {e}\n")
    else:
        sys.stderr.write(f"customer proposal bridge_post failed: {proposal_mid_or_err}\n")
        try:
            fail_entry = CateringCustomerAckFailed(
                ts=now,
                type="catering_customer_ack_failed",
                customer_jid=customer_jid,
                reason="bridge_unreachable",
                detail=proposal_mid_or_err[:2000],
                logical_turn_id=logical_turn_id,
                send_attempt_id=send_attempt_id,
                outcome="bridge_unreachable",
            )
            with FileLock(LEADS_LOCK):
                ndjson_append(LOG_PATH, fail_entry.model_dump_json())
        except Exception as e:
            sys.stderr.write(f"audit emit (ack_failed) failed (non-fatal): {e}\n")

    print(json.dumps({
        "lead_id": lead_id, "approval_code": approval_code,
        "card_sent": True, "outbound_message_id": mid_or_err,
        "proposal_sent": proposal_ok,
        "proposal_message_id": proposal_mid_or_err if proposal_ok else None,
    }))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
