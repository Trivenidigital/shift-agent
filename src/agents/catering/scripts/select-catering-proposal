#!/usr/bin/env python3
"""select-catering-proposal - customer option selection for catering proposals."""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import uuid
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, "/opt/shift-agent")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent.parent / "platform"))

from pydantic import TypeAdapter  # noqa: E402

from exit_codes import EXIT_DEPENDENCY_DOWN, EXIT_INVALID_INPUT, EXIT_NOT_FOUND, EXIT_OK  # noqa: E402
from safe_io import FileLock, assert_load_status_clean, atomic_write_json, load_model, ndjson_append  # noqa: E402
from safe_io import bridge_post as _bridge_post_4tuple  # noqa: E402  # P17b: status is consumed
from schemas import (  # noqa: E402
    CateringCustomerAckFailed,
    CateringCustomerAckSent,
    CateringCustomerSendUnconfirmed,
    CateringLeadStore,
    CateringProposalOption,
    CateringProposalSelected,
    CateringProposalSelectionFailed,
    CateringProposalSet,
    CateringProposalStore,
    CateringProposalTransitionRefused,
    CateringSelectedItem,
    Menu,
    MenuItem,
    is_proposal_set_transition_allowed,
)
from catering_paths import CATERING_MENU_PATH  # noqa: E402
# M3 validity window. Reusing the SWEEP's own predicate (rather than re-deriving
# `expires_at <= now` here) keeps ONE definition of "expired": a set this script
# would still accept but the sweep would retire is exactly the inconsistency the
# shared helper exists to prevent.
from catering_proposal_sweep import find_expired_sent_proposal_sets  # noqa: E402

PROPOSALS_PATH = Path("/opt/shift-agent/state/catering-proposals.json")
PROPOSALS_LOCK = Path("/opt/shift-agent/state/catering-proposals.json.lock")
LEADS_PATH = Path("/opt/shift-agent/state/catering-leads.json")
LEADS_LOCK = Path("/opt/shift-agent/state/catering-leads.json.lock")
MENU_PATH = CATERING_MENU_PATH
LOG_PATH = Path("/opt/shift-agent/logs/decisions.log")
LOG_LOCK = Path("/opt/shift-agent/logs/decisions.log.lock")
FINALIZE_BIN = Path("/usr/local/bin/finalize-catering-menu")
NOTIFY_OWNER_BIN = Path("/usr/local/bin/shift-agent-notify-owner")
PYTHON_BIN = Path("/usr/local/lib/hermes-agent/venv/bin/python")
BRIDGE_PREFIX = "\u2695 *Catering Agent*\n------------\n"

OPTION_RE = re.compile(r"(?i)(?:option|proposal|menu)?\s*#?\s*([1-3])\b")
ACTION_OPTION_RE = re.compile(
    r"(?i)\b(?:go with|choose|select|take|pick|finalize|confirm|lock in|proceed with|we'?ll take|i'?ll take|she'?ll take)\b.{0,40}\b(?:option|proposal|menu)?\s*#?\s*([1-3])\b"
)
# Turn-arbitration 2026-07-26: an EMBEDDED named option ("I like Option 2. Can you send
# me quote and prices.") — the option word immediately before the number — is a selection
# even without an action verb. cf-router routes such compound select+pricing messages here,
# so the resolver must record the named option instead of dead-ending on a clarification.
# Requires the option word to PRECEDE the number (not a bare "2 options" count).
OPTION_NAMED_RE = re.compile(r"(?i)\b(?:option|proposal|menu)\s*#?\s*([1-3])\b")
# An information-seeking question about an option ("can you tell me about option 2?",
# "what's in option 2?") is NOT a selection — keep clarifying rather than auto-selecting.
INFO_QUERY_RE = re.compile(
    r"(?i)\b(?:tell me|what(?:'?s| is| are| does)?|which|describe|explain|"
    r"details?|difference|compare|"
    r"know (?:more )?about|hear (?:more )?about|learn (?:more )?about|more about)\b"
)
TIER_RE = re.compile(r"(?i)\b(premium|balanced|classic)\b")


class MenuSelectionError(ValueError):
    """Raised when proposal items cannot be resolved against the current menu."""


@dataclass(frozen=True)
class SelectionFinalizeResult:
    proposal_set_id: str
    option_id: str
    finalize_exit_code: int
    options: list[CateringProposalOption]
    refusals: list[dict] = field(default_factory=list)


@dataclass(frozen=True)
class SelectionClaim:
    proposal_set_id: str
    option_id: str
    selected_items: list[dict]
    quote_total_usd: int
    options: list[CateringProposalOption]
    refusals: list[dict] = field(default_factory=list)


@dataclass(frozen=True)
class SelectionClaimFailure:
    proposal_set_id: str
    reason: str
    detail: str
    options: list[CateringProposalOption]
    exit_code: int
    refusals: list[dict] = field(default_factory=list)


def _now() -> datetime:
    return datetime.now(tz=timezone.utc)


def _proposal_sequence(row: CateringProposalSet) -> int:
    match = re.search(r"-(\d{6})$", row.proposal_set_id)
    return int(match.group(1)) if match else -1


# PR-4 (charter §4.3/§4.2): outbound audit identity for the current invocation.
# Set once in main() from CLI args; read by the audit emitters so every row for
# this selection turn shares one logical_turn_id + the turn's send_attempt_id (the
# customer-facing send is the ack). A mutable dict avoids the `global` statement.
_RUN_IDENTITY = {"logical_turn_id": "", "send_attempt_id": "", "transport_destination": ""}


def _set_run_identity(*, logical_turn_id: str, send_attempt_id: str, transport_destination: str) -> None:
    _RUN_IDENTITY["logical_turn_id"] = logical_turn_id
    _RUN_IDENTITY["send_attempt_id"] = send_attempt_id
    _RUN_IDENTITY["transport_destination"] = transport_destination


def _append_audit(entry) -> None:
    adapter = TypeAdapter(type(entry))
    with FileLock(LOG_LOCK):
        ndjson_append(LOG_PATH, adapter.dump_json(entry).decode("utf-8"))


def _audit_selected(lead_id: str, proposal_set_id: str, option_id: str, customer_message_id: str, rc: int) -> None:
    _append_audit(
        CateringProposalSelected(
            type="catering_proposal_selected",
            ts=_now(),
            lead_id=lead_id,
            proposal_set_id=proposal_set_id,
            option_id=option_id,
            customer_message_id=customer_message_id,
            finalize_exit_code=rc,
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
        )
    )


def _audit_failed(lead_id: str, reason: str, detail: str = "", proposal_set_id: str = "") -> None:
    _append_audit(
        CateringProposalSelectionFailed(
            type="catering_proposal_selection_failed",
            ts=_now(),
            lead_id=lead_id,
            proposal_set_id=proposal_set_id,
            reason=reason,
            detail=detail[:2000],
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
            transport_destination=_RUN_IDENTITY["transport_destination"],
            outcome=reason,
        )
    )


def _delivery_certainty(send_status: str) -> str:
    """'uncertain' only for safe_io's `send_uncertain` (bridge accepted, ack body
    unparseable → most likely delivered). Every other non-sent status — transport
    faults AND the policy drops ('refused', 'throttled', 'suppressed', 'disabled')
    — means nothing was received."""
    return "uncertain" if send_status == "send_uncertain" else "failed"


def _page_owner_ack_unconfirmed(lead_id: str, certainty: str, detail: str) -> bool:
    """Page over `shift-agent-notify-owner` (Pushover), NOT the bridge that just
    failed to confirm. Reached ONLY for the post-finalize acknowledgment — see
    `_post`'s note on why the other eleven sends record without paging."""
    if certainty == "uncertain":
        title = f"Catering {lead_id}: selection ack NOT confirmed"
        body = (f"Catering {lead_id}: the customer's selection WAS recorded and "
                f"finalized, and the acknowledgment was accepted by the bridge "
                f"but not confirmed — so it most likely DID arrive. Check before "
                f"re-sending.\n"
                f"Detail: {detail[:200]}")
    else:
        title = f"Catering {lead_id}: selection ack NOT delivered"
        body = (f"Catering {lead_id}: the customer's selection WAS recorded and "
                f"finalized, but the acknowledgment did NOT reach them. They have "
                f"no confirmation that their choice registered. Message them "
                f"manually.\n"
                f"Detail: {detail[:200]}")
    sys.stderr.write(f"catering_send_unconfirmed_alert_dispatched lead={lead_id} "
                     f"kind=proposal_selection_reply certainty={certainty}\n")
    try:
        proc = subprocess.run(
            [str(NOTIFY_OWNER_BIN), "--priority", "1", "--title", title, "--", body],
            check=False, capture_output=True, text=True, timeout=10,
        )
        paged = proc.returncode == 0
    except Exception as e:  # noqa: BLE001 — alerting is best-effort
        sys.stderr.write(f"catering_send_unconfirmed_alert_delivery_failed "
                         f"lead={lead_id} error={type(e).__name__}: {e}\n")
        return False
    sys.stderr.write(f"catering_send_unconfirmed_alert_delivered lead={lead_id} "
                     f"ok={paged}\n")
    return paged


def _post(jid: str, text: str, *, lead_id: str, page: bool = False) -> tuple[bool, str]:
    """THE customer send for this script. Every one of the twelve call sites goes
    through here, so the status decision lives in ONE place instead of twelve
    copies that could drift.

    Returns (ok, message_id_or_error) — the shape the call sites already expect.

    Per-script paging decision. Eleven of the twelve sends are responses to a
    customer message that changed NO durable state: "that proposal expired",
    "which option did you mean", "that didn't work". If one of those does not
    land the customer simply gets silence and messages again — self-correcting,
    and paging on each would train the owner to ignore the channel. They are
    RECORDED, not paged.

    The exception (`page=True`) is the acknowledgment AFTER a successful
    selection+finalize. There the lead has moved to CUSTOMER_FINALIZED and the
    owner card has fired, so the state says the customer chose while the customer
    was told nothing — the same shape as #708's BOOKED-but-silent case, and the
    one a human has to close.

    No lead marker: `customer_ack_status` belongs to record-catering-acceptance's
    accept/decline confirmation, and writing a selection outcome into it would
    corrupt the acceptance signal. The audit row carries this fact instead.
    """
    ok4, mid, err, status = _bridge_post_4tuple(jid, text)
    if ok4:
        return True, mid
    detail = err or status
    certainty = _delivery_certainty(status)
    paged = _page_owner_ack_unconfirmed(lead_id, certainty, detail) if page else False
    sys.stderr.write(f"customer send failed: {detail} (status={status})\n")
    try:
        _append_audit(CateringCustomerSendUnconfirmed(
            type="catering_customer_send_unconfirmed", ts=_now(),
            lead_id=lead_id, script="select-catering-proposal",
            send_kind="proposal_selection_reply", send_status=status,
            delivery_certainty=certainty, detail=str(detail)[:2000],
            owner_paged=paged,
            logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
            send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
            transport_destination=jid, outcome=status,
        ))
    except Exception as e:  # noqa: BLE001 — audit is best-effort
        sys.stderr.write(f"audit emit (customer_send_unconfirmed) failed "
                         f"(non-fatal): {type(e).__name__}: {e}\n")
    return False, detail


def _audit_ack(lead_id: str, customer_jid: str, ok: bool, message_id_or_error: str) -> None:
    """Record the selection-acknowledgment send so every customer-facing outbound in the
    arbitrated turn is traceable by its bridge outbound message id (turn-arbitration
    2026-07-26). Mirrors create-catering-lead's F14 ack audit (catering_customer_ack_sent /
    catering_customer_ack_failed). Best-effort: a selection that already succeeded must not
    be undone by an audit-emit hiccup, so failures are swallowed to stderr."""
    try:
        if ok and str(message_id_or_error).strip():
            _append_audit(CateringCustomerAckSent(
                type="catering_customer_ack_sent",
                ts=_now(),
                customer_jid=customer_jid,
                outbound_message_id=message_id_or_error,
                lead_id=lead_id,
                logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
                send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
                outcome="sent",
            ))
        else:
            _append_audit(CateringCustomerAckFailed(
                type="catering_customer_ack_failed",
                ts=_now(),
                customer_jid=customer_jid,
                reason="bridge_unreachable",
                detail=str(message_id_or_error)[:2000],
                logical_turn_id=_RUN_IDENTITY["logical_turn_id"],
                send_attempt_id=_RUN_IDENTITY["send_attempt_id"],
                outcome="bridge_unreachable",
            ))
    except Exception as e:  # noqa: BLE001 - audit is best-effort
        sys.stderr.write(f"WARN: selection-ack audit emit failed (non-fatal): {type(e).__name__}: {e}\n")


# M3 — proposal-set state machine enforcement. Mirrors create-catering-proposal-
# options: an illegal status write is REFUSED (row untouched) and recorded, never
# silently applied. Refusals are collected under PROPOSALS_LOCK and emitted by
# _emit_transition_refusals after it releases, keeping this script's existing
# lock discipline (PROPOSALS_LOCK and LOG_LOCK are never held together).
def _transition_ok(row, to_status: str, write_site: str, sink: list[dict]) -> bool:
    if is_proposal_set_transition_allowed(row.status, to_status):
        return True
    sink.append({
        "lead_id": row.lead_id, "proposal_set_id": row.proposal_set_id,
        "from_status": row.status, "to_status": to_status, "write_site": write_site,
    })
    return False


def _emit_transition_refusals(refusals: list[dict]) -> None:
    for r in refusals or []:
        sys.stderr.write(
            f"proposal_transition_refused set={r['proposal_set_id']} "
            f"{r['from_status']}->{r['to_status']} site={r['write_site']}\n"
        )
        try:
            _append_audit(CateringProposalTransitionRefused(
                type="catering_proposal_transition_refused", ts=_now(), **r))
        except Exception as e:  # noqa: BLE001 — audit is best-effort
            sys.stderr.write(
                f"WARN: transition-refusal audit emit failed (non-fatal): "
                f"{type(e).__name__}: {e}\n")


def _resolve_selection(text: str, options: list[CateringProposalOption]) -> tuple[str | None, str]:
    """Resolve customer text to a proposal option id, or return a failure reason."""
    action = ACTION_OPTION_RE.search(text or "")
    if action:
        wanted = action.group(1)
        if any(option.option_id == wanted for option in options):
            return wanted, "option_number"
        return None, "invalid_selection"

    bare = OPTION_RE.fullmatch((text or "").strip())
    if bare:
        wanted = bare.group(1)
        if any(option.option_id == wanted for option in options):
            return wanted, "option_number"
        return None, "invalid_selection"

    # Embedded named option without an action verb (compound select+pricing). Resolve
    # only when the message names EXACTLY ONE distinct option AND is not an info-seeking
    # question about the option — multiple distinct options ("option 1 and option 2") is
    # ambiguous and must never be guessed; a question ("tell me about option 2") stays a
    # clarification. (A mix-and-match recompose is routed to the recompose script upstream.)
    named = OPTION_NAMED_RE.findall(text or "")
    if named and not INFO_QUERY_RE.search(text or ""):
        distinct = set(named)
        if len(distinct) == 1:
            wanted = next(iter(distinct))
            if any(option.option_id == wanted for option in options):
                return wanted, "option_number"
            return None, "invalid_selection"
        return None, "ambiguous_selection"

    tier = TIER_RE.search(text or "")
    if tier:
        wanted_tier = tier.group(1).lower()
        matches = [option for option in options if option.tier == wanted_tier]
        if len(matches) == 1:
            return matches[0].option_id, "tier_alias"
        if len(matches) > 1:
            return None, "ambiguous_selection"
        return None, "invalid_selection"

    return None, "invalid_selection"


def _latest_proposal_for_lead(lead_id: str) -> CateringProposalSet | None:
    with FileLock(PROPOSALS_LOCK):
        store, status = load_model(PROPOSALS_PATH, CateringProposalStore, default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, status, context="proposal-selection load")
        matches = [row for row in store.sets if row.lead_id == lead_id]
        if not matches:
            return None
        latest = max(matches, key=_proposal_sequence)
        if latest.status != "SENT" or not latest.outbound_message_id.strip():
            return None
        return latest


def _load_owner_code(lead_id: str) -> str | None:
    with FileLock(LEADS_LOCK):
        store, status = load_model(LEADS_PATH, CateringLeadStore, default=CateringLeadStore())
        assert_load_status_clean(LEADS_PATH, status, context="proposal-selection lead load")
        lead = next((row for row in store.leads if row.lead_id == lead_id), None)
        if lead is None or not (lead.owner_approval_code or "").strip():
            return None
        return lead.owner_approval_code


def _current_menu_items_by_name() -> dict[str, MenuItem]:
    try:
        menu, status = load_model(MENU_PATH, Menu)
        assert_load_status_clean(MENU_PATH, status, context="proposal-selection menu load")
    except Exception as e:
        raise MenuSelectionError(f"menu load failed: {type(e).__name__}: {e}") from e
    return {item.name: item for item in menu.items}


def _selected_items(option: CateringProposalOption) -> tuple[list[dict], int]:
    menu_items = _current_menu_items_by_name()
    selected: list[CateringSelectedItem] = []
    total = 0
    for name in option.item_names:
        menu_item = menu_items.get(name)
        if menu_item is None:
            raise MenuSelectionError(f"missing menu item: {name}")
        if not menu_item.available:
            raise MenuSelectionError(f"unavailable menu item: {name}")
        if menu_item.price_usd is None:
            raise MenuSelectionError(f"missing price for menu item: {name}")
        price = int(round(menu_item.price_usd))
        item = CateringSelectedItem(name=name, qty=1, price_usd=price)
        selected.append(item)
        total += item.qty * item.price_usd
    return [item.model_dump() for item in selected], total


def _clarification_text(options: list[CateringProposalOption]) -> str:
    lines = [
        "Please reply with the option number you want:",
        *[f"Option {option.option_id}: {option.tier.title()}" for option in options],
    ]
    return BRIDGE_PREFIX + "\n".join(lines)


def _ack_text(option_id: str) -> str:
    return (
        BRIDGE_PREFIX
        + f"Got it - your Option {option_id} selection is saved for owner approval. "
        "Final pricing comes after owner review."
    )


def _option_list_text(options: list[CateringProposalOption]) -> str:
    labels = [f"Option {option.option_id}" for option in options]
    if len(labels) <= 1:
        return labels[0] if labels else "an available option"
    if len(labels) == 2:
        return f"{labels[0]} or {labels[1]}"
    return f"{', '.join(labels[:-1])}, or {labels[-1]}"


def _failed_text(options: list[CateringProposalOption]) -> str:
    return BRIDGE_PREFIX + f"I could not lock that option in. Please reply with {_option_list_text(options)}."


def _no_active_proposal_text() -> str:
    return (
        BRIDGE_PREFIX
        + "I could not find an active proposal to select. Please ask for new menu options."
    )


def _expired_proposal_text() -> str:
    """No option numbers are echoed back: they are precisely what is no longer
    selectable, and re-listing them invites the customer to pick again."""
    return (
        BRIDGE_PREFIX
        + "Thank you — those menu options have now expired, so I can't lock one in. "
        "The owner will refresh them and come back to you shortly."
    )


def _expire_proposal_set(proposal_set_id: str) -> list[dict]:
    """Retire an elapsed set through the LEGAL SENT->EXPIRED edge, so the customer's
    reply cannot advance it any further. Returns transition refusals for the
    caller to emit after PROPOSALS_LOCK releases (this script never holds
    PROPOSALS_LOCK and LOG_LOCK together)."""
    refusals: list[dict] = []
    with FileLock(PROPOSALS_LOCK):
        store, load_status = load_model(PROPOSALS_PATH, CateringProposalStore,
                                        default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, load_status,
                                 context="proposal-selection expiry")
        target = next((row for row in store.sets
                       if row.proposal_set_id == proposal_set_id), None)
        if target is None or target.status != "SENT":
            return refusals
        if _transition_ok(target, "EXPIRED", "select_expired", refusals):
            target.status = "EXPIRED"
            target.failure_reason = "validity window elapsed before selection"[:200]
            atomic_write_json(PROPOSALS_PATH, store)
    return refusals


def _notify_owner_proposal_expired(lead_id: str, proposal_set_id: str,
                                   selection_text: str) -> None:
    """The customer answered — just too late. That is a live lead the owner would
    otherwise never hear about, since nothing advanced and no card was sent."""
    message = (
        f"lead_id={lead_id} proposal_set_id={proposal_set_id}: the customer chose an "
        f"option AFTER the quote's validity date, so nothing was locked in. They have "
        f"been told you will refresh the options. Their reply: "
        f"{(selection_text or '')[:200]!r}"
    )
    try:
        subprocess.run(
            [str(NOTIFY_OWNER_BIN), "--priority", "1",
             "--title", "Catering proposal expired before selection", message],
            check=False, capture_output=True, text=True, timeout=10,
        )
    except Exception as e:  # noqa: BLE001 - alerting is best-effort
        sys.stderr.write(f"WARN: shift-agent-notify-owner failed (non-fatal): "
                         f"{type(e).__name__}: {e}\n")


SUPERSEDING_PROPOSAL_STATUSES = {
    "DRAFT",
    "SENT",
    "SELECTING",
    "SELECTED",
    "SELECTED_OWNER_CARD_FAILED",
    "SELECT_FAILED",
}


def _claim_selection(
    *,
    lead_id: str,
    proposal_set_id: str,
    option_id: str,
    customer_message_id: str,
) -> SelectionClaim | SelectionClaimFailure:
    with FileLock(PROPOSALS_LOCK):
        store, load_status = load_model(PROPOSALS_PATH, CateringProposalStore, default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, load_status, context="proposal-selection claim")
        target = next((row for row in store.sets if row.proposal_set_id == proposal_set_id), None)
        if target is None:
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=f"proposal set {proposal_set_id} no longer exists",
                options=[],
                exit_code=EXIT_NOT_FOUND,
            )
        if target.status != "SENT":
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=f"proposal set {proposal_set_id} status is {target.status}, not SENT",
                options=target.options,
                exit_code=EXIT_NOT_FOUND,
            )
        if not target.outbound_message_id.strip():
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=f"proposal set {proposal_set_id} has no outbound_message_id",
                options=target.options,
                exit_code=EXIT_NOT_FOUND,
            )

        target_sequence = _proposal_sequence(target)
        superseding = [
            row
            for row in store.sets
            if row.lead_id == lead_id
            and _proposal_sequence(row) > target_sequence
            and row.status in SUPERSEDING_PROPOSAL_STATUSES
        ]
        if superseding:
            latest = max(superseding, key=_proposal_sequence)
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=(
                    f"proposal set {proposal_set_id} is superseded by "
                    f"{latest.proposal_set_id} status {latest.status}"
                ),
                options=target.options,
                exit_code=EXIT_NOT_FOUND,
            )

        selected_option = next((option for option in target.options if option.option_id == option_id), None)
        if selected_option is None:
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="invalid_selection",
                detail=f"option {option_id} is not present on proposal set {proposal_set_id}",
                options=target.options,
                exit_code=EXIT_INVALID_INPUT,
            )
        try:
            selected_items, total = _selected_items(selected_option)
        except MenuSelectionError as e:
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="invalid_selection",
                detail=str(e),
                options=target.options,
                exit_code=EXIT_INVALID_INPUT,
            )

        refusals: list[dict] = []
        if not _transition_ok(target, "SELECTING", "claim_selection", refusals):
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=(f"proposal set {proposal_set_id} cannot move "
                        f"{target.status}->SELECTING"),
                options=target.options,
                exit_code=EXIT_NOT_FOUND,
                refusals=refusals,
            )
        target.status = "SELECTING"
        target.selected_option_id = option_id
        target.failure_reason = f"selecting:{customer_message_id}"[:200]
        atomic_write_json(PROPOSALS_PATH, store)
        return SelectionClaim(
            proposal_set_id=proposal_set_id,
            option_id=option_id,
            selected_items=selected_items,
            quote_total_usd=total,
            options=target.options,
        )


def _finish_selection(
    lead_id: str,
    proposal_set_id: str,
    option_id: str,
    finalize_rc: int,
) -> SelectionFinalizeResult | SelectionClaimFailure:
    with FileLock(PROPOSALS_LOCK):
        store, load_status = load_model(PROPOSALS_PATH, CateringProposalStore, default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, load_status, context="proposal-selection finish")
        target = next((row for row in store.sets if row.proposal_set_id == proposal_set_id), None)
        if target is None:
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=f"proposal set {proposal_set_id} disappeared after finalize",
                options=[],
                exit_code=EXIT_NOT_FOUND,
            )
        if target.status != "SELECTING" or target.selected_option_id != option_id:
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=(
                    f"proposal set {proposal_set_id} changed during finalize: "
                    f"status={target.status} selected_option_id={target.selected_option_id}"
                ),
                options=target.options,
                exit_code=EXIT_NOT_FOUND,
            )
        target_sequence = _proposal_sequence(target)
        superseding = [
            row
            for row in store.sets
            if row.lead_id == lead_id
            and _proposal_sequence(row) > target_sequence
            and row.status in SUPERSEDING_PROPOSAL_STATUSES
        ]
        refusals: list[dict] = []
        if superseding:
            latest = max(superseding, key=_proposal_sequence)
            if _transition_ok(target, "SELECT_FAILED", "finish_selection_superseded", refusals):
                target.status = "SELECT_FAILED"
                target.selected_option_id = None
                target.failure_reason = f"superseded by {latest.proposal_set_id}"[:200]
                atomic_write_json(PROPOSALS_PATH, store)
            return SelectionClaimFailure(
                proposal_set_id=proposal_set_id,
                reason="no_sent_proposal",
                detail=(
                    f"proposal set {proposal_set_id} was superseded during finalize by "
                    f"{latest.proposal_set_id} status {latest.status}"
                ),
                options=target.options,
                exit_code=EXIT_NOT_FOUND,
                refusals=refusals,
            )
        if finalize_rc in {EXIT_OK, EXIT_DEPENDENCY_DOWN}:
            to_status = "SELECTED" if finalize_rc == EXIT_OK else "SELECTED_OWNER_CARD_FAILED"
        else:
            to_status = "SELECT_FAILED"
        if _transition_ok(target, to_status, "finish_selection", refusals):
            target.status = to_status
            target.selected_option_id = (
                option_id if finalize_rc in {EXIT_OK, EXIT_DEPENDENCY_DOWN} else None
            )
            target.failure_reason = (
                "" if finalize_rc in {EXIT_OK, EXIT_DEPENDENCY_DOWN}
                else f"finalize_exit_{finalize_rc}"
            )
            atomic_write_json(PROPOSALS_PATH, store)
        return SelectionFinalizeResult(
            proposal_set_id=proposal_set_id,
            option_id=option_id,
            finalize_exit_code=finalize_rc,
            options=target.options,
            refusals=refusals,
        )


def _fail_claim_after_finalize_exception(
    proposal_set_id: str,
    option_id: str,
    detail: str,
) -> tuple[list[CateringProposalOption], list[dict]]:
    refusals: list[dict] = []
    with FileLock(PROPOSALS_LOCK):
        store, load_status = load_model(PROPOSALS_PATH, CateringProposalStore, default=CateringProposalStore())
        assert_load_status_clean(PROPOSALS_PATH, load_status, context="proposal-selection exception cleanup")
        target = next((row for row in store.sets if row.proposal_set_id == proposal_set_id), None)
        if target is None:
            return [], refusals
        options = target.options
        if (target.status == "SELECTING" and target.selected_option_id == option_id
                and _transition_ok(target, "SELECT_FAILED", "claim_cleanup", refusals)):
            target.status = "SELECT_FAILED"
            target.selected_option_id = None
            target.failure_reason = detail[:200]
            atomic_write_json(PROPOSALS_PATH, store)
        return options, refusals


def _finalize(code: str, customer_message_id: str, selected_items: list[dict], total: int,
              logical_turn_id: str) -> int:
    cmd = [
        str(PYTHON_BIN),
        str(FINALIZE_BIN),
        "--code",
        code,
        "--customer-message-id",
        customer_message_id,
        # PR-4: forward the turn's logical id so the OWNER-card finalize row links
        # to the SAME inbound as the customer selection/ack rows.
        "--logical-turn-id",
        logical_turn_id,
        "--selected-items-json",
        json.dumps(selected_items),
        "--quote-total-usd",
        str(total),
    ]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=60).returncode


def _notify_owner_card_failed(lead_id: str, proposal_set_id: str, option_id: str) -> None:
    message = (
        f"lead_id={lead_id} proposal_set_id={proposal_set_id} option {option_id} "
        "was selected, but finalize-catering-menu could not deliver the owner card."
    )
    try:
        subprocess.run(
            [
                str(NOTIFY_OWNER_BIN),
                "--priority",
                "2",
                "--title",
                "Catering proposal owner card failed",
                message,
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except Exception as e:  # noqa: BLE001 - alerting is best-effort
        sys.stderr.write(f"WARN: shift-agent-notify-owner failed (non-fatal): {type(e).__name__}: {e}\n")


def _failure_reason_for_finalize(rc: int) -> str:
    if rc in {2, 4, 11}:
        return f"finalize_exit_{rc}"
    return "finalize_exit_other"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lead-id", required=True)
    parser.add_argument("--customer-jid", required=True)
    parser.add_argument("--customer-message-id", required=True)
    # PR-4: logical_turn_id = the inbound native message id (charter §4.2). Defaults
    # to --customer-message-id (this path's inbound id) when the caller omits it.
    parser.add_argument("--logical-turn-id", default="")
    parser.add_argument("--selection-text", required=True)
    args = parser.parse_args()

    # PR-4: one logical_turn_id for the turn + one send_attempt_id for the customer
    # send(s) this invocation makes (retries reuse it).
    _set_run_identity(
        logical_turn_id=(args.logical_turn_id or args.customer_message_id),
        send_attempt_id=uuid.uuid4().hex,
        transport_destination=args.customer_jid,
    )

    try:
        proposal = _latest_proposal_for_lead(args.lead_id)
    except Exception as e:
        sys.stderr.write(f"proposal load failed: {e}\n")
        _audit_failed(args.lead_id, "no_sent_proposal", str(e))
        _post(args.customer_jid, _no_active_proposal_text(), lead_id=args.lead_id)
        return EXIT_NOT_FOUND
    if proposal is None:
        _audit_failed(args.lead_id, "no_sent_proposal", "latest proposal is not SENT")
        _post(args.customer_jid, _no_active_proposal_text(), lead_id=args.lead_id)
        return EXIT_NOT_FOUND

    # The "valid until <date>" line the customer was sent is a commitment, and until
    # now it bound nothing: a set could be selected, finalized and put in front of
    # the owner months after it lapsed. Checked BEFORE resolving the selection —
    # whatever the customer typed, the options are gone, and a clarification
    # re-listing dead options would be worse than saying so.
    if find_expired_sent_proposal_sets([proposal], _now()):
        refusals = _expire_proposal_set(proposal.proposal_set_id)
        _emit_transition_refusals(refusals)
        _post(args.customer_jid, _expired_proposal_text(), lead_id=args.lead_id)
        _audit_failed(
            args.lead_id, "proposal_expired",
            f"expires_at={proposal.expires_at.isoformat() if proposal.expires_at else ''} "
            f"elapsed; selection text: {args.selection_text}",
            proposal.proposal_set_id,
        )
        _notify_owner_proposal_expired(args.lead_id, proposal.proposal_set_id,
                                       args.selection_text)
        return EXIT_NOT_FOUND

    option_id, reason = _resolve_selection(args.selection_text, proposal.options)
    if option_id is None:
        _post(args.customer_jid, _clarification_text(proposal.options), lead_id=args.lead_id)
        _audit_failed(args.lead_id, reason, args.selection_text, proposal.proposal_set_id)
        return EXIT_INVALID_INPUT

    try:
        code = _load_owner_code(args.lead_id)
    except Exception as e:
        sys.stderr.write(f"lead load failed: {e}\n")
        _audit_failed(args.lead_id, "lead_not_found", str(e), proposal.proposal_set_id)
        _post(args.customer_jid, _no_active_proposal_text(), lead_id=args.lead_id)
        return EXIT_NOT_FOUND
    if code is None:
        _audit_failed(args.lead_id, "lead_not_found", "lead missing owner_approval_code", proposal.proposal_set_id)
        _post(args.customer_jid, _no_active_proposal_text(), lead_id=args.lead_id)
        return EXIT_NOT_FOUND

    try:
        claim = _claim_selection(
            lead_id=args.lead_id,
            proposal_set_id=proposal.proposal_set_id,
            option_id=option_id,
            customer_message_id=args.customer_message_id,
        )
    except Exception as e:
        sys.stderr.write(f"proposal selection claim failed: {e}\n")
        _audit_failed(args.lead_id, "no_sent_proposal", str(e), proposal.proposal_set_id)
        _post(args.customer_jid, _no_active_proposal_text(), lead_id=args.lead_id)
        return EXIT_NOT_FOUND

    if isinstance(claim, SelectionClaimFailure):
        _emit_transition_refusals(claim.refusals)
        _post(args.customer_jid, _failed_text(claim.options) if claim.options else _no_active_proposal_text(), lead_id=args.lead_id)
        _audit_failed(args.lead_id, claim.reason, claim.detail, claim.proposal_set_id)
        return claim.exit_code

    try:
        finalize_rc = _finalize(code, args.customer_message_id, claim.selected_items, claim.quote_total_usd,
                                _RUN_IDENTITY["logical_turn_id"])
    except Exception as e:
        detail = f"{type(e).__name__}: {e}"
        options, refusals = _fail_claim_after_finalize_exception(
            claim.proposal_set_id, claim.option_id, detail)
        _emit_transition_refusals(refusals)
        _post(args.customer_jid, _failed_text(options or claim.options), lead_id=args.lead_id)
        _audit_failed(args.lead_id, "finalize_exit_other", detail, claim.proposal_set_id)
        return EXIT_DEPENDENCY_DOWN

    result = _finish_selection(args.lead_id, claim.proposal_set_id, claim.option_id, finalize_rc)
    _emit_transition_refusals(result.refusals)
    if isinstance(result, SelectionClaimFailure):
        _post(args.customer_jid, _failed_text(result.options) if result.options else _no_active_proposal_text(), lead_id=args.lead_id)
        _audit_failed(args.lead_id, result.reason, result.detail, result.proposal_set_id)
        return result.exit_code

    finalize_rc = result.finalize_exit_code

    if finalize_rc in {EXIT_OK, EXIT_DEPENDENCY_DOWN}:
        _audit_selected(args.lead_id, result.proposal_set_id, result.option_id, args.customer_message_id, finalize_rc)
        if finalize_rc == EXIT_DEPENDENCY_DOWN:
            _notify_owner_card_failed(args.lead_id, result.proposal_set_id, result.option_id)
        # Capture the ack's bridge outbound message id so the customer-facing selection
        # (and compound selection+pricing) response is traceable in the audit trail.
        ack_ok, ack_mid_or_err = _post(
            args.customer_jid, _ack_text(result.option_id),
            lead_id=args.lead_id, page=True)
        _audit_ack(args.lead_id, args.customer_jid, ack_ok, ack_mid_or_err)
        return finalize_rc

    _audit_failed(
        args.lead_id,
        _failure_reason_for_finalize(finalize_rc),
        f"finalize exited {finalize_rc}",
        result.proposal_set_id,
    )
    _post(args.customer_jid, _failed_text(result.options), lead_id=args.lead_id)
    return finalize_rc if finalize_rc in {2, 4, 11} else EXIT_INVALID_INPUT


if __name__ == "__main__":
    sys.exit(main())
