#!/usr/bin/env python3
"""
identify-sender — resolve a WhatsApp phone/JID to a role (employee/owner/unknown).

Usage:
  identify-sender +19045550101
  identify-sender 19045550101@s.whatsapp.net
  identify-sender --json +19045550101

Output (JSON to stdout):
  {"role": "employee", "roles": ["employee"], "employee_id": "e001", "name": "Ravi Kumar", ...}
  {"role": "owner", "roles": ["owner"], "name": "Sally Patel", "phone_normalized": "+19045550100"}
  {"role": "unknown", "roles": [], "phone_normalized": "+19045559999"}

  A principal may hold BOTH relationships at once:
  {"role": "employee", "roles": ["employee", "owner"], "employee_id": "e008", ...}

  An identifier that names MORE THAN ONE roster employee resolves to nobody:
  {"role": "error", "roles": [], "error": "ambiguous_identifier: ..."}

`roles` is the authorization surface and is independent of which identifier
(phone or LID) was used to look the principal up. So is the ambiguity refusal:
whether two roster rows claim one WhatsApp account does not depend on which of
that account's identifiers the caller happened to hold.

`role` is a LEGACY COMPATIBILITY PROJECTION. It preserves each branch's
original precedence — employee-first by LID, primary-owner-first by phone — so
the ~38 deployed `role == "owner"` / `role != "owner"` consumers keep their
exact current behavior, including the many that use `!= "owner"` as shorthand
for "customer". New authorization MUST read `roles`, never the scalar.

Exit codes:
  0 — resolved (even if unknown; the JSON indicates role)
  2 — state-file-load-failure (roster/config could not be loaded), OR the
      identifier is ambiguous (two roster rows claim it); caller should trigger
      dead-man / fail closed
  5 — Pydantic schema violation in config/roster
"""

from __future__ import annotations
import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, "/opt/shift-agent")
from safe_io import load_model, validate_phone_input  # noqa: E402
from schemas import Config, Roster, E164Phone  # noqa: E402
from exit_codes import EXIT_OK, EXIT_INVALID_INPUT, EXIT_SCHEMA_VIOLATION  # noqa: E402
import yaml


# BEGIN shift-agent-sender-id (env-overridable so tests can run on temp fixtures)
CONFIG_PATH = Path(os.environ.get("SHIFT_AGENT_CONFIG_PATH", "/opt/shift-agent/config.yaml"))
ROSTER_PATH = Path(os.environ.get("SHIFT_AGENT_ROSTER_PATH", "/opt/shift-agent/roster.json"))

_LID_RE = re.compile(r"^\d{6,20}@lid$")
_PHONE_JID_RE = re.compile(r"^\d{6,20}@s\.whatsapp\.net$")
_E164_RE = re.compile(r"^\+\d{10,15}$")


def _classify_input(raw: str) -> tuple[str, str]:
    """Strict input dispatch — never coincidentally treat a LID as a phone.
    Returns (kind, normalized) where kind in {phone, lid, invalid}."""
    raw = (raw or "").strip()
    if _LID_RE.match(raw):
        return "lid", raw
    if _PHONE_JID_RE.match(raw):
        return "phone", "+" + raw.split("@")[0]
    if _E164_RE.match(raw):
        return "phone", raw
    return "invalid", raw
# END shift-agent-sender-id


# BEGIN shift-agent-multirole
# Owner and employee are NOT mutually exclusive relationships. `roles` is the
# authorization surface; the scalar `role` below is a LEGACY COMPATIBILITY
# PROJECTION kept bit-for-bit identical to pre-change behavior so the ~38
# existing `role == "owner"` / `role != "owner"` consumers are untouched.
#
# Authorization MUST ask `"owner" in roles` / `"employee" in roles`.
# It MUST NOT ask `role == "owner"` where multi-role correctness matters.


def _match_owner_identity(owner, *, phone=None, lid=None):
    """Return the matched owner identity record, else None.

    Checks the primary owner identity AND every `authorized_identities` entry,
    against BOTH identifiers, so the answer never depends on which identifier
    the caller happened to hold.
    """
    if phone is not None and phone == owner.phone:
        return owner
    if lid is not None and owner.lid and lid == owner.lid:
        return owner
    for alias in owner.authorized_identities:
        if phone is not None and alias.phone == phone:
            return alias
        if lid is not None and alias.lid and alias.lid == lid:
            return alias
    return None


class _AmbiguousIdentifier(Exception):
    """Two or more roster rows claim ONE WhatsApp account.

    Nothing enforces that a phone or a LID names a single employee —
    `Roster.check_referential_integrity` uniques `id` and nothing else — so a
    hand-edited or imported roster can contain two rows holding the same
    number. Before this refusal the resolver returned whichever row came FIRST
    IN THE FILE, which meant re-ordering the same roster changed who an absence
    was recorded against, who the coverage ask was addressed to, and whose
    `employee_id` a YES/NO reply was bound to.

    Refusing is the same shape as every other "more than one match" in this
    codebase — `sent_proposal_ids_for_candidate` refuses on a count that is not
    exactly 1, and `approval_code_pools.resolve_code` returns a
    `CollisionResult` rather than a first canonical match. Identity is the one
    place a guess is least affordable, so it refuses too.
    """

    def __init__(self, employee_ids, *, phone=None, lid=None):
        self.employee_ids = sorted(employee_ids)
        self.phone = phone
        self.lid = lid
        held = " / ".join(x for x in (phone, lid) if x)
        super().__init__(
            f"ambiguous_identifier: {held} is claimed by roster employees "
            f"{', '.join(self.employee_ids)}; refusing to guess"
        )


def _employees_by_phone_any_status(roster, phone):
    """EVERY status-neutral phone match, mirroring `Roster.find_by_phone`.

    `Roster.find_by_phone` skips every employee whose status is not "active"
    (schemas.py). Using it here would make membership depend on WHICH
    identifier the caller held: the LID path returns inactive employees, so an
    inactive employee would answer `roles=["employee"]` by LID and `roles=[]`
    by phone. That contradicts the branch-independence contract.

    Membership is the relationship; ACTIVE status is an authorization
    condition, and it stays in the consumer (`has_employee_capability` /
    `is_employee_chat`). So this lookup drops the status filter and keeps
    everything else identical.

    `phone_history` effective windows are preserved exactly as upstream: a
    reassigned number outside its window must NOT confer membership on its
    former holder, or a recycled phone would silently inherit an identity. That
    window is also what keeps a legitimately reassigned number OUT of the
    ambiguity refusal below: the former holder simply does not match.
    """
    canonical = E164Phone.from_any(phone)
    now = datetime.now(timezone.utc)
    found = []
    for emp in roster.employees:
        if emp.phone == canonical:
            found.append(emp)
            continue
        for hist in emp.phone_history:
            if hist.phone != canonical:
                continue
            if hist.effective_from and hist.effective_from > now:
                continue
            if hist.effective_to is not None and hist.effective_to < now:
                continue
            found.append(emp)
            break
    return found


def _match_employee(roster, *, phone=None, lid=None):
    """Return the ONE matching Employee, None if there is none.

    Raises `_AmbiguousIdentifier` when the identifiers name two or more
    DISTINCT employees. The LID branch no longer wins by running first: an
    account whose LID is on one roster row and whose phone is on another is not
    resolvable, and picking the LID row would be a guess dressed as precedence.

    Status is NOT filtered on EITHER path — see
    `_employees_by_phone_any_status` for why that symmetry is load-bearing.
    Active-status enforcement lives in the consumer (`is_employee_chat` /
    `has_employee_capability`), and a terminated row sharing a number is just
    as ambiguous as an active one because membership is resolved before status.
    """
    matched = {}
    if lid is not None:
        for emp in roster.employees:
            if emp.lid and emp.lid == lid:
                matched.setdefault(emp.id, emp)
    if phone is not None:
        for emp in _employees_by_phone_any_status(roster, phone):
            matched.setdefault(emp.id, emp)
    if not matched:
        return None
    if len(matched) > 1:
        raise _AmbiguousIdentifier(matched, phone=phone, lid=lid)
    return next(iter(matched.values()))


def _resolve_principal(cfg, roster, *, phone=None, lid=None):
    """Resolve one principal to (employee_or_None, owner_match_or_None, phone, lid).

    Identifiers are widened from whatever the roster/owner records teach us, so
    a principal resolved by LID yields the same memberships as the same
    principal resolved by phone.
    """
    emp = _match_employee(roster, phone=phone, lid=lid)
    eff_phone = phone if phone is not None else (emp.phone if emp else None)
    eff_lid = lid if lid is not None else (emp.lid if emp else None)

    owner_match = _match_owner_identity(cfg.owner, phone=eff_phone, lid=eff_lid)

    # Second pass: an owner match may supply identifiers the roster lookup
    # lacked. Widening the LID here is what preserves the PRE-#692 contract
    # `_emit_owner(cfg.owner, phone=canonical, lid=cfg.owner.lid)` — resolving
    # the primary owner BY PHONE must still report `owner.lid`, not null.
    # Consumers read it: `audit_dispatcher_routed` takes `sender_lid` straight
    # from this field.
    if owner_match is not None:
        if eff_phone is None:
            eff_phone = getattr(owner_match, "phone", None)
            if emp is None and eff_phone is not None:
                emp = _match_employee(roster, phone=eff_phone)
                if emp is not None and eff_lid is None:
                    eff_lid = emp.lid
        if eff_lid is None:
            eff_lid = getattr(owner_match, "lid", None)

    # The ambiguity refusal is BRANCH-INDEPENDENT, on the same terms as
    # membership. Once the identifiers are widened, re-ask with BOTH of them:
    # a LID lookup that matched one row while a second row holds the same
    # phone is the same collision seen from the other side, and one WhatsApp
    # account must not resolve by LID and refuse by phone.
    if emp is not None:
        _match_employee(roster, phone=eff_phone, lid=eff_lid)

    return emp, owner_match, eff_phone, eff_lid


def _emit(scalar_role, emp, owner_match, cfg, *, phone=None, lid=None) -> int:
    """Emit the identity document: frozen scalar + additive `roles` membership set."""
    roles = []
    if owner_match is not None:
        roles.append("owner")
    if emp is not None:
        roles.append("employee")

    name = None
    if emp is not None:
        name = emp.name
    elif owner_match is not None:
        name = cfg.owner.name

    out = {
        "role": scalar_role,
        "roles": sorted(roles),
        "name": name,
        "phone_normalized": phone,
        "lid": lid,
    }
    # Employee detail rides along whenever employee membership is held, so an
    # owner-scalar principal who is also an employee still exposes employee_id.
    # Owner membership alone NEVER synthesizes one.
    if emp is not None:
        out["employee_id"] = emp.id
        out["primary_role"] = emp.role
        out["languages"] = emp.languages
        out["can_cover_roles"] = sorted(emp.can_cover_roles)
    print(json.dumps(out))
    return EXIT_OK
# END shift-agent-multirole


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("input", help="phone (+E.164), LID (<digits>@lid), or phone-JID (<digits>@s.whatsapp.net)")
    ap.add_argument("--json", action="store_true", default=True, help="JSON output (default)")
    args = ap.parse_args()

    # BEGIN shift-agent-sender-id (strict classifier — phone vs lid vs invalid)
    kind, normalized = _classify_input(args.input)
    if kind == "invalid":
        # Fall back: legacy E164Phone canonicalization handles formatted
        # phones like `+1-904-555-0101`. validate_phone_input rejects shell
        # injection first.
        try:
            validate_phone_input(args.input)
            canonical = E164Phone.from_any(args.input)
        except ValueError as e:
            print(json.dumps({"role": "error", "error": str(e)}))
            return EXIT_INVALID_INPUT
        except Exception as e:
            print(json.dumps({"role": "error", "error": f"phone parse: {e}"}))
            return EXIT_INVALID_INPUT
        if not _E164_RE.match(canonical):
            print(json.dumps({"role": "error", "error": f"refusing input: {args.input!r}"}))
            return EXIT_INVALID_INPUT
        kind = "phone"
        normalized = canonical
    # END shift-agent-sender-id

    # Load config
    try:
        with CONFIG_PATH.open() as f:
            raw = yaml.safe_load(f)
        cfg = Config.model_validate(raw)
    except Exception as e:
        print(json.dumps({"role": "error", "error": f"config_load: {e}"}), file=sys.stdout)
        return EXIT_SCHEMA_VIOLATION

    # Load roster
    try:
        roster, status = load_model(ROSTER_PATH, Roster)
    except Exception as e:
        print(json.dumps({"role": "error", "error": f"roster_load: {e}"}))
        return EXIT_SCHEMA_VIOLATION
    if status != "ok":
        print(json.dumps({"role": "error", "error": f"roster_load_failed: {status}"}))
        return EXIT_INVALID_INPUT

    # BEGIN shift-agent-multirole (memberships are branch-independent; the
    # scalar keeps each branch's ORIGINAL precedence so no existing consumer
    # observes a behavior change)
    try:
        if kind == "lid":
            emp, owner_match, eff_phone, eff_lid = _resolve_principal(
                cfg, roster, lid=normalized)
            # Original LID precedence: employee checked first, owner second.
            if emp is not None:
                scalar = "employee"
            elif owner_match is not None:
                scalar = "owner"
            else:
                scalar = "unknown"
            return _emit(scalar, emp, owner_match, cfg,
                         phone=eff_phone, lid=eff_lid or normalized)

        # kind == "phone"
        canonical = normalized
        emp, owner_match, eff_phone, eff_lid = _resolve_principal(
            cfg, roster, phone=canonical)
    except _AmbiguousIdentifier as exc:
        # Fail closed and say why. Every deployed consumer already treats a
        # non-zero exit as "identity unresolved" and fails closed on it — the
        # cf-router memo additionally announces the turn once (§12a), so this
        # does not become a new silent-failure surface. The roster needs an
        # operator edit; retrying will not fix it.
        print(json.dumps({"role": "error", "roles": [], "error": str(exc),
                          "employee_ids": exc.employee_ids}))
        print(f"identify-sender: {exc}", file=sys.stderr)
        return EXIT_INVALID_INPUT
    # Original phone precedence: the PRIMARY owner identity wins first, then
    # the roster. An authorized-identity-only match is new configuration that
    # could not exist before, so resolving it to "owner" regresses nothing.
    if canonical == cfg.owner.phone:
        scalar = "owner"
    elif emp is not None:
        scalar = "employee"
    elif owner_match is not None:
        scalar = "owner"
    else:
        scalar = "unknown"
    return _emit(scalar, emp, owner_match, cfg,
                 phone=eff_phone or canonical, lid=eff_lid)
    # END shift-agent-multirole


if __name__ == "__main__":
    sys.exit(main())
