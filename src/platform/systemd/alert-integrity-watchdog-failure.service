[Unit]
Description=Notify owner when the alert-integrity watchdog fails

[Service]
Type=oneshot
User=shift-agent
Group=shift-agent
EnvironmentFile=-/opt/shift-agent/.env
Environment=HOME=/opt/shift-agent
Environment=TZ=UTC
ExecStartPre=/usr/bin/test -x /usr/local/bin/shift-agent-notify-owner
ExecStart=/usr/local/bin/shift-agent-notify-owner --title "Alert-integrity watchdog failed" --priority 1 "The alert-integrity watchdog failed (decisions.log freshness + dropped-alert monitor). Check journalctl -u alert-integrity-watchdog.service and systemctl status alert-integrity-watchdog.service."
SuccessExitStatus=5 6

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/shift-agent
ProtectHome=read-only
PrivateTmp=true
